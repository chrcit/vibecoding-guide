---
/*
 * Fig. 37, the cache is a prefix, so order decides what is reused.
 *
 * Idea: a request is built tools, then system prompt, then messages; a cache hit needs everything
 * up to the cache point unchanged. One strip of a request; the reader picks what changed since the
 * last turn, and everything from the first changed part onwards is written again at the write
 * price, the rest read at the cache price.
 * Controls: what changed (.pick, the breakers from lineup.cacheBreakers), conversation size.
 * Data: prices and multipliers arrive as props from src/data/; part sizes reuse the lab's.
 */
import Figure from '../Figure.astro';
import Stat from '../../board/Stat.astro';
import { HARNESS_TOKENS, TOKENS_PER_LINE, TOOLS_PER_CONNECTOR, TOKENS_PER_TOOL, MESSAGE_TOKENS, RESULT_TOKENS, SUMMARY_TOKENS } from '../context-lab/model';

interface Props { read: number; write: number; input: number; modelName: string }
const { read, write, input, modelName } = Astro.props;
// Sizes: three connectors loaded up front, the harness plus a 120-line file, one new turn.
const parts = { tools: 3 * TOOLS_PER_CONNECTOR * TOKENS_PER_TOOL, system: HARNESS_TOKENS + 120 * TOKENS_PER_LINE, turn: MESSAGE_TOKENS + RESULT_TOKENS.typical, summary: SUMMARY_TOKENS };
// Where the first change sits: 0 tools, 1 system, 2 conversation, 3 the new turn only.
const CHANGES = [
  { id: 'none', name: 'A new message', from: 3 },
  { id: 'mcp', name: 'Add an MCP server', from: 0 },
  { id: 'model', name: 'Switch model', from: -1 },
  { id: 'compact', name: 'Compact', from: 2 },
];
const data = JSON.stringify({ parts, changes: CHANGES, read, write, input });
---
<div class="co" data-co data-co-data={data}>
  <div class="pick" role="group" aria-label="What changed since the last turn" data-co-pick>
    {CHANGES.map((c, i) => <button type="button" data-change={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.name}</button>)}
  </div>
  <Figure n={37} title="The cache is a prefix" alt="A strip of one request: tool definitions, system prompt, conversation and the new turn. Everything up to the new turn is read from the cache." bare>
    <div class="co-strip" data-co-strip>
      <div class="co-part" data-p="tools"><span>Tools</span></div>
      <div class="co-part" data-p="system"><span>System</span></div>
      <div class="co-part" data-p="talk"><span>Conversation</span></div>
      <div class="co-part" data-p="turn"><span>New</span></div>
    </div>
    <p class="co-key"><span class="co-sw co-sw-read"></span>Read from cache <span class="co-sw co-sw-write"></span>Written again</p>
  </Figure>
  <label class="control"><span>Conversation so far <output data-co-out>300K</output></span><input type="range" min="0" max="900" step="10" value="300" data-co-talk /></label>
  <dl class="stats">
    <Stat name={`This turn on ${modelName}`} id="co-now" tone="accent">–</Stat>
    <Stat name="If only a message was added" id="co-base" tone="green">–</Stat>
    <Stat name="Times as much" id="co-x">–</Stat>
  </dl>
</div>

<style is:global>
  .co { display: grid; gap: 0.75rem; }
  .co-strip { display: flex; height: 4.5rem; gap: 2px; border-radius: var(--radius-s); overflow: hidden; }
  .co-part { position: relative; min-width: 0.375rem; display: flex; align-items: end; padding: 0.25rem 0.375rem; background: var(--green); color: var(--card); transition: background-color 400ms var(--ease-out); }
  .co-part span { font-size: var(--text-xs); white-space: nowrap; overflow: hidden; }
  .co-part[data-w='1'] { background: var(--accent); color: var(--accent-ink); }
  .co-part[data-p='talk'] { flex: 1 1 auto; }
  .co-key { margin: 0.375rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; font-size: var(--text-xs); color: var(--ink-2); }
  .co-sw { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: 2px; margin-left: 0.5rem; }
  .co-sw:first-child { margin-left: 0; }
  .co-sw-read { background: var(--green); }
  .co-sw-write { background: var(--accent); }
  .co .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
</style>

<script>
  type D = { parts: { tools: number; system: number; turn: number; summary: number }; changes: { id: string; from: number }[]; read: number; write: number; input: number };
  for (const root of document.querySelectorAll<HTMLElement>('[data-co]')) {
    const d: D = JSON.parse(root.dataset.coData!);
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-change]')];
    const range = root.querySelector<HTMLInputElement>('[data-co-talk]')!;
    const out = root.querySelector<HTMLElement>('[data-co-out]')!;
    const el = (p: string) => root.querySelector<HTMLElement>(`[data-p="${p}"]`)!;
    const stat = (id: string) => root.querySelector<HTMLElement>(`[data-stat="${id}"]`)!;
    let change = 'none';
    const usd = (v: number) => (v < 0.01 ? '<$0.01' : `$${v.toFixed(2)}`);
    const written = (i: number, from: number) => from < 0 || i >= from;
    const cost = (sizes: number[], from: number) => sizes.reduce((a, s, i) => a + (s * (written(i, from) ? d.write : d.read)) / 1e6, 0);
    function show() {
      const talk = Number(range.value) * 1000;
      out.textContent = `${range.value}K`;
      const c = d.changes.find((x) => x.id === change)!;
      // Compaction swaps the conversation for a summary, written fresh.
      const talkNow = change === 'compact' ? d.parts.summary : talk;
      const sizes = [d.parts.tools, d.parts.system, talkNow, d.parts.turn];
      const total = sizes.reduce((a, b) => a + b, 0);
      ['tools', 'system', 'talk', 'turn'].forEach((p, i) => {
        const e = el(p);
        e.dataset.w = written(i, c.from) ? '1' : '0';
        if (p !== 'talk') e.style.flex = `0 0 ${Math.max(1.5, (sizes[i]! / total) * 100)}%`;
        else e.style.flex = '1 1 auto';
      });
      const now = cost(sizes, c.from);
      const base = cost([d.parts.tools, d.parts.system, talk, d.parts.turn], 3);
      stat('co-now').textContent = usd(now);
      stat('co-base').textContent = usd(base);
      stat('co-x').textContent = `${(now / base).toFixed(1)}×`;
      for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset.change === change));
    }
    for (const b of btns) b.addEventListener('click', () => { change = b.dataset.change!; show(); });
    range.addEventListener('input', show);
    show();
  }
</script>
