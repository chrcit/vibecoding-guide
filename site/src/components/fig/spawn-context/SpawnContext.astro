---
/*
 * Fig. 32, "A subagent knows only what you pass it". Goes inside a board tile.
 * Idea: a subagent starts with an empty context; what it knows is the spawn prompt, and what comes
 * back is whatever report it was asked for.
 * Elements: the main thread's context (the bug, a rule agreed earlier, what done means, the report
 * shape, the talk so far, files already read), the spawn prompt, the subagent's fresh context,
 * and what comes back. The holiday hours bug is the example.
 * States: just the task, the task and the rule, the full contract.
 * Data: the fresh-context fact (harnesses.claudeCode.subagentFreshContext), linked, not quoted.
 * Interaction: a pick of three; items slide into the subagent's window or stay out.
 */
import Figure from '../Figure.astro';
import { anchor } from '../../../lib/facts';
import { url } from '../../../lib/nav';

const items = [
  { text: 'The bug: 25 December shows normal hours', min: 0 },
  { text: 'Agreed earlier: holidays come from the council’s list', min: 1 },
  { text: 'Done means: a test for 25 December passes', min: 2 },
  { text: 'Report: file, line, and what you skipped', min: 2 },
  { text: 'Two hours of talk', min: 9 },
  { text: 'Files it already read', min: 9 },
];
const states = [
  { name: 'Just the task', back: 'A tidy summary', says: 'It finds the hours code and returns a confident summary. It never heard about the council’s list, and you cannot check what it looked at.' },
  { name: 'Task and the rule', back: 'A tidy summary', says: 'It looks in the right place, then sums up. Whether it checked the council’s list, the summary may not say.' },
  { name: 'Full contract', back: 'Files, lines, what it skipped', says: 'It knows the rule, knows when it is done, and comes back with evidence you can check in a minute.' },
];
const fresh = url(`sources/#${anchor('harnesses.claudeCode.subagentFreshContext')}`);
---
<div class="sc" data-sc data-level="0" data-states={JSON.stringify(states)}>
  <div class="pick sc-pick" role="group" aria-label="What goes into the spawn prompt">
    {states.map((s, i) => <button type="button" data-sc-pick={i} aria-pressed={i === 0 ? 'true' : 'false'}>{s.name}</button>)}
  </div>
  <Figure bare n={32} title="A subagent knows only what you pass it" alt="On the left, the main thread's context holds the holiday hours bug, a rule agreed earlier, what done means, the report wanted, two hours of talk and the files already read. Only the bug passes into the subagent's fresh context on the right. A tidy summary comes back.">
    <div class="sc-draw">
      <div class="sc-box" aria-label="Main thread">
        <p class="sc-head">Main thread</p>
        <ul>{items.map((it) => <li data-min={it.min}>{it.text}</li>)}</ul>
      </div>
      <div class="sc-pipe" aria-hidden="true">
        <span class="sc-arrow sc-out">Spawn prompt</span>
        <span class="sc-arrow sc-back" data-sc-back>{states[0]!.back}</span>
      </div>
      <a class="sc-box sc-sub" href={fresh} data-side aria-label="Subagent: starts with a fresh context. Source">
        <p class="sc-head">Subagent, fresh context</p>
        <ul>{items.filter((it) => it.min < 9).map((it) => <li data-min={it.min}>{it.text}</li>)}</ul>
      </a>
    </div>
    <Fragment slot="readout">{states[0]!.says}</Fragment>
  </Figure>
</div>

<style is:global>
  .sc { display: grid; gap: 0.75rem; }
  .sc-pick { width: 100%; }
  .sc-pick button { flex: 1 1 auto; }
  .sc-draw { display: grid; grid-template-columns: minmax(0, 1fr) 4.5rem minmax(0, 1fr); align-items: stretch; gap: 0.25rem; }
  .sc-box { display: block; border: 1px solid var(--rule-strong); border-radius: var(--radius-s); padding: 0.5rem; background: var(--paper); color: inherit; text-decoration: none; }
  .sc-sub { border-style: dashed; background: var(--card); }
  .sc-sub:hover { border-color: var(--accent); }
  .sc-head { margin: 0 0 0.35rem; font-size: var(--text-xs); font-weight: 650; color: var(--ink); }
  .sc-box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .sc-box li { font-size: var(--text-xs); line-height: 1.3; padding: 0.25rem 0.4rem; border-radius: 4px; background: color-mix(in oklab, var(--ink) 7%, var(--card)); color: var(--ink-2); max-width: none; }
  .sc-box li[data-min='9'] { background: none; border: 1px dashed var(--rule-strong); color: var(--muted); }
  .sc-sub li { transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out); }
  .sc-sub li { opacity: 0.18; transform: translateX(-0.5rem); background: none; outline: 1px dashed var(--rule-strong); outline-offset: -1px; }
  .sc[data-level='0'] .sc-sub li[data-min='0'],
  .sc[data-level='1'] .sc-sub li:is([data-min='0'], [data-min='1']),
  .sc[data-level='2'] .sc-sub li { opacity: 1; transform: none; outline: 0; background: color-mix(in oklab, var(--green) 16%, var(--card)); color: var(--ink); }
  .sc-pipe { display: grid; align-content: center; gap: 1.5rem; }
  .sc-arrow { position: relative; display: block; font-size: var(--text-xs); line-height: 1.2; text-align: center; color: var(--ink-2); padding-bottom: 0.4rem; }
  .sc-arrow::after { content: ''; position: absolute; left: 0.25rem; right: 0.25rem; bottom: 0; height: 2px; background: var(--ink-2); }
  .sc-arrow::before { content: ''; position: absolute; bottom: -4px; width: 0; height: 0; border: 5px solid transparent; }
  .sc-out::before { right: -2px; border-left-color: var(--ink-2); }
  .sc-back { color: var(--accent); }
  .sc-back::after { background: var(--accent); }
  .sc-back::before { left: -2px; border-right-color: var(--accent); }
  .sc .fig[data-bare] .fig-readout { min-height: 0; font-family: var(--sans); font-size: var(--text-s); color: var(--ink); }
  @container (max-width: 26rem) {
    .sc-draw { grid-template-columns: minmax(0, 1fr); }
    .sc-pipe { grid-template-columns: 1fr 1fr; gap: 0.75rem; padding: 0.25rem 0; }
  }
  @media (prefers-reduced-motion: reduce) { .sc-sub li { transition: none; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-sc]')) {
    const states: { back: string; says: string }[] = JSON.parse(root.dataset.states!);
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-sc-pick]')];
    const back = root.querySelector<HTMLElement>('[data-sc-back]')!;
    const readout = root.querySelector<HTMLElement>('[data-fig-readout]')!;
    for (const b of buttons) b.addEventListener('click', () => {
      const i = Number(b.dataset.scPick);
      root.dataset.level = String(i);
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      back.textContent = states[i]!.back;
      readout.textContent = states[i]!.says;
    });
  }
</script>
