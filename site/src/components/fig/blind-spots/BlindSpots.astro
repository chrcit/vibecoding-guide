---
/*
 * Fig. 33, "A second model catches what the first cannot see". Goes inside a board tile.
 * Idea: a reviewer misses what it shares with the builder; a different model shares less.
 * Elements: twelve mistakes in a row, a blind-spot band that covers the ones the check misses,
 * the counts caught and through.
 * States: no reviewer, the same model again, another lab's model, another lab then you.
 * Data: the lab's assumed catch rates (named in ../team-lab/model.ts), no facts.
 * Interaction: a pick of four; the band slides to cover the missed mistakes.
 */
import Figure from '../Figure.astro';
import { MISTAKES, OPTIONS, caught } from './model';

const START = 1;
const c = caught(START);
---
<div class="bs" data-bs data-options={JSON.stringify(OPTIONS.map((o, i) => ({ says: o.says, caught: caught(i) })))}>
  <div class="pick bs-pick" role="group" aria-label="Who checks the builder's work">
    {OPTIONS.map((o, i) => <button type="button" data-bs-pick={i} aria-pressed={i === START ? 'true' : 'false'}>{o.name}</button>)}
  </div>
  <Figure bare n={33} title="A second model catches what the first cannot see" alt={`Twelve mistakes a builder made. A copy of the same model reviews and catches ${c}; the rest sit in their shared blind spot and get through.`}>
    <div class="bs-row" style={`--missed:${(MISTAKES - c) / MISTAKES}`}>
      <span class="bs-band" aria-hidden="true"></span>
      {Array.from({ length: MISTAKES }, (_, i) => <span class="bs-dot" data-caught={i >= MISTAKES - c ? '' : undefined} aria-hidden="true"></span>)}
    </div>
    <dl class="bs-count">
      <div><dt>Get through</dt><dd data-bs-through>{MISTAKES - c}</dd></div>
      <div><dt>Caught</dt><dd data-bs-caught>{c}</dd></div>
    </dl>
    <Fragment slot="readout">{OPTIONS[START]!.says}</Fragment>
  </Figure>
</div>

<style is:global>
  .bs { display: grid; gap: 0.75rem; }
  .bs-pick { width: 100%; }
  .bs-pick button { flex: 1 1 40%; }
  .bs-row { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); gap: 0.25rem; padding: 0.75rem 0.25rem; }
  .bs-band {
    position: absolute; inset: 0 auto 0 0; width: 100%; border-radius: var(--radius-s);
    background: color-mix(in oklab, var(--accent) 14%, transparent); border: 1px dashed var(--accent);
    transform-origin: left; transform: scaleX(var(--missed)); transition: transform 500ms var(--ease-out);
  }
  .bs-dot { position: relative; justify-self: center; width: 1.25rem; aspect-ratio: 1; border-radius: 50%; background: var(--accent); transition: background var(--dur), box-shadow var(--dur); }
  .bs-dot[data-caught] { background: var(--card); box-shadow: inset 0 0 0 2px var(--green); }
  .bs-dot[data-caught]::after { content: ''; position: absolute; left: 32%; top: 22%; width: 30%; height: 45%; border: solid var(--green); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .bs-count { display: flex; gap: 1.5rem; margin: 0; }
  .bs-count div { display: flex; align-items: baseline; gap: 0.5rem; }
  .bs-count dt { font-size: var(--text-xs); color: var(--muted); }
  .bs-count dd { margin: 0; font-family: var(--mono); font-size: 1.375rem; font-weight: 600; color: var(--accent); }
  .bs-count div + div dd { color: var(--green); }
  .bs .fig[data-bare] .fig-readout { min-height: 0; font-family: var(--sans); font-size: var(--text-s); color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .bs-band { transition: none; } }
</style>

<script>
  import { MISTAKES } from './model';
  for (const root of document.querySelectorAll<HTMLElement>('[data-bs]')) {
    const opts: { says: string; caught: number }[] = JSON.parse(root.dataset.options!);
    const row = root.querySelector<HTMLElement>('.bs-row')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.bs-dot')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-bs-pick]')];
    const readout = root.querySelector<HTMLElement>('[data-fig-readout]')!;
    for (const b of buttons) b.addEventListener('click', () => {
      const o = opts[Number(b.dataset.bsPick)]!;
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      row.style.setProperty('--missed', String((MISTAKES - o.caught) / MISTAKES));
      dots.forEach((d, i) => d.toggleAttribute('data-caught', i >= MISTAKES - o.caught));
      root.querySelector('[data-bs-through]')!.textContent = String(MISTAKES - o.caught);
      root.querySelector('[data-bs-caught]')!.textContent = String(o.caught);
      readout.textContent = o.says;
    });
  }
</script>
