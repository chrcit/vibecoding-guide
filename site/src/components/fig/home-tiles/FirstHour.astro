---
// The home board's tile for the first hour: the three things a reader can build, as pictures.
// A click picks that build on the first hour's board (it reads `acg-build`) and goes there.
import { builds } from '../../../lib/start';
import { url } from '../../../lib/nav';
import img3d from '../../../assets/start/3d.webp';
import imgApp from '../../../assets/start/app.webp';
import imgSite from '../../../assets/start/site.webp';
const images = { '3d': img3d, app: imgApp, site: imgSite };
---
<ul class="fh">
  {builds.map((b) => (
    <li>
      <a href={url('start/')} data-build={b.id}>
        <img src={images[b.id].src} width={images[b.id].width} height={images[b.id].height} alt={b.alt} loading="lazy" decoding="async" />
        <span>{b.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .fh { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .fh a { display: grid; gap: 0.375rem; color: var(--ink); text-decoration: none; font-size: var(--text-s); font-weight: 600; }
  .fh img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: var(--radius-s); border: 1px solid var(--rule); background: var(--paper-2);
    transition: transform 220ms var(--ease-out), border-color 160ms ease;
  }
  .fh a:hover img { transform: translateY(-2px); border-color: var(--accent); }
  .fh a:hover span { color: var(--accent); }
  .fh a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: var(--radius-s); }
  @media (prefers-reduced-motion: reduce) { .fh img { transition: none; } .fh a:hover img { transform: none; } }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.fh a[data-build]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('acg-build', a.dataset.build!); } catch {} }),
  );
</script>
