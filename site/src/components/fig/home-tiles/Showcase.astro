---
// The home board's tile for the showcase: one small screen per piece, drawn by kind, each a link
// to that piece on the showcase board. The pieces come from src/showcase/.
import { pieces } from '../../../lib/showcase';
import { url } from '../../../lib/nav';
const shown = pieces.slice(0, 4);
---
<ul class="sc">
  {shown.map((p) => (
    <li>
      <a href={url(`showcase/#${p.slug}`)}>
        <svg viewBox="0 0 160 100" aria-hidden="true">
          <rect class="sc-screen" x="1" y="1" width="158" height="98" rx="7" />
          <path class="sc-bar" d="M1 18h158" />
          <circle class="sc-dot" cx="12" cy="10" r="2.5" /><circle class="sc-dot" cx="21" cy="10" r="2.5" /><circle class="sc-dot" cx="30" cy="10" r="2.5" />
          {p.category === '3d' && <g><path class="sc-a" d="M80 34l34 17-34 17-34-17z" /><path class="sc-b" d="M46 51v14l34 17V68z" /><path class="sc-c" d="M114 51v14L80 82V68z" /><path class="sc-lit" d="M74 42l8-6 8 9-7 5z" /></g>}
          {p.category === 'apps' && <g>{[0, 1, 2, 3].map((i) => <g><rect class="sc-a" x="20" y={28 + i * 16} width="120" height="11" rx="2" /><circle class={i % 2 ? 'sc-off' : 'sc-lit'} cx="130" cy={33.5 + i * 16} r="3.5" /></g>)}</g>}
          {p.category === 'pages' && <g><rect class="sc-lit" x="20" y="30" width="78" height="14" rx="2" /><rect class="sc-a" x="20" y="52" width="120" height="6" rx="2" /><rect class="sc-a" x="20" y="64" width="96" height="6" rx="2" /><rect class="sc-b" x="20" y="78" width="44" height="12" rx="3" /></g>}
          {p.category === 'automations' && <g>{[0, 1, 2, 3, 4].map((r) => [0, 1, 2].map((c) => <rect class={r === 2 ? 'sc-lit' : 'sc-a'} x={20 + c * 42} y={28 + r * 13} width="38" height="9" rx="1.5" />))}</g>}
        </svg>
        <span>{p.title}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .sc { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .sc a { display: grid; gap: 0.375rem; color: var(--ink); text-decoration: none; font-size: var(--text-s); font-weight: 600; }
  .sc svg { display: block; width: 100%; height: auto; transition: transform 220ms var(--ease-out); }
  .sc a:hover svg { transform: translateY(-2px); }
  .sc a:hover span { color: var(--accent); }
  .sc a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: var(--radius-s); }
  .sc-screen { fill: var(--paper); stroke: var(--rule-strong); stroke-width: 1.25; }
  .sc a:hover .sc-screen { stroke: var(--accent); }
  .sc-bar { stroke: var(--rule); stroke-width: 1; }
  .sc-dot { fill: var(--rule-strong); }
  .sc-a { fill: color-mix(in oklab, var(--ink) 12%, var(--card)); }
  .sc-b { fill: color-mix(in oklab, var(--ink) 22%, var(--card)); }
  .sc-c { fill: color-mix(in oklab, var(--ink) 32%, var(--card)); }
  .sc-lit { fill: var(--accent); }
  .sc-off { fill: var(--card); stroke: var(--accent); stroke-width: 1.25; }
  @media (prefers-reduced-motion: reduce) { .sc svg { transition: none; } .sc a:hover svg { transform: none; } }
</style>
