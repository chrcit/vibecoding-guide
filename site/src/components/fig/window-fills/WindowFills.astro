---
/*
 * Fig. 3, "The window fills up".
 *
 * Idea: the context window is finite, and what fills it is mostly what the agent's tools return,
 * not what you type; when it is nearly full the harness compacts it into a summary and detail is lost.
 * Elements: the glass (the window), the layers (instructions, your prompt, files read, command
 * output, replies, summary), the compaction mark, the press, the scale whose dial reads how much
 * every turn sends.
 * States: nine steps of one thread on the contact tidy, then the club list in the same thread,
 * ending in compaction (model.ts).
 * Data: the window size and the compaction point arrive as props from src/data/; the sizes of the
 * steps are illustrative and say so in the source line.
 * Interaction: Back and Next step buttons.
 * Alt: model.ts ALT.
 */
import Figure from '../Figure.astro';
import { drawWindowFills } from './draw';
import { STEPS, ALT, describe, layers, stateAt, KIND_NAME, type WindowInputs } from './model';

interface Props extends WindowInputs {
  n?: number | string;
  source?: { label: string; href?: string };
}
const { n = 3, source, ...inputs } = Astro.props;
const { svg, labels, motion } = drawWindowFills(inputs);
const all = layers(inputs);
const last = STEPS.length - 1;
const data = {
  ...motion,
  steps: STEPS.map((_, i) => ({ state: stateAt(i, inputs), says: describe(i, inputs) })),
  names: all.map((l) => KIND_NAME[l.kind]),
  compactStep: STEPS.findIndex((s) => s.compact),
};
---
<div class="fig-wf" data-fig-wf data-motion={JSON.stringify(data)}>
  <Figure n={n} title="The window fills up" hint="Press Next to follow one thread from a fresh start to compaction." alt={ALT} labels={labels} source={source}>
    <Fragment set:html={svg} />
    <Fragment slot="control">
      <button type="button" class="btn ghost" data-back disabled>Back</button>
      <button type="button" class="btn" data-next>Next step</button>
      <span class="fig-wf-count" data-count>Step 0 of {last}</span>
    </Fragment>
    <Fragment slot="readout">{describe(0, inputs)}</Fragment>
    <Fragment slot="caption">
      The agent sees only what is in the window. Your prompt is a sliver; what fills the window is what its tools hand back: files, logs, printed output. A fuller window costs more on every turn and gives the model more to sift, and compaction frees room by throwing detail away.
    </Fragment>
  </Figure>
</div>

<style is:global>
  .fig-wf-count { color: var(--muted); margin-left: auto; font-variant-numeric: tabular-nums; }
  .fig-wf .fig-label[data-label='newest'] { color: var(--ink); font-weight: 600; }
</style>

<script>
  type Flat = [number, number];
  type Motion = {
    newestAt: { left: string; top: string }[];
    pressDown: Flat;
    steps: { state: { newest: number; drawn: number; step: number }; says: string }[];
    names: string[];
    compactStep: number;
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const tr = ([x, y]: Flat) => `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;

  for (const root of document.querySelectorAll<HTMLElement>('[data-fig-wf]')) {
    const m: Motion = JSON.parse(root.dataset.motion!);
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const back = q<HTMLButtonElement>('[data-back]');
    const next = q<HTMLButtonElement>('[data-next]');
    const count = q<HTMLElement>('[data-count]');
    const readout = q<HTMLElement>('[data-fig-readout]');
    const needle = q<SVGGElement>('[data-needle]');
    const press = q<SVGGElement>('[data-press]');
    const newest = q<HTMLElement>('.fig-label[data-label="newest"]');
    const newestName = newest.querySelector<HTMLElement>('.fig-name')!;
    const legendItems = [...root.querySelectorAll<HTMLElement>('.fig-legend li')];
    const labelIndex = [...root.querySelectorAll<HTMLElement>('.fig-drawing .fig-label')].indexOf(newest);
    const layerEls = [...root.querySelectorAll<SVGGElement>('[data-layer]')].sort((a, b) => Number(a.dataset.layer) - Number(b.dataset.layer));
    const last = m.steps.length - 1;
    // Which layers are in the window at each step: everything added so far, and after compaction
    // only the instructions and what compaction added.
    const on = (i: number, j: number) => {
      const added = layerStep[j]! <= i;
      if (!added) return false;
      if (i < m.compactStep) return true;
      return m.names[j] === 'Instructions' || layerStep[j]! >= m.compactStep;
    };
    const layerStep = layerEls.map((el) => Number(el.dataset.step ?? 0));
    let at = 0;
    let pressing: Animation | null = null;

    q<HTMLElement>('[data-fig-control]').hidden = false;

    function show(i: number, animate: boolean) {
      root.style.setProperty('--fig-ms', reduced.matches ? '0ms' : '');
      const s = m.steps[i]!;
      layerEls.forEach((el, j) => {
        const visible = on(i, j);
        el.style.opacity = visible ? '1' : '0';
        if (visible) el.style.transform = 'translate(0px, 0px)';
        else el.style.removeProperty('transform');
        el.querySelector('[data-layer-body]')?.setAttribute('data-tone', j === s.state.newest ? 'lit' : 'part');
      });
      needle.style.transform = `rotate(${-90 + s.state.drawn * 330}deg)`;
      pressing?.cancel();
      pressing = null;
      if (animate && i === m.compactStep && !reduced.matches) {
        pressing = press.animate(
          [{ transform: 'translate(0px, 0px)' }, { transform: tr(m.pressDown), offset: 0.45 }, { transform: tr(m.pressDown), offset: 0.6 }, { transform: 'translate(0px, 0px)' }],
          { duration: 1300, easing: 'cubic-bezier(0.45, 0, 0.25, 1)' },
        );
      }
      const pos = m.newestAt[s.state.newest]!;
      newest.style.left = pos.left;
      newest.style.top = pos.top;
      newestName.textContent = `New: ${m.names[s.state.newest]}`;
      const li = legendItems[labelIndex];
      if (li && li.lastChild) li.lastChild.textContent = `New: ${m.names[s.state.newest]}`;
      readout.textContent = s.says;
      count.textContent = `Step ${i} of ${last}`;
      back.disabled = i === 0;
      next.textContent = i === last ? 'Start again' : 'Next step';
    }

    next.addEventListener('click', () => {
      at = at === last ? 0 : at + 1;
      show(at, at !== 0);
    });
    back.addEventListener('click', () => {
      at = Math.max(0, at - 1);
      show(at, false);
      if (at === 0) next.focus();
    });
    show(0, false);
  }
</script>
