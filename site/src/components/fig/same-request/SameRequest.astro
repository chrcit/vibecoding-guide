---
/*
 * Fig. 4, the same request with and without context.
 *
 * Idea: what the agent is not told, it guesses. One prompt per running example, a set of context
 * pieces the reader switches on and off, and the questions the agent has to answer: each one shows
 * the guess (dashed, accent) until the piece that answers it is given, then what it was told
 * (solid, green). Numbers: guesses left, tokens of context added, share of the window.
 * Controls: example (.pick), prompt only or with everything (.pick), each piece (toggle buttons).
 * Data: the window size arrives as a prop; the examples and token estimates are in model.ts.
 */
import Figure from '../Figure.astro';
import Stat from '../../board/Stat.astro';
import { EXAMPLES, tally, finding } from './model';

interface Props { window: number }
const { window } = Astro.props;
const ex = EXAMPLES[0]!;
const none = new Set<string>();
const t = tally(ex, none);
---
<div class="sr" data-sr data-window={window} data-examples={JSON.stringify(EXAMPLES)}>
  <div class="sr-top">
    <div class="pick" role="group" aria-label="Example" data-sr-examples>
      {EXAMPLES.map((e) => <button type="button" data-ex={e.id} aria-pressed={e.id === ex.id ? 'true' : 'false'}>{e.name}</button>)}
    </div>
    <div class="pick" role="group" aria-label="Context" data-sr-all>
      <button type="button" data-all="none" aria-pressed="true">Prompt only</button>
      <button type="button" data-all="all" aria-pressed="false">With context</button>
    </div>
  </div>
  <Figure n={4} title="Same request, with and without context" alt="A prompt card with five pieces of context switched off, and six questions the agent has to answer, each showing its guess." bare>
    <div class="sr-grid">
      <div class="sr-told">
        <p class="sr-prompt" data-sr-prompt>{ex.prompt}</p>
        <ul class="sr-items" data-sr-items>
          {ex.items.map((i) => (
            <li><button type="button" class="sr-item" data-item={i.id} aria-pressed="false"><span class="sr-name">{i.name}</span><span class="sr-tok">+{i.tokens.toLocaleString('en-GB')}</span></button></li>
          ))}
        </ul>
      </div>
      <ol class="sr-rows" data-sr-rows>
        {ex.rows.map((r) => (
          <li class="sr-row" data-by={r.by} data-state="guess">
            <span class="sr-q">{r.q}</span>
            <span class="sr-card">
              <span class="sr-mark" aria-hidden="true"></span>
              <span class="sr-guess"><span class="sr-vh">Guesses: </span>{r.guess}</span>
              <span class="sr-answer"><span class="sr-vh">Told: </span>{r.told}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </Figure>
  <div class="sr-foot">
    <p class="finding" aria-live="polite" data-sr-finding set:html={finding(ex, none, window)} />
    <dl class="stats sr-stats">
      <Stat name="Guesses" id="sr-guesses" tone="accent">{`${t.guesses} of ${ex.rows.length}`}</Stat>
      <Stat name="Context added" id="sr-tokens" tone="green">{`${t.tokens} tokens`}</Stat>
    </dl>
  </div>
</div>

<style is:global>
  .sr { display: grid; gap: 0.875rem; }
  .sr-top { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; justify-content: space-between; }
  .sr-grid { display: grid; gap: 0.875rem 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @container (min-width: 720px) { .sr-grid { grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 2fr); } }
  .sr-prompt {
    position: relative; margin: 0 0 0.75rem; padding: 0.75rem 0.875rem;
    border-radius: var(--radius) var(--radius) var(--radius) 3px;
    background: var(--screen); color: var(--screen-ink);
    font-family: var(--mono); font-size: var(--text-s); line-height: 1.45;
  }
  .sr-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.375rem; }
  .tile .sr-items li { max-width: none; }
  .sr-item {
    width: 100%; min-height: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.375rem 0.75rem; border: 1px dashed var(--rule-strong); border-radius: var(--radius-s);
    background: none; color: var(--muted); font: inherit; font-size: var(--text-s); text-align: left; cursor: pointer;
    transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .sr-item::before { content: '+'; font-family: var(--mono); width: 1rem; flex: none; }
  .sr-item[aria-pressed='true'] { border-style: solid; border-color: var(--green); background: var(--green-soft); color: var(--ink); }
  .sr-item[aria-pressed='true']::before { content: '✓'; color: var(--green); }
  .sr-item:hover { color: var(--ink); }
  .sr-name { flex: 1 1 auto; }
  .sr-tok { font-family: var(--mono); font-size: var(--text-xs); color: var(--muted); }
  .sr-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.375rem; }
  .tile .sr-rows li { max-width: none; }
  .sr-row { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr); gap: 0.25rem 0.75rem; align-items: center; }
  @container (max-width: 520px) { .sr-row { grid-template-columns: minmax(0, 1fr); } }
  .sr-q { font-size: var(--text-s); color: var(--ink-2); }
  .sr-card {
    position: relative; display: grid; align-items: center; min-height: 2.75rem;
    padding: 0.4rem 0.75rem 0.4rem 2.5rem; border-radius: var(--radius-s);
    border: 1.5px dashed var(--accent); background: var(--accent-soft); color: var(--ink);
    font-size: var(--text-s); line-height: 1.3;
    transition: background-color 400ms var(--ease-out), border-color 400ms var(--ease-out);
  }
  .sr-card > .sr-guess, .sr-card > .sr-answer { grid-area: 1 / 1; transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out); }
  .sr-answer { opacity: 0; transform: translateY(4px); }
  .sr-mark { position: absolute; left: 0.625rem; top: 50%; translate: 0 -50%; width: 1.375rem; height: 1.375rem; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-family: var(--mono); font-size: var(--text-xs); font-weight: 700; }
  .sr-mark::after { content: '?'; }
  .sr-row[data-state='told'] .sr-card { border-style: solid; border-color: var(--green); background: var(--green-soft); }
  .sr-row[data-state='told'] .sr-guess { opacity: 0; transform: translateY(-4px); }
  .sr-row[data-state='told'] .sr-answer { opacity: 1; transform: none; }
  .sr-row[data-state='told'] .sr-mark { background: var(--green); color: var(--card); }
  .sr-row[data-state='told'] .sr-mark::after { content: '✓'; }
  .sr-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .sr-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .sr-foot .finding { flex: 1 1 20rem; }
  .sr-stats { flex: 0 1 20rem; grid-template-columns: 1fr 1fr; }
  @media (prefers-reduced-motion: reduce) { .sr-card, .sr-card > * { transition: none !important; } }
</style>

<script>
  import { finding, tally, type Example } from './model';

  for (const root of document.querySelectorAll<HTMLElement>('[data-sr]')) {
    const examples: Example[] = JSON.parse(root.dataset.examples!);
    const window = Number(root.dataset.window);
    const prompt = root.querySelector<HTMLElement>('[data-sr-prompt]')!;
    const items = root.querySelector<HTMLElement>('[data-sr-items]')!;
    const rows = root.querySelector<HTMLElement>('[data-sr-rows]')!;
    const findingEl = root.querySelector<HTMLElement>('[data-sr-finding]')!;
    const stat = (id: string) => root.querySelector<HTMLElement>(`[data-stat="${id}"]`)!;
    const allBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-all]')];
    const exBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-ex]')];
    let ex = examples.find((e) => e.id === exBtns.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.ex) ?? examples[0]!;
    const on = new Set<string>();
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

    function build() {
      prompt.textContent = ex.prompt;
      items.innerHTML = ex.items
        .map((i) => `<li><button type="button" class="sr-item" data-item="${i.id}" aria-pressed="false"><span class="sr-name">${esc(i.name)}</span><span class="sr-tok">+${i.tokens.toLocaleString('en-GB')}</span></button></li>`)
        .join('');
      rows.innerHTML = ex.rows
        .map(
          (r) =>
            `<li class="sr-row" data-by="${r.by}" data-state="guess"><span class="sr-q">${esc(r.q)}</span><span class="sr-card"><span class="sr-mark" aria-hidden="true"></span><span class="sr-guess"><span class="sr-vh">Guesses: </span>${esc(r.guess)}</span><span class="sr-answer"><span class="sr-vh">Told: </span>${esc(r.told)}</span></span></li>`,
        )
        .join('');
    }
    function show() {
      for (const b of items.querySelectorAll<HTMLButtonElement>('[data-item]')) b.setAttribute('aria-pressed', String(on.has(b.dataset.item!)));
      for (const r of rows.querySelectorAll<HTMLElement>('[data-by]')) r.dataset.state = on.has(r.dataset.by!) ? 'told' : 'guess';
      const t = tally(ex, on);
      stat('sr-guesses').textContent = `${t.guesses} of ${ex.rows.length}`;
      stat('sr-tokens').textContent = `${t.tokens.toLocaleString('en-GB')} tokens`;
      findingEl.innerHTML = finding(ex, on, window);
      const all = on.size === ex.items.length ? 'all' : on.size === 0 ? 'none' : '';
      for (const b of allBtns) b.setAttribute('aria-pressed', String(b.dataset.all === all));
    }
    items.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-item]');
      if (!b) return;
      const id = b.dataset.item!;
      if (on.has(id)) on.delete(id);
      else on.add(id);
      show();
    });
    for (const b of allBtns)
      b.addEventListener('click', () => {
        on.clear();
        if (b.dataset.all === 'all') for (const i of ex.items) on.add(i.id);
        show();
      });
    for (const b of exBtns)
      b.addEventListener('click', () => {
        ex = examples.find((e) => e.id === b.dataset.ex)!;
        for (const x of exBtns) x.setAttribute('aria-pressed', String(x === b));
        const keep = on.size === ex.items.length || on.size > 0;
        on.clear();
        if (keep && allBtns.find((x) => x.dataset.all === 'all')?.getAttribute('aria-pressed') === 'true') for (const i of ex.items) on.add(i.id);
        build();
        show();
      });
  }
</script>
