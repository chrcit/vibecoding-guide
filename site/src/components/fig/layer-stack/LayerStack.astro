---
/*
 * Fig. 65, "One request through six layers". The home board's lab.
 *
 * Idea: a request to an agent travels down through the interface, the context and the harness to
 *   the model and back, round a loop of tool calls, past a permission gate and a check, until it
 *   comes back to you; the route, and what you get back, depend on the check and the permission mode.
 * Elements: four plates stepping down (interface, context, harness, model); a glass window that
 *   fills block by block; a checkpoint with a gate and a lamp (governance); two other threads behind
 *   (emergence); the request, lit.
 * States: four scenarios (model.ts) of 10 to 17 steps.
 * Data: none from src/data/. Token counts are the assumptions at the top of model.ts.
 * Interaction: a scenario pick; back, play and next; a step slider. Each layer is a link that opens
 *   its section of the long read in the side view.
 *
 * Built on its own <figure>, not Figure.astro: Figure marks the drawing role="img", which would hide
 * the layer links laid over it from assistive technology.
 */
import '../fig.css';
import Stat from '../../board/Stat.astro';
import { drawStack } from './draw';
import { STEPS, SCENARIOS, LAYERS, LAYER_OF, stats } from './model';
import { url } from '../../../lib/nav';

interface Props {
  /** Where each layer's explanation lives: a site path with an anchor. */
  hrefs: Record<string, string>;
}
const { hrefs } = Astro.props;
const { svg: raw, labels, motion } = drawStack();
// Each layer's drawing opens its explanation in the side view on click (mouse); the labels are the
// keyboard and screen-reader route, so the drawing stays aria-hidden.
const svg = raw.replace(/data-layer="([a-z]+)"/g, (_, id) => `data-layer="${id}" data-side="${url(hrefs[id]!)}"`);
const first = STEPS.test[0]!;
const s0 = stats(first);
---
<div class="ls" data-ls data-motion={JSON.stringify(motion)}>
  <figure class="fig ls-fig" id="fig-65" data-figure="65" data-bare aria-labelledby="fig-65-title">
    <p class="fig-head"><span class="fig-n">Fig. 65</span><span class="fig-title" id="fig-65-title">One request through six layers</span></p>
    <div class="ls-stage">
      <div class="ls-drawing" data-ls-drawing>
        <Fragment set:html={svg} />
        {LAYERS.map((l, n) => (
          <a class="ls-label" href={url(hrefs[l.id]!)} data-side data-label={l.id} style={`left:${labels[l.id].left};top:${labels[l.id].top}`} data-active={l.id === LAYER_OF[first.at] ? '' : undefined}>
            <span class="ls-key" aria-hidden="true">{n + 1}</span><span class="ls-name">{l.name}</span>
          </a>
        ))}
      </div>
      <div class="ls-rail">
        <div class="pick ls-pick" role="group" aria-label="Scenario">
          {SCENARIOS.map((s) => <button type="button" data-scenario={s.id} aria-pressed={s.id === 'test' ? 'true' : 'false'}>{s.name}</button>)}
        </div>
        <p class="finding ls-finding" aria-live="polite" data-ls-says>{first.says}</p>
        <dl class="stats ls-stats">
          <Stat name="Model calls" id="calls">{s0.calls}</Stat>
          <Stat name="Tool calls" id="tools">{s0.tools}</Stat>
          <Stat name="In the window" id="tokens">{s0.tokens}</Stat>
          <Stat name="Waiting on you" id="waits" tone="accent">{s0.waits}</Stat>
          <Stat name="Checked" id="checked">{s0.checked}</Stat>
        </dl>
      </div>
    </div>
    <ol class="ls-legend">
      {LAYERS.map((l, n) => <li><a href={url(hrefs[l.id]!)} data-side data-label={l.id}><span class="ls-key" aria-hidden="true">{n + 1}</span>{l.name}</a></li>)}
    </ol>
    <div class="ls-controls" data-ls-controls hidden>
      <button type="button" class="ls-btn" data-ls-back aria-label="Back one step">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
      </button>
      <button type="button" class="ls-btn ls-play" data-ls-play aria-label="Play">
        <svg class="i-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
        <svg class="i-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4.5 3.5h2.4v9H4.5zM9.1 3.5h2.4v9H9.1z" fill="currentColor" /></svg>
      </button>
      <button type="button" class="ls-btn" data-ls-next aria-label="Next step">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
      </button>
      <label class="ls-scrub">
        <span class="visually-hidden">Step</span>
        <input type="range" min="0" max={STEPS.test.length - 1} step="1" value="0" data-ls-step />
      </label>
      <output class="ls-count" data-ls-count>1 / {STEPS.test.length}</output>
    </div>
  </figure>
</div>

<style is:global>
  .ls-fig { position: relative; }
  .ls-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem); gap: 0.25rem 1.25rem; align-items: start; }
  .ls-drawing { position: relative; min-width: 0; }
  .ls-drawing .k-svg { display: block; width: 100%; height: auto; overflow: visible; }

  .ls-rail { display: grid; gap: 0.875rem; align-content: start; padding-top: 0.25rem; }
  .ls-pick { display: grid; grid-template-columns: 1fr 1fr; }
  .ls-pick button { padding: 0 0.5rem; }
  .ls-finding { min-height: 5.6em; font-size: var(--text-m); }
  .ls-stats { grid-template-columns: 1fr 1fr; }
  .ls-stats .stat:last-child { grid-column: 1 / -1; }
  .ls-stats .stat-value { transition: color 200ms ease; }
  .ls-stats [data-stat='checked'][data-v='Failed'] { color: var(--accent); }
  .ls-stats [data-stat='checked'][data-v='Passed'] { color: var(--green); }

  /* Layer labels: real links over the drawing. */
  .ls-label {
    position: absolute; transform: translate(-50%, -50%);
    display: inline-flex; align-items: center; gap: 0.375rem;
    min-height: 2rem; padding: 0.2rem 0.6rem 0.2rem 0.3rem;
    border: 1px solid var(--rule); border-radius: 999px;
    background: color-mix(in oklab, var(--card) 88%, transparent);
    font-family: var(--mono); font-size: 0.875rem; line-height: 1; white-space: nowrap;
    color: var(--ink-2); text-decoration: none;
    transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
  }
  .ls-label::after { content: ''; position: absolute; inset: -0.35rem; }
  .ls-key {
    display: inline-grid; place-items: center; width: 1.375rem; height: 1.375rem; border-radius: 999px;
    background: var(--paper-2); color: var(--ink); font-family: var(--mono); font-size: 0.8125rem;
  }
  .ls-label:hover, .ls-label[data-hot] { color: var(--ink); border-color: var(--rule-strong); }
  .ls-label[data-active] { color: var(--ink); border-color: var(--accent); font-weight: 600; }
  .ls-label[data-active] .ls-key { background: var(--accent); color: var(--accent-ink); }
  .ls-label:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

  .ls .ls-hit { fill: transparent; stroke: none; }
  .ls .ls-layer { transition: opacity 220ms ease; }
  .ls .ls-layer[data-side] { cursor: pointer; }
  .ls-drawing[data-hover] .ls-layer:not([data-hot]) { opacity: 0.55; }

  .ls [data-lamp='fail'] .k-fill, .ls [data-lamp='fail'] .k-top, .ls [data-lamp='fail'] .k-left,
  .ls [data-lamp='fail'] .k-right, .ls [data-lamp='fail'] .k-shadow { fill: var(--accent-soft); }
  .ls [data-lamp='fail'] .k-edge, .ls [data-lamp='fail'] .k-crease { stroke: var(--accent); stroke-width: 2px; }
  .ls [data-lamp='pass'] .k-fill, .ls [data-lamp='pass'] .k-top { fill: color-mix(in oklab, var(--green) 45%, var(--card)); }
  .ls [data-lamp='pass'] .k-left, .ls [data-lamp='pass'] .k-right, .ls [data-lamp='pass'] .k-shadow { fill: var(--green); }
  .ls [data-lamp='pass'] .k-edge { stroke: var(--green); }
  .ls [data-ghost] .k-solid { transition: opacity 300ms ease; }

  .ls-legend { display: none; margin: 0.5rem 0 0; padding: 0; list-style: none; flex-wrap: wrap; gap: 0.375rem; }
  .ls-legend a {
    display: inline-flex; align-items: center; gap: 0.375rem; min-height: 2.5rem; padding: 0 0.625rem 0 0.375rem;
    border: 1px solid var(--rule); border-radius: 999px; font-family: var(--mono); font-size: 0.875rem;
    color: var(--ink-2); text-decoration: none;
  }
  .ls-legend a[data-active] { border-color: var(--accent); color: var(--ink); }
  .ls-legend a[data-active] .ls-key { background: var(--accent); color: var(--accent-ink); }

  .ls-controls { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem; }
  .ls-controls[hidden] { display: none; }
  .ls-btn {
    flex: none; display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-s); background: var(--card); color: var(--ink); cursor: pointer;
    transition: transform 120ms var(--ease-out), background-color 160ms ease;
  }
  .ls-btn:hover { background: var(--paper-2); }
  .ls-btn:active { transform: scale(0.96); }
  .ls-btn:disabled { opacity: 0.4; cursor: default; transform: none; }
  .ls-play { width: 3.25rem; background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .ls-play:hover { background: color-mix(in oklab, var(--ink) 85%, var(--paper)); }
  .ls-play .i-pause, .ls-play[aria-pressed='true'] .i-play { display: none; }
  .ls-play[aria-pressed='true'] .i-pause { display: block; }
  .ls-scrub { flex: 1 1 auto; min-width: 0; display: flex; }
  .ls-scrub input { width: 100%; min-height: 2.75rem; margin: 0; accent-color: var(--accent); }
  .ls-count { flex: none; min-width: 4.5ch; text-align: right; font-family: var(--mono); font-size: var(--text-s); color: var(--muted); font-variant-numeric: tabular-nums; }

  @container (max-width: 46rem) {
    .ls-stage { grid-template-columns: minmax(0, 1fr); }
    .ls-rail { grid-template-columns: minmax(0, 1fr); }
    .ls-pick { grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); }
    .ls-stats { grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); }
    .ls-stats .stat:last-child { grid-column: auto; }
    .ls-finding { min-height: 4.4em; }
  }
  @container (max-width: 34rem) {
    .ls-label { min-height: 0; padding: 0; border: 0; background: none; }
    .ls-label .ls-name { display: none; }
    .ls-label .ls-key { width: 1.625rem; height: 1.625rem; box-shadow: 0 0 0 2px var(--card); }
    .ls-label::after { inset: -0.5rem; }
    .ls-legend { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ls-label, .ls .ls-layer, .ls-btn { transition: none; }
  }
</style>

<script>
  import { STEPS, LAYER_OF, stats, type Scenario, type Step } from './model';

  type Flat = [number, number];
  type Motion = { spots: Record<string, Flat>; hop: Flat; gate: Flat; drop: Flat; ghostRest: Flat[]; ghostHome: Flat[] };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const tr = ([x, y]: Flat) => `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
  const STEP_MS = 1900;

  for (const root of document.querySelectorAll<HTMLElement>('[data-ls]')) {
    const m: Motion = JSON.parse(root.dataset.motion!);
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const drawing = q<HTMLElement>('[data-ls-drawing]');
    const puck = q<SVGGElement>('[data-puck]');
    const core = q<SVGGElement>('[data-core]');
    const gate = q<SVGGElement>('[data-gate]');
    const lamp = q<SVGGElement>('[data-lamp]');
    const blocks = [...root.querySelectorAll<SVGGElement>('[data-block]')];
    const ghosts = [...root.querySelectorAll<SVGGElement>('[data-ghost]')];
    const says = q<HTMLElement>('[data-ls-says]');
    const slider = q<HTMLInputElement>('[data-ls-step]');
    const count = q<HTMLOutputElement>('[data-ls-count]');
    const back = q<HTMLButtonElement>('[data-ls-back]');
    const next = q<HTMLButtonElement>('[data-ls-next]');
    const play = q<HTMLButtonElement>('[data-ls-play]');
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-scenario]')];
    const labels = [...root.querySelectorAll<HTMLElement>('[data-label]')];
    const layers = [...root.querySelectorAll<SVGGElement>('.ls-layer')];
    const stat = (id: string) => q<HTMLElement>(`[data-stat="${id}"]`);

    let scenario: Scenario = 'test';
    let at = 0;
    let timer = 0;
    let moving: Animation | null = null;
    q<HTMLElement>('[data-ls-controls]').hidden = false;

    const steps = () => STEPS[scenario];

    function movePuck(from: Step | null, to: Step, animate: boolean) {
      moving?.cancel();
      moving = null;
      const b = m.spots[to.at]!;
      if (animate && from && from.at !== to.at && !reduced.matches) {
        const a = m.spots[from.at]!;
        const mid: Flat = [(a[0] + b[0]) / 2 + m.hop[0], Math.min(a[1], b[1]) + m.hop[1]];
        moving = puck.animate([{ transform: tr(a) }, { transform: tr(mid), offset: 0.45 }, { transform: tr(b) }], {
          duration: 820, easing: 'cubic-bezier(0.45, 0, 0.25, 1)',
        });
      }
      puck.style.transform = tr(b);
    }

    function show(i: number, animate: boolean) {
      const list = steps();
      const prev = animate && i > 0 ? list[i - 1]! : null;
      const s = list[i]!;
      at = i;
      root.style.setProperty('--fig-ms', reduced.matches || !animate ? '0ms' : '');
      movePuck(prev, s, animate);
      core.style.opacity = s.core ? '1' : '0';
      gate.style.transform = s.gate ? tr(m.gate) : 'translate(0px, 0px)';
      lamp.dataset.lamp = s.lamp;
      blocks.forEach((b, n) => {
        const on = n < s.blocks;
        b.style.opacity = on ? '1' : '0';
        b.style.transform = on ? 'translate(0px, 0px)' : tr(m.drop);
      });
      ghosts.forEach((g, n) => {
        g.style.transform = tr(s.others > n ? m.ghostHome[n]! : m.ghostRest[n]!);
      });
      const active = new Set([LAYER_OF[s.at]]);
      if (s.others) active.add('emergence');
      for (const l of labels) l.toggleAttribute('data-active', active.has(l.dataset.label as never));
      says.textContent = s.says;
      const v = stats(s);
      for (const [id, text] of Object.entries(v)) {
        const el = stat(id);
        el.textContent = text;
        el.dataset.v = text;
      }
      slider.max = String(list.length - 1);
      slider.value = String(i);
      slider.setAttribute('aria-valuetext', `Step ${i + 1} of ${list.length}: ${s.says}`);
      count.textContent = `${i + 1} / ${list.length}`;
      back.disabled = i === 0;
      next.disabled = i === list.length - 1;
    }

    function stop() {
      clearInterval(timer);
      timer = 0;
      play.setAttribute('aria-pressed', 'false');
      play.setAttribute('aria-label', 'Play');
    }
    function start() {
      if (at >= steps().length - 1) show(0, false);
      play.setAttribute('aria-pressed', 'true');
      play.setAttribute('aria-label', 'Pause');
      timer = window.setInterval(() => {
        if (at >= steps().length - 1) return stop();
        show(at + 1, true);
        if (at >= steps().length - 1) stop();
      }, STEP_MS);
      show(Math.min(at + 1, steps().length - 1), true);
    }

    play.addEventListener('click', () => (timer ? stop() : start()));
    next.addEventListener('click', () => { stop(); show(Math.min(at + 1, steps().length - 1), true); });
    back.addEventListener('click', () => { stop(); show(Math.max(at - 1, 0), false); });
    slider.addEventListener('input', () => { stop(); const i = Number(slider.value); show(i, i === at + 1); });
    picks.forEach((b) => b.addEventListener('click', () => {
      stop();
      scenario = b.dataset.scenario as Scenario;
      picks.forEach((p) => p.setAttribute('aria-pressed', String(p === b)));
      show(0, false);
      start();
    }));

    // Hovering a layer lights its label, and the other way round.
    const hot = (id: string | null) => {
      drawing.toggleAttribute('data-hover', !!id);
      layers.forEach((g) => g.toggleAttribute('data-hot', g.dataset.layer === id));
      labels.forEach((l) => l.toggleAttribute('data-hot', l.dataset.label === id));
    };
    layers.forEach((g) => {
      g.addEventListener('pointerenter', () => hot(g.dataset.layer!));
      g.addEventListener('pointerleave', () => hot(null));
    });
    labels.forEach((l) => {
      l.addEventListener('pointerenter', () => hot(l.dataset.label!));
      l.addEventListener('pointerleave', () => hot(null));
      l.addEventListener('focus', () => hot(l.dataset.label!));
      l.addEventListener('blur', () => hot(null));
    });

    show(0, false);
  }
</script>
