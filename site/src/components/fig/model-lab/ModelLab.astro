---
/*
 * Fig. 60, "The model lab". Chart mode, two tiles.
 *
 * Idea: every model in the data as a point on two axes the reader chooses, so they do the
 * comparing; the guide only places published numbers.
 * Elements: the scatter (one mark per model, shape by lab), the axis names as the axis controls,
 * filters by lab and by class (place in its lab's line-up by output price), a list of the models
 * left off for a missing number, and a compare tile that fills in row by row for up to three.
 * Data: models.ts and benchmarks.ts through components/models/lab-data.ts. No assumptions.
 * Interaction: a mark opens the model's card in the side view; the chips and presets in the compare
 * tile choose what to compare; the selects choose the axes.
 * Replaces Fig. 10 (score against cost), which was this chart with the axes fixed.
 */
import Tile from '../../board/Tile.astro';
import { draw } from './draw';
import { compareTable } from './compare';
import { METRICS, KLASSES, finding, presets, place, visible, type LabModel, type MetricKey, type Klass } from './model';
import { url } from '../../../lib/nav';

interface Props {
  rows: LabModel[];
  /** The tiles' side-view targets. */
  side?: { lab?: string; compare?: string };
}
const { rows, side = {} } = Astro.props;
const base = url('');
const labs = [...new Set(rows.map((r) => r.lab))];
const startKlasses: Klass[] = ['dearest', 'middle', 'cheapest'];
const startX: MetricKey = 'output', startY: MetricKey = 'score';
const sets = presets(rows);
const startCompare = sets[0]?.ids ?? [];
const shown = visible(rows, { labs, klasses: startKlasses });
const { off } = place(shown, startX, startY);
const state = { rows, labs, x: startX, y: startY, klasses: startKlasses, compare: startCompare, presets: sets, base };
---
<Tile title="Place every model on the axes you choose" span={8} id="lab" side={side.lab}>
  <div class="ml" id="fig-60" data-figure="60" data-model-lab data-state={JSON.stringify(state)}>
    <div class="ml-filters">
      <div class="pick" role="group" aria-label="Lab">
        {labs.map((l) => <button type="button" aria-pressed="true" data-lab={l}>{l}</button>)}
      </div>
      <div class="pick" role="group" aria-label="Class: place in its lab's line-up by output price">
        {KLASSES.map((k) => <button type="button" aria-pressed={String(startKlasses.includes(k.key))} data-klass={k.key}>{k.name}</button>)}
      </div>
    </div>
    <label class="ml-axis ml-axis-y">
      <span class="sr-only">Up the side</span>
      <select data-axis="y">{METRICS.map((m) => <option value={m.key} selected={m.key === startY}>{m.name}</option>)}</select>
    </label>
    <div class="ml-chart" data-chart set:html={draw(shown, startX, startY, 900, 440, startCompare)} />
    <label class="ml-axis ml-axis-x">
      <span class="sr-only">Along the bottom</span>
      <select data-axis="x">{METRICS.map((m) => <option value={m.key} selected={m.key === startX}>{m.name}</option>)}</select>
    </label>
    <p class="ml-off" data-off hidden={!off.length}>
      <span>Off the chart</span>
      {off.map((o) => <a href={o.row.card} data-side title={o.why}>{o.row.name} <span class="gap">{o.why}</span></a>)}
    </p>
    <p class="finding" aria-live="polite" data-finding>{finding(shown, startX, startY)}</p>
  </div>
</Tile>

<Tile title="Side by side, every number sourced" span={4} id="compare" side={side.compare}>
  <div class="ml-cmp" data-model-compare>
    <div class="pick ml-presets" role="group" aria-label="Ready-made comparisons">
      {sets.map((p, i) => <button type="button" aria-pressed={String(i === 0)} data-preset={p.key}>{p.name}</button>)}
    </div>
    <div class="ml-chips" role="group" aria-label="Models to compare, up to three">
      {rows.map((r) => <button type="button" class="ml-chip" aria-pressed={String(startCompare.includes(r.id))} data-pick={r.id}>{r.name}</button>)}
    </div>
    <div class="ml-table" data-compare set:html={compareTable(rows, startCompare, base)} />
  </div>
</Tile>

<style is:global>
  .ml { --fig-edge: color-mix(in oklab, var(--ink) 72%, var(--card)); --fig-line: color-mix(in oklab, var(--ink) 42%, var(--card)); --fig-faint: color-mix(in oklab, var(--ink) 18%, var(--card)); --fig-ease: cubic-bezier(0.32, 0.72, 0, 1); }
  .ml { display: grid; gap: 0.5rem; }
  .ml-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ml-filters .pick button { min-height: 2.5rem; }
  .ml-axis select {
    min-height: 2.5rem; max-width: 100%; padding: 0 2rem 0 0.625rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-s);
    background: var(--paper); color: var(--ink); font: inherit; font-family: var(--mono); font-size: var(--text-xs);
  }
  .ml-axis-x { justify-self: end; margin-top: -0.25rem; }
  .ml-axis-y { justify-self: start; }
  .ml-chart { min-height: 16rem; }
  .ml-svg .ml-point { cursor: pointer; outline: none; }
  .ml-svg .ml-hit { fill: transparent; }
  .ml-svg .ml-point circle:not(.ml-hit):not(.ml-ring), .ml-svg .ml-point rect { fill: var(--card); stroke: var(--fig-edge); stroke-width: 1.75px; }
  .ml-svg .ml-point[data-tone='blue'] circle:not(.ml-hit):not(.ml-ring), .ml-svg .ml-point[data-tone='blue'] rect { stroke: var(--blue); fill: color-mix(in oklab, var(--blue) 18%, var(--card)); }
  .ml-svg .ml-point[data-on] circle:not(.ml-hit):not(.ml-ring), .ml-svg .ml-point[data-on] rect { fill: var(--accent); stroke: var(--accent); }
  .ml-svg .ml-ring { fill: none; stroke: var(--accent); stroke-width: 1.5px; opacity: 0.5; }
  .ml-svg .ml-point:hover .ml-hit, .ml-svg .ml-point:focus-visible .ml-hit { fill: color-mix(in oklab, var(--accent) 14%, transparent); }
  .ml-svg .ml-point:focus-visible .ml-hit { stroke: var(--focus); stroke-width: 2px; }
  .ml-svg .ml-name { fill: var(--ink-2); }
  .ml-svg .ml-name[data-on] { fill: var(--ink); font-weight: 650; }
  .ml-off { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.875rem; margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .ml-off[hidden] { display: none; }
  .ml-off a { color: var(--ink-2); text-decoration: none; }
  .ml-off a:hover { color: var(--accent); }
  .ml-off .gap, .ml-cmp .gap { color: var(--muted); font-style: italic; }

  .ml-cmp { display: grid; gap: 0.625rem; }
  .ml-presets { display: flex; }
  .ml-presets button { flex: 1 1 auto; white-space: normal; text-align: center; line-height: 1.2; }
  .ml-chips { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .ml-chip {
    min-height: 2.5rem; padding: 0 0.625rem;
    border: 1px solid var(--rule); border-radius: var(--radius-pill);
    background: none; color: var(--ink-2); cursor: pointer; font: inherit; font-size: var(--text-xs);
  }
  .ml-chip:hover { border-color: var(--rule-strong); color: var(--ink); }
  .ml-chip[aria-pressed='true'] { background: var(--accent-soft); border-color: var(--accent); color: var(--ink); font-weight: 600; }
  .ml-table { overflow-x: auto; }
  .ml-compare { width: 100%; border-collapse: collapse; font-size: var(--text-xs); }
  .ml-compare th, .ml-compare td { padding: 0.25rem 0.375rem; line-height: 1.3; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .ml-compare thead th { font-weight: 650; color: var(--ink); line-height: 1.25; }
  .ml-compare thead a { color: inherit; text-decoration: none; }
  .ml-compare thead a:hover { color: var(--accent); }
  .ml-compare tbody th { font-weight: 500; color: var(--muted); white-space: nowrap; }
  .ml-compare td { font-family: var(--mono); color: var(--ink); overflow-wrap: anywhere; }
  .ml-compare .ml-src { color: inherit; text-decoration: underline dotted var(--muted); text-underline-offset: 0.2em; }
  .ml-compare .ml-src:hover { color: var(--accent); text-decoration-color: var(--accent); }
  .ml-empty { margin: 0; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>

<script>
  import { draw } from './draw';
  import { compareTable } from './compare';
  import { finding, place, visible, type LabModel, type MetricKey, type Klass } from './model';

  const root = document.querySelector<HTMLElement>('[data-model-lab]');
  const cmp = document.querySelector<HTMLElement>('[data-model-compare]');
  if (root && cmp) {
    const s = JSON.parse(root.dataset.state!) as {
      rows: LabModel[]; labs: string[]; x: MetricKey; y: MetricKey; klasses: Klass[]; compare: string[];
      presets: { key: string; ids: string[] }[]; base: string;
    };
    const box = root.querySelector<HTMLElement>('[data-chart]')!;
    const off = root.querySelector<HTMLElement>('[data-off]')!;
    const find = root.querySelector<HTMLElement>('[data-finding]')!;
    const table = cmp.querySelector<HTMLElement>('[data-compare]')!;
    let labs = [...s.labs], klasses = [...s.klasses], x = s.x, y = s.y, compare = [...s.compare];
    let lastFinding = '';

    const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const height = (w: number) => Math.round(Math.max(280, Math.min(460, w * (w < 560 ? 0.78 : 0.5))));

    const renderChart = () => {
      const rows = visible(s.rows, { labs, klasses });
      const w = Math.round(box.clientWidth);
      if (!w) return;
      box.innerHTML = draw(rows, x, y, w, height(w), compare);
      const { off: left } = place(rows, x, y);
      off.hidden = !left.length;
      off.innerHTML = `<span>Off the chart</span>` + left.map((o) => `<a href="${esc(o.row.card)}" data-side title="${esc(o.why)}">${esc(o.row.name)} <span class="gap">${esc(o.why)}</span></a>`).join('');
      const f = finding(rows, x, y);
      if (f !== lastFinding) { find.textContent = f; lastFinding = f; }
    };
    const renderCompare = () => {
      table.innerHTML = compareTable(s.rows, compare, s.base);
      for (const b of cmp.querySelectorAll<HTMLButtonElement>('[data-pick]')) b.setAttribute('aria-pressed', String(compare.includes(b.dataset.pick!)));
      for (const b of cmp.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
        const p = s.presets.find((q) => q.key === b.dataset.preset)!;
        b.setAttribute('aria-pressed', String(p.ids.length === compare.length && p.ids.every((id) => compare.includes(id))));
      }
    };
    const all = () => { renderChart(); renderCompare(); };

    const toggle = (list: string[], v: string) => (list.includes(v) ? list.filter((q) => q !== v) : [...list, v]);
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-lab]')) {
      b.addEventListener('click', () => {
        labs = toggle(labs, b.dataset.lab!);
        b.setAttribute('aria-pressed', String(labs.includes(b.dataset.lab!)));
        renderChart();
      });
    }
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-klass]')) {
      b.addEventListener('click', () => {
        klasses = toggle(klasses, b.dataset.klass!) as Klass[];
        b.setAttribute('aria-pressed', String(klasses.includes(b.dataset.klass as Klass)));
        renderChart();
      });
    }
    for (const sel of root.querySelectorAll<HTMLSelectElement>('[data-axis]')) {
      sel.addEventListener('change', () => {
        if (sel.dataset.axis === 'x') x = sel.value as MetricKey;
        else y = sel.value as MetricKey;
        renderChart();
      });
    }
    for (const b of cmp.querySelectorAll<HTMLButtonElement>('[data-pick]')) {
      b.addEventListener('click', () => {
        const id = b.dataset.pick!;
        compare = compare.includes(id) ? compare.filter((q) => q !== id) : [...compare, id].slice(-3);
        all();
      });
    }
    for (const b of cmp.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
      b.addEventListener('click', () => {
        compare = [...s.presets.find((q) => q.key === b.dataset.preset)!.ids].slice(0, 3);
        all();
      });
    }
    new ResizeObserver(renderChart).observe(box);
    all();
  }
</script>
