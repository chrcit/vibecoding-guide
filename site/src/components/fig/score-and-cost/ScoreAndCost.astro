---
/*
 * Fig. 10, "Score against cost". Chart mode.
 *
 * Idea: each lab sells a family of models at very different prices, and the score a benchmark gives
 * them climbs much more slowly than the price.
 * Elements: price axis (log), score axis, one mark per model (shape and tone per lab), a faint line
 * joining each lab's family, the selected model lit and named.
 * States: one per model; the first is the one passed as `start`.
 * Data: Artificial Analysis Intelligence Index (src/data/benchmarks.ts) and list prices per million
 * output tokens (src/data/models.ts), passed in as props. Nothing is written into the figure.
 * Interaction: Previous and Next step through the models; a click or tap on a point selects it.
 * Alt: what the first frame shows, built from the props.
 */
import Figure from '../Figure.astro';
import { draw } from './draw';
import { describe, order, type ScorePoint } from './model';

interface Props {
  n?: number | string;
  points: ScorePoint[];
  /** Id of the model selected at first. */
  start?: string;
  source: { label: string; href?: string };
}
const { n = 10, source } = Astro.props;
const points = order(Astro.props.points);
const first = Math.max(0, points.findIndex((p) => p.id === Astro.props.start));
const labs = [...new Set(points.map((p) => p.lab))];
const cheap = [...points].sort((a, b) => a.output - b.output)[0]!;
const dear = [...points].sort((a, b) => b.output - a.output)[0]!;
const alt = `A scatter chart of ${points.length} models from ${labs.join(' and ')}: Intelligence Index score up the side, price per million output tokens along the bottom on a log scale, from ${cheap.name} at the cheap end to ${dear.name} at the dear end. ${points[first]!.name} is highlighted.`;
---
<div class="fig-score-cost" data-fig-score-cost data-points={JSON.stringify(points)} data-start={first}>
  <Figure n={n} title="Score against cost" hint="Step through the models, or tap a point, to read its score and price." alt={alt} source={source}>
    <p class="sc-axis sc-axis-y">Intelligence Index score</p>
    <div data-chart set:html={draw(points, 640, first)} />
    <p class="sc-axis sc-axis-x">Price per million output tokens, log scale</p>
    <ul class="sc-key">
      {labs.map((lab, i) => <li><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><g class="sc-point" data-tone={i === 0 ? 'ink' : 'blue'}>{i === 0 ? <circle cx="7" cy="7" r="5" /> : <rect x="2.5" y="2.5" width="9" height="9" rx="1.5" />}</g></svg>{lab}</li>)}
    </ul>
    <Fragment slot="control">
      <button type="button" class="btn ghost" data-prev aria-label="Previous model">Previous</button>
      <button type="button" class="btn" data-next aria-label="Next model">Next model</button>
      <a class="sc-card" data-card href={points[first]!.href}>Open the card for <span data-card-name>{points[first]!.name}</span></a>
    </Fragment>
    <Fragment slot="readout">{describe(points[first]!, points)}</Fragment>
    <Fragment slot="caption">
      A benchmark score says how often a model got a fixed set of test questions right, at one effort setting, in one test harness. It does not say how the model will do on your project, in your harness, with your instructions. Read it as a rough map of a lab's range, then try the models on your own task.
    </Fragment>
  </Figure>
</div>

<style is:global>
  .fig-score-cost .sc-axis { margin: 0; font-family: var(--mono); font-size: 0.875rem; color: var(--muted); }
  .fig-score-cost .sc-axis-x { text-align: right; }
  .fig-score-cost .sc-key { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0.5rem 0 0; padding: 0; list-style: none; font-family: var(--mono); font-size: 0.875rem; color: var(--ink-2); }
  .fig-score-cost .sc-key li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .fig-score-cost .sc-family { fill: none; stroke: var(--fig-faint); stroke-width: 1.5px; stroke-dasharray: 3 4; }
  .fig-score-cost .sc-family[data-tone='blue'] { stroke: color-mix(in oklab, var(--blue) 45%, var(--card)); }
  .fig-score-cost .sc-point circle:not(.sc-hit), .fig-score-cost .sc-point rect { fill: var(--card); stroke: var(--fig-edge); stroke-width: 1.75px; }
  .fig-score-cost .sc-point[data-tone='blue'] circle:not(.sc-hit), .fig-score-cost .sc-point[data-tone='blue'] rect { stroke: var(--blue); fill: color-mix(in oklab, var(--blue) 18%, var(--card)); }
  .fig-score-cost .sc-point[data-on] circle:not(.sc-hit), .fig-score-cost .sc-point[data-on] rect { fill: var(--accent); stroke: var(--accent); }
  .fig-score-cost .sc-hit { fill: transparent; stroke: none; cursor: pointer; }
  .fig-score-cost .sc-name { fill: var(--ink); font-weight: 600; }
  .fig-score-cost .sc-card { font-family: var(--mono); font-size: 0.875rem; color: var(--accent); min-height: 40px; display: inline-flex; align-items: center; }
</style>

<script>
  import { draw } from './draw';
  import { describe, type ScorePoint } from './model';

  for (const root of document.querySelectorAll<HTMLElement>('[data-fig-score-cost]')) {
    const points: ScorePoint[] = JSON.parse(root.dataset.points!);
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const box = q<HTMLElement>('[data-chart]');
    const readout = q<HTMLElement>('[data-fig-readout]');
    const card = q<HTMLAnchorElement>('[data-card]');
    const cardName = q<HTMLElement>('[data-card-name]');
    let at = Number(root.dataset.start ?? 0);
    q<HTMLElement>('[data-fig-control]').hidden = false;

    const render = () => (box.innerHTML = draw(points, Math.round(box.clientWidth), at));
    const select = (i: number) => {
      at = (i + points.length) % points.length;
      render();
      const p = points[at]!;
      readout.textContent = describe(p, points);
      card.href = p.href;
      cardName.textContent = p.name;
    };
    q('[data-prev]').addEventListener('click', () => select(at - 1));
    q('[data-next]').addEventListener('click', () => select(at + 1));
    box.addEventListener('click', (e) => {
      const g = (e.target as Element).closest<SVGGElement>('[data-i]');
      if (g) select(Number(g.dataset.i));
    });
    new ResizeObserver(render).observe(box);
  }
</script>
