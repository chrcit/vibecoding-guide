---
const corners = [
  { k: 'eng', x: 300, y: 30, label: 'Engineering sense', text: 'Enough to know what the agent is doing in code and when it is going in circles.' },
  { k: 'dom', x: 70, y: 250, label: 'Domain knowledge', text: 'The part it can’t replace: knowing whether the result is actually right.' },
  { k: 'agent', x: 530, y: 250, label: 'The agent', text: 'Does the bulk of the building, faster than any team you’ve worked in.' },
];
---
<figure class="widget tri" data-tri>
  <svg viewBox="0 0 600 290" class="chart" role="img" aria-label="Triangle of engineering sense, domain knowledge and the agent">
    <polygon points="300,30 70,250 530,250" />
    <circle cx="300" cy="177" r="8" class="center" />
    <text x="300" y="203" class="mid">the ideal spot</text>
    {corners.map((c) => (
      <g class="corner" data-k={c.k} tabindex="0" role="button" aria-label={c.label}>
        <circle cx={c.x} cy={c.y} r="13" />
        <text x={c.x} y={c.y + (c.y < 100 ? -22 : 34)}>{c.label}</text>
      </g>
    ))}
  </svg>
  {corners.map((c, i) => <p class="say" data-say={c.k} hidden={i !== 0}>{c.text}</p>)}
  <figcaption class="caption">Hover or focus a corner. A scientist with some engineering background can check both the code and the science.</figcaption>
</figure>
<style>
  .chart { width: 100%; height: auto; display: block; }
  polygon { fill: color-mix(in oklab, var(--accent-soft) 60%, transparent); stroke: var(--rule); stroke-width: 1.5; }
  .center { fill: var(--accent); }
  .mid { font-family: var(--mono); font-size: 12px; text-anchor: middle; fill: var(--accent); }
  .corner { cursor: pointer; outline: none; }
  .corner circle { fill: var(--card); stroke: var(--ink); stroke-width: 2; transition: fill 160ms ease; }
  .corner text { font-family: var(--mono); font-size: 13px; text-anchor: middle; fill: var(--ink); }
  .corner:hover circle, .corner:focus-visible circle, .corner.on circle { fill: var(--ink); }
  .say { font-family: var(--serif); font-size: 1.05rem; color: var(--ink-2); margin: 0.4rem 0 0; min-height: 3.2em; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tri]').forEach((root) => {
    const corners = [...root.querySelectorAll<SVGGElement>('.corner')];
    const pick = (g: SVGGElement) => {
      corners.forEach((c) => c.classList.toggle('on', c === g));
      root.querySelectorAll<HTMLElement>('[data-say]').forEach((p) => (p.hidden = p.dataset.say !== g.dataset.k));
    };
    corners.forEach((g) => {
      g.addEventListener('mouseenter', () => pick(g));
      g.addEventListener('focus', () => pick(g));
      g.addEventListener('click', () => pick(g));
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(g); } });
    });
    pick(corners[0]);
  });
</script>
