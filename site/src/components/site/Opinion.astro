---
/*
  The owner's own opinion, visibly labelled as the author's view and dated.
  Use only for opinions the owner has given; the rest of the guide states
  sourced facts.
  Props: date (Date or ISO date string, required), title? (string).
  Slots: default (the opinion, in the owner's words).
*/
interface Props { date: Date | string; title?: string }
const { date, title } = Astro.props;
const d = new Date(date);
const iso = d.toISOString().slice(0, 10);
const text = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<aside class="opinion" aria-label="The author’s opinion">
  <p class="head">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 15.5 13.5 6l1.5-1.5a1.6 1.6 0 0 1 2.3 2.3L15.8 8.3 6.3 17.8 3 18.5Z" />
      <path d="M12.5 7 14 8.5" />
    </svg>
    <span><strong>The author’s view</strong>, <time datetime={iso}>{text}</time></span>
  </p>
  {title && <p class="title">{title}</p>}
  <div class="body"><slot /></div>
</aside>

<style>
  .opinion {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5) var(--space-5);
    background: color-mix(in oklab, var(--accent-soft) 55%, var(--paper));
    border: 1px solid color-mix(in oklab, var(--accent) 28%, var(--rule));
    border-radius: var(--radius);
    color: var(--ink-2);
  }
  .head {
    display: flex; align-items: center; gap: 0.5rem;
    margin: 0 0 var(--space-3);
    font-size: var(--text-s);
    color: var(--muted);
    font-variant-numeric: lining-nums;
  }
  .head svg { color: var(--accent); flex: none; }
  .head strong { color: var(--accent); font-weight: 620; }
  .title { margin: 0 0 var(--space-2); font-size: var(--text-l); font-weight: 560; color: var(--ink); line-height: 1.3; }
  .body { font-style: italic; font-size: var(--text-body); line-height: 1.58; }
  .body :global(p) { margin: 0 0 0.7em; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .body :global(em) { font-style: normal; }
</style>
