---
/*
  The site header: brand, main nav, the source links (Sources, the code on GitHub), reader-level
  picker, theme toggle and an optional reading-progress bar. Sticky. There is no site footer: what
  it held lives here, so pages end on their content.
  Props: section? (SectionId, marks the current nav item), progress? (boolean).
  Nav items come from `sections.filter(s => s.ready)` in lib/nav.ts. With up
  to three items the nav sits inline from tablet width; with more it collapses
  into a menu button below 72rem. The menu is a disclosure (button with
  aria-expanded), closes on Escape, outside click and link click. Without
  JavaScript the nav shows as a second row instead.
*/
import { sections, url, type SectionId } from '../../lib/nav';
import LevelPicker from '../level/LevelPicker.astro';
interface Props { section?: SectionId; progress?: boolean }
const { section, progress = false } = Astro.props;
const items = sections.filter((s) => s.ready);
const many = items.length > 4;
const hasSources = Object.keys(import.meta.glob('../../pages/sources/index.astro')).length > 0;
const repo = 'https://github.com/chrcit/vibecoding-guide';
---
<header class="topbar" data-topbar data-many={many ? '' : undefined}>
  <div class="bar">
    <a class="brand" href={url('')}>
      <svg class="mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
        <rect width="32" height="32" rx="8" class="mark-bg" />
        <path d="M9 21.5 16 9l7 12.5" fill="none" class="mark-line" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="16" cy="21.5" r="2.4" class="mark-dot" />
      </svg>
      <span>Agentic Coding<span class="brand-tail"> Guide</span></span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {items.map((s) => (
          <li><a href={url(s.path)} aria-current={s.id === section ? 'page' : undefined}>{s.label}</a></li>
        ))}
        {hasSources && <li class="aux aux-first"><a href={url('sources/')}>Sources</a></li>}
        <li class={hasSources ? 'aux' : 'aux aux-first'}>
          <a class="gh" href={repo} title="The guide's source on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            <span class="gh-text">Source on GitHub</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="tools">
      <div class="level-slot"><LevelPicker /></div>
      <button class="icon-btn theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
        <span class="visually-hidden">Dark theme</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path class="half" d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor" />
        </svg>
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path class="l1" d="M4 8h16" />
          <path class="l2" d="M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
  {progress && <div class="progress" data-progress aria-hidden="true"><span></span></div>}
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-topbar]');

  // Theme toggle: aria-pressed mirrors whether the page is dark right now.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches);
  const sync = () => toggle?.setAttribute('aria-pressed', String(isDark()));
  sync();
  systemDark.addEventListener('change', sync);
  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    sync();
  });

  // Menu disclosure for small screens.
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.getElementById('site-nav');
  const setOpen = (open: boolean, focusButton = false) => {
    if (!header || !btn) return;
    btn.setAttribute('aria-expanded', String(open));
    header.toggleAttribute('data-open', open);
    if (!open && focusButton) btn.focus();
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-open')) setOpen(false, true);
  });
  document.addEventListener('click', (e) => {
    if (header?.hasAttribute('data-open') && !header.contains(e.target as Node)) setOpen(false);
  });
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  // Leaving the menu with Tab closes it, so it never hangs open over the page.
  nav?.addEventListener('focusout', (e) => {
    const to = e.relatedTarget as Node | null;
    if (to && !nav.contains(to) && to !== btn && header?.hasAttribute('data-open')) setOpen(false);
  });
  addEventListener('resize', () => {
    if (btn && getComputedStyle(btn).display === 'none') setOpen(false);
  });

  // Reading progress, drawn with a transform so it never triggers layout.
  const bar = document.querySelector<HTMLElement>('[data-progress] span');
  if (bar) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = root.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex; align-items: center; gap: var(--space-4);
    max-width: var(--full); margin-inline: auto;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    margin-right: auto;
    min-height: 2.75rem;
    font-size: 1.1875rem; font-weight: 600; letter-spacing: -0.012em; line-height: 1;
    text-decoration: none; white-space: nowrap; color: var(--ink);
    font-variation-settings: 'opsz' 24;
  }
  .brand:hover { color: var(--ink); }
  .mark { flex: none; display: block; }
  .mark-bg { fill: var(--ink); }
  .mark-line { stroke: var(--paper); }
  .mark-dot { fill: var(--accent); }
  @media (max-width: 23.5rem) { .brand-tail { display: none; } }

  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-1); }
  .nav a {
    position: relative;
    display: flex; align-items: center;
    min-height: 2.75rem; padding: 0 0.7rem;
    font-size: var(--text-m); font-weight: 450; color: var(--ink-2);
    text-decoration: none; white-space: nowrap;
    border-radius: var(--radius-s);
  }
  .nav a:hover { color: var(--ink); background: color-mix(in oklab, var(--ink) 5%, transparent); }
  .nav a[aria-current='page'] { color: var(--ink); font-weight: 560; }
  .nav a[aria-current='page']::after {
    content: ''; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0.45rem;
    height: 2px; border-radius: 2px; background: var(--accent);
  }

  .tools { display: flex; align-items: center; gap: var(--space-2); }
  .level-slot:empty { display: none; }
  .icon-btn {
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem;
    border: 1px solid transparent; border-radius: var(--radius-pill);
    background: transparent; color: var(--ink-2);
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .icon-btn:hover { color: var(--ink); background: color-mix(in oklab, var(--ink) 6%, transparent); }
  .icon-btn:active { transform: scale(0.94); }
  .theme-toggle .half { transform-origin: 12px 12px; transition: transform 420ms var(--ease-out); }
  .theme-toggle[aria-pressed='true'] .half { transform: rotate(180deg); }
  .menu-btn path { transform-origin: 12px 12px; transition: transform var(--dur) var(--ease-out); }
  .menu-btn[aria-expanded='true'] .l1 { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .l2 { transform: translateY(-4px) rotate(-45deg); }

  /* Narrow: nav collapses behind the menu button (JS) or wraps to a row (no JS). */
  .menu-btn { display: none; }
  :global(html.js) .menu-btn { display: grid; }
  :global(html.js) .nav { display: none; }
  :global(html:not(.js)) .bar { flex-wrap: wrap; }
  :global(html:not(.js)) .nav { order: 3; width: 100%; overflow-x: auto; }

  .topbar[data-open] .nav {
    display: block;
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    box-shadow: var(--shadow-pop);
    padding: var(--space-2) var(--gutter) var(--space-4);
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    animation: menu-in var(--dur) var(--ease-out);
  }
  .topbar[data-open] .nav ul { flex-direction: column; gap: 0; max-width: var(--full); margin-inline: auto; }
  .topbar[data-open] .nav a { min-height: 3rem; font-size: var(--text-l); padding: 0 var(--space-2); border-bottom: 1px solid var(--rule); border-radius: 0; }
  .topbar[data-open] .nav li:last-child a { border-bottom: 0; }
  .topbar[data-open] .nav a[aria-current='page']::after { left: auto; right: var(--space-2); bottom: auto; top: 50%; width: 0.5rem; height: 0.5rem; border-radius: 50%; margin-top: -0.25rem; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }

  /* Few sections: inline once the sections, the source links and the tools fit in one row. */
  @media (min-width: 64rem) {
    .topbar:not([data-many]) .menu-btn { display: none; }
    .topbar:not([data-many]) .nav { display: block; position: static; animation: none; box-shadow: none; border: 0; padding: 0; background: none; }
    .topbar:not([data-many]) .nav ul { flex-direction: row; }
    .topbar:not([data-many]) .nav a { min-height: 2.75rem; font-size: var(--text-m); border-bottom: 0; padding: 0 0.7rem; }
    .topbar:not([data-many]) .nav a[aria-current='page']::after { left: 0.7rem; right: 0.7rem; top: auto; bottom: 0.45rem; width: auto; height: 2px; margin: 0; border-radius: 2px; }
  }
  /* Up to eight sections: inline from laptop width. */
  @media (min-width: 72rem) {
    .topbar[data-many] .menu-btn { display: none; }
    .topbar[data-many] .nav { display: block; position: static; animation: none; box-shadow: none; border: 0; padding: 0; background: none; }
    .topbar[data-many] .nav ul { flex-direction: row; }
    .topbar[data-many] .nav a { min-height: 2.75rem; font-size: var(--text-m); border-bottom: 0; padding: 0 0.6rem; }
    .topbar[data-many] .nav a[aria-current='page']::after { left: 0.6rem; right: 0.6rem; top: auto; bottom: 0.45rem; width: auto; height: 2px; margin: 0; border-radius: 2px; }
  }

  /* The source links: after the sections, set apart by a thin rule; GitHub as an icon inline,
     with its words in the menu. */
  .nav .aux a { color: var(--muted); }
  .nav .aux a:hover { color: var(--ink); }
  .gh { gap: 0.5rem; }
  .gh svg { flex: none; }
  .topbar[data-open] .nav .aux-first { margin-top: var(--space-2); border-top: 1px solid var(--rule); }
  @media (min-width: 64rem) {
    .topbar:not([data-many]) .nav ul { align-items: center; }
    .topbar:not([data-many]) .nav .aux-first { margin-left: var(--space-2); padding-left: var(--space-2); border-left: 1px solid var(--rule); }
    .topbar:not([data-many]) .nav .gh-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (min-width: 72rem) {
    .topbar[data-many] .nav ul { align-items: center; }
    .topbar[data-many] .nav .aux-first { margin-left: var(--space-2); padding-left: var(--space-2); border-left: 1px solid var(--rule); }
    .topbar[data-many] .nav .gh-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }

  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; pointer-events: none; }
  .progress span {
    display: block; height: 100%; background: var(--accent);
    transform: scaleX(0); transform-origin: 0 50%;
  }
</style>
