---
/*
  The top of a page: the one <h1>, an optional lede and an optional
  "Updated" date.
  Props: title (string), updated? (Date or ISO date string).
  Slots: default (the lede; one or two sentences, set larger than body text).
*/
interface Props { title: string; updated?: Date | string }
const { title, updated } = Astro.props;
const date = updated ? new Date(updated) : undefined;
const iso = date && !isNaN(+date) ? date.toISOString().slice(0, 10) : undefined;
const text = iso ? date!.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : undefined;
const hasLede = Astro.slots.has('default');
---
<header class="page-header">
  <h1>{title}</h1>
  {hasLede && <div class="lede"><slot /></div>}
  {iso && <p class="updated">Updated <time datetime={iso}>{text}</time></p>}
</header>

<style>
  .page-header { margin: 0 0 var(--space-7); max-width: var(--measure); }
  h1 {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 480;
    line-height: 1.04;
    letter-spacing: -0.024em;
    color: var(--ink);
  }
  .lede {
    margin-top: var(--space-5);
    font-size: var(--text-l);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .lede :global(p) { margin: 0 0 0.6em; }
  .lede :global(p:last-child) { margin-bottom: 0; }
  .updated {
    margin: var(--space-5) 0 0;
    font-size: var(--text-s);
    color: var(--muted);
    font-variant-numeric: lining-nums;
  }
</style>
