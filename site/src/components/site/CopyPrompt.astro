---
/*
  A prompt the reader can copy into their agent.
  Props: title (string, what the prompt is for), id? (string, an anchor so
  the prompt can be linked to), compact? (boolean: for a board tile, which
  already carries the title; the title is kept for screen readers only and
  the copy button sits under the text).
  Slots: default (the prompt text, plain; line breaks are kept).

  The copy button writes the plain text to the clipboard and announces
  "Copied" through an aria-live region. Where the clipboard API is missing or
  refused, it selects the text and says how to copy it by hand. The text is
  always selectable.
*/
interface Props { title: string; id?: string; compact?: boolean }
const { title, id, compact = false } = Astro.props;
const uid = id ?? 'prompt-' + Math.random().toString(36).slice(2, 9);
---
<figure class="copy-prompt" id={id} data-copy-prompt data-compact={compact ? '' : undefined}>
  <figcaption>
    <span class="title" id={`${uid}-title`}>{title}</span>
    <button type="button" class="copy" data-copy aria-describedby={`${uid}-title`}>
      <svg class="i-copy" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.5" /></svg>
      <svg class="i-done" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 6.5 12 13 4.5" /></svg>
      <span class="label">Copy</span>
    </button>
  </figcaption>
  <pre class="text" tabindex="0" aria-labelledby={`${uid}-title`}><slot /></pre>
  <p class="status" role="status" aria-live="polite" data-status></p>
</figure>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-copy-prompt]')) {
    const btn = box.querySelector<HTMLButtonElement>('[data-copy]');
    const text = box.querySelector<HTMLElement>('.text');
    const status = box.querySelector<HTMLElement>('[data-status]');
    const label = btn?.querySelector<HTMLElement>('.label');
    let timer = 0;
    const say = (msg: string, ok: boolean) => {
      if (!status || !btn || !label) return;
      status.textContent = '';
      // Clear first so a repeat press is announced again.
      requestAnimationFrame(() => { status.textContent = msg; });
      btn.toggleAttribute('data-done', ok);
      label.textContent = ok ? 'Copied' : 'Copy';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.removeAttribute('data-done');
        label.textContent = 'Copy';
        status.textContent = '';
      }, 2400);
    };
    const selectText = () => {
      if (!text) return;
      const range = document.createRange();
      range.selectNodeContents(text);
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      text.focus();
    };
    btn?.addEventListener('click', async () => {
      if (!text) return;
      const plain = text.innerText.replace(/\s+$/, '');
      try {
        if (!navigator.clipboard?.writeText) throw new Error('no clipboard');
        // Some browsers leave the promise pending (unfocused window, no
        // permission); fall back to selecting the text after a moment.
        await Promise.race([
          navigator.clipboard.writeText(plain),
          new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 1500)),
        ]);
        say('Copied', true);
      } catch {
        selectText();
        const mac = /Mac|iPhone|iPad/.test(navigator.platform);
        say(`Selected. Press ${mac ? 'Command' : 'Control'} and C to copy.`, false);
      }
    });
  }
</script>

<style>
  .copy-prompt {
    margin: var(--space-6) 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--card);
    overflow: hidden;
  }
  figcaption {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }
  .title { font-weight: 600; color: var(--ink); font-size: var(--text-m); line-height: 1.3; }
  .copy {
    flex: none;
    display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: 2.5rem; padding: 0 0.95rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-pill);
    background: var(--paper); color: var(--ink);
    font-family: var(--mono); font-size: var(--text-s);
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }
  .copy:hover { border-color: var(--ink); }
  .copy:active { transform: scale(0.97); }
  .copy .i-done { display: none; color: var(--green); }
  .copy[data-done] { border-color: var(--green); }
  .copy[data-done] .i-copy { display: none; }
  .copy[data-done] .i-done { display: block; animation: pop var(--dur) var(--ease-out); }
  @keyframes pop { from { transform: scale(0.6); opacity: 0; } }
  .text {
    margin: 0;
    border: 0; border-radius: 0;
    background: var(--card) !important;
    padding: var(--space-4) var(--space-5) var(--space-5);
    font-size: var(--text-s);
    line-height: 1.65;
    color: var(--ink-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 28rem;
    overflow-y: auto;
    user-select: text;
  }
  .text:focus-visible { outline-offset: -3px; }
  .status { margin: 0; padding: 0 var(--space-5); color: var(--muted); font-size: var(--text-s); }
  .status:not(:empty) { padding-bottom: var(--space-3); }

  .copy-prompt[data-compact] { display: flex; flex-direction: column; margin: 0; border-radius: var(--radius); background: var(--paper); }
  .copy-prompt[data-compact] figcaption { order: 2; justify-content: flex-end; border: 0; padding: 0 var(--space-2) var(--space-2); }
  .copy-prompt[data-compact] .title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .copy-prompt[data-compact] .text { background: var(--paper) !important; padding: 0.75rem 0.875rem 0.25rem; max-height: 22rem; color: var(--ink); }
  .copy-prompt[data-compact] .copy { background: var(--card); }
  .copy-prompt[data-compact] .status { order: 3; padding: 0 0.875rem; }
  .copy-prompt[data-compact] .status:not(:empty) { padding-bottom: var(--space-2); }
</style>
