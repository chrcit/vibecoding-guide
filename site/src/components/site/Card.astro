---
/*
  A link card for index pages. Renders an <li>: use it inside <CardGrid>.
  Set like an entry in a book's contents: a rule above, the title, and only
  what helps choose. Most cards need no description.
  Props: href (string; internal paths go through url()), title (string),
  meta? (string, short data such as "12 min" or "Updated 18 Nov").
  Slots: default (optional one-line description; leave empty when the title
  says enough).
*/
import { url } from '../../lib/nav';
interface Props { href: string; title: string; meta?: string }
const { href, title, meta } = Astro.props;
const link = /^(https?:|mailto:|#)/.test(href) ? href : url(href);
const hasBody = Astro.slots.has('default');
---
<li class="card">
  <a href={link}>
    <span class="row">
      <span class="title">{title}</span>
      <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
    </span>
    {hasBody && <span class="desc"><slot /></span>}
    {meta && <span class="meta">{meta}</span>}
  </a>
</li>

<style>
  .card { border-top: 1px solid var(--rule); }
  a {
    display: flex; flex-direction: column; gap: 0.3rem;
    height: 100%;
    padding: var(--space-4) 0 var(--space-5);
    text-decoration: none;
    color: var(--ink);
  }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .title {
    font-size: var(--text-l);
    font-weight: 520;
    line-height: 1.25;
    letter-spacing: -0.008em;
    text-wrap: balance;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast) ease;
  }
  .arrow {
    flex: none; align-self: center;
    color: var(--muted);
    opacity: 0.6;
    transition: transform var(--dur) var(--ease-out), color var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }
  .desc { color: var(--ink-2); font-size: var(--text-m); line-height: 1.5; }
  .meta { color: var(--muted); font-size: var(--text-s); font-variant-numeric: lining-nums; }
  a:hover { color: var(--ink); }
  a:hover .title { text-decoration-color: var(--accent); }
  a:hover .arrow { transform: translateX(4px); color: var(--accent); opacity: 1; }
  a:focus-visible { outline-offset: 4px; }
</style>
