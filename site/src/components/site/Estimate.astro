---
/*
  A practitioner's estimate: one named person's dated figure, kept apart from
  the sourced facts. Never use it for a number the guide states as fact.
  Props: name (string, who said it), href (string, where they said it),
  date (Date or ISO date string, when they said it).
  Slots: default (the estimate, paraphrased or briefly quoted).
*/
interface Props { name: string; href: string; date: Date | string }
const { name, href, date } = Astro.props;
const d = new Date(date);
const iso = d.toISOString().slice(0, 10);
const text = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<aside class="estimate" aria-label={`Estimate by ${name}`}>
  <p class="head">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M4 8c2-2 4-2 6 0s4 2 6 0" />
      <path d="M4 13c2-2 4-2 6 0s4 2 6 0" />
    </svg>
    <span>Estimate by <a href={href}>{name}</a>, <time datetime={iso}>{text}</time></span>
  </p>
  <div class="body"><slot /></div>
  <p class="caveat">One person’s figure at one point in time. It is not a sourced fact.</p>
</aside>

<style>
  .estimate {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
    color: var(--ink-2);
  }
  .head {
    display: flex; align-items: center; gap: 0.5rem;
    margin: 0 0 var(--space-3);
    font-size: var(--text-s);
    color: var(--muted);
    font-variant-numeric: lining-nums;
  }
  .head svg { color: var(--blue); flex: none; }
  .head a { color: var(--ink); font-weight: 600; }
  .body { font-size: var(--text-body); line-height: 1.58; }
  .body :global(p) { margin: 0 0 0.7em; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .caveat {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--rule);
    font-size: var(--text-s);
    color: var(--muted);
  }
</style>
