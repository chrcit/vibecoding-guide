---
// Illustrative quality curves for three ways of finishing a design task.
const modes = {
  none: { label: 'Ship the first attempt', pts: [0.52], note: 'Looks done. Has a squished header, a fake map and a broken scroll. Nobody looked.' },
  loop: { label: 'Agent checks itself in a loop', pts: [0.52, 0.66, 0.74, 0.79, 0.82, 0.84, 0.845], note: 'It opens its browser, sees the problems, fixes them, looks again. It gets to correct and decent, then levels off below the taste line.' },
  you: { label: 'Loop + your eye', pts: [0.52, 0.66, 0.74, 0.79, 0.82, 0.84, 0.845, 0.91, 0.95], note: 'You add what it can’t judge: “I don’t like the background. Use a real globe.” That’s what gets it past “decent”.' },
};
---
<figure class="widget vl" data-vl data-modes={JSON.stringify(modes)}>
  <div class="seg" role="group" aria-label="Verification">
    {Object.entries(modes).map(([k, m], i) => <button type="button" data-m={k} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>)}
  </div>
  <svg viewBox="0 0 600 240" class="chart" data-chart role="img" aria-label="Quality over iterations">
    <line x1="40" x2="590" y1="45" y2="45" class="taste" />
    <text x="590" y="38" text-anchor="end" class="lbl">taste line: what the model can judge on its own</text>
    <line x1="40" x2="40" y1="10" y2="215" class="ax" />
    <line x1="40" x2="590" y1="215" y2="215" class="ax" />
    <text x="40" y="234" class="lbl">attempt 1</text>
    <text x="590" y="234" text-anchor="end" class="lbl">attempt 9</text>
    <text x="34" y="20" text-anchor="end" class="lbl">good</text>
    <polyline data-line fill="none" />
    <g data-dots></g>
  </svg>
  <p class="note" data-note aria-live="polite"></p>
  <figcaption class="caption">Illustration of a design task. On technical work with a checkable answer (tests, five runs, a benchmark) the loop can go much further on its own.</figcaption>
</figure>
<style>
  .chart { width: 100%; height: auto; display: block; margin: 0.8rem 0 0.4rem; }
  .taste { stroke: var(--blue); stroke-dasharray: 4 4; stroke-width: 1.5; }
  .ax { stroke: var(--rule); }
  .lbl { fill: var(--muted); font-size: 11px; font-family: var(--mono); }
  [data-line] { stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .note { font-family: var(--serif); font-size: 1.05rem; color: var(--ink-2); margin: 0.4rem 0 0; min-height: 3.2em; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-vl]').forEach((root) => {
    const modes = JSON.parse(root.dataset.modes!) as Record<string, { pts: number[]; note: string }>;
    const line = root.querySelector('[data-line]') as SVGPolylineElement;
    const dots = root.querySelector('[data-dots]') as SVGGElement;
    const X = (i: number) => 40 + (i / 8) * 550;
    const Y = (q: number) => 215 - q * 200;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const draw = (k: string) => {
      const m = modes[k];
      line.setAttribute('points', m.pts.map((q, i) => `${X(i)},${Y(q)}`).join(' '));
      const len = line.getTotalLength?.() || 0;
      if (!reduce && len) line.animate([{ strokeDasharray: `${len}`, strokeDashoffset: len }, { strokeDasharray: `${len}`, strokeDashoffset: 0 }], { duration: 700, easing: 'cubic-bezier(.2,.8,.2,1)' });
      dots.replaceChildren(
        ...m.pts.map((q, i) => {
          const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          c.setAttribute('cx', String(X(i))); c.setAttribute('cy', String(Y(q))); c.setAttribute('r', '4.5');
          c.setAttribute('fill', i >= 7 ? 'var(--ink)' : 'var(--accent)');
          return c;
        }),
      );
      root.querySelector('[data-note]')!.textContent = m.note;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-m]').forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-m]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        draw(b.dataset.m!);
      }),
    );
    draw('none');
  });
</script>
