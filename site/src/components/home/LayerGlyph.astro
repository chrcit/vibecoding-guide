---
// Six stacked slabs with one picked out: where this layer sits in the stack. Decorative; the text
// beside it says the same thing.
interface Props { n?: number; size?: number }
const { n = 0, size = 18 } = Astro.props;
---
<svg class="layer-glyph" viewBox="0 0 18 18" width={size} height={size} aria-hidden="true" focusable="false">
  {[0, 1, 2, 3, 4, 5].map((i) => (
    <rect x="1.5" y={1.25 + i * 2.75} width="15" height="1.9" rx="0.9" class={i + 1 === n ? 'on' : undefined} />
  ))}
</svg>

<style>
  .layer-glyph { flex: none; }
  rect { fill: var(--rule-strong); }
  rect.on { fill: var(--accent); }
</style>
