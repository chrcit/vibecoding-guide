---
/*
  One of the six layers on the home page.
  Props: n (1 to 6), id (anchor), name (the layer's name), title (the section heading),
  links ({ href, title }[], where to go deeper; internal hrefs go through url()).
  Slots: default (the plain explanation and its deeper blocks), right (the one thing to get
  right, a sentence or two), figure (optional, shown wide after the plain text). Every layer can
  take one figure; the lead adds the explainers' figures here after merging.
*/
import { url } from '../../lib/nav';
import LayerGlyph from './LayerGlyph.astro';

interface Props { n: number; id: string; name: string; title: string; links: { href: string; title: string }[] }
const { n, id, name, title, links } = Astro.props;
const to = (href: string) => (/^(https?:|#)/.test(href) ? href : url(href));
---
<section class="layer" id={id} aria-labelledby={`${id}-title`}>
  <div class="layer-text">
    <p class="layer-mark"><LayerGlyph n={n} /><span>Layer {n} of 6 · {name}</span></p>
    <h2 id={`${id}-title`}>{title}</h2>
    <div class="prose"><slot /></div>
  </div>
  {Astro.slots.has('figure') && <div class="layer-figure"><slot name="figure" /></div>}
  <div class="layer-text">
    <aside class="layer-right" aria-labelledby={`${id}-right`}>
      <h3 id={`${id}-right`}>The one thing to get right</h3>
      <div class="prose"><slot name="right" /></div>
    </aside>
    <nav class="layer-links" aria-label={`Go deeper: ${name}`}>
      <span class="layer-links-head">Go deeper</span>
      <ul>
        {links.map((l) => (
          <li><a href={to(l.href)}>{l.title}<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></a></li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .layer { padding: var(--space-8) 0 0; scroll-margin-top: var(--header-h); }
  .layer-text { max-width: var(--measure); margin-inline: auto; }
  .layer-mark {
    display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-3);
    font-family: var(--mono); font-size: var(--text-s); color: var(--muted); font-variant-numeric: lining-nums;
  }
  h2 {
    margin: 0 0 var(--space-5); font-size: var(--text-2xl); font-weight: 500;
    line-height: var(--leading-tight); letter-spacing: -0.014em;
  }
  .layer-figure { max-width: 60rem; margin: 0 auto; }
  .layer-figure :global(.fig) { margin: var(--space-6) 0; }
  .layer-right {
    margin: var(--space-5) 0 0; padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--accent); background: var(--card); border-radius: 0 var(--radius) var(--radius) 0;
  }
  .layer-right h3 { margin: 0 0 var(--space-2); font-size: var(--text-m); font-weight: 600; color: var(--ink); }
  .layer-right .prose { font-size: var(--text-m); }
  .layer-right .prose :global(p) { margin: 0 0 0.6em; }
  .layer-right .prose :global(p:last-child) { margin-bottom: 0; }
  .layer-links { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); margin: var(--space-5) 0 0; }
  .layer-links-head { font-family: var(--mono); font-size: var(--text-s); color: var(--muted); }
  .layer-links ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); list-style: none; margin: 0; padding: 0; }
  .layer-links a {
    display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.5rem;
    font-size: var(--text-m); text-decoration-color: color-mix(in oklab, var(--accent) 60%, transparent);
  }
  .layer-links svg { transition: transform var(--dur) var(--ease-out); }
  .layer-links a:hover svg { transform: translateX(3px); }
</style>
