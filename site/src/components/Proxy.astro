---
---
<figure class="widget px" data-px data-mode="relay">
  <div class="seg" role="group" aria-label="Who talks to the agent">
    <button type="button" data-set="relay" aria-pressed="true">You as the relay</button>
    <button type="button" data-set="direct" aria-pressed="false">Direct access</button>
  </div>
  <svg viewBox="0 0 600 170" class="chart" role="img" aria-label="Flow between a colleague, you and the agent">
    <g class="n"><rect x="10" y="60" width="130" height="50" rx="10" /><text x="75" y="90">colleague</text></g>
    <g class="n you"><rect x="235" y="60" width="130" height="50" rx="10" /><text x="300" y="90">you</text></g>
    <g class="n"><rect x="460" y="60" width="130" height="50" rx="10" /><text x="525" y="90">agent</text></g>
    <g class="relay">
      <path d="M140 78 H235" /><path d="M365 78 H460" />
      <path class="back" d="M460 96 H365" /><path class="back" d="M235 96 H140" />
      <text x="187" y="66">voice note</text><text x="412" y="66">paste</text>
    </g>
    <g class="direct">
      <path d="M75 60 C75 10 525 10 525 60" /><path class="back" d="M525 110 C525 160 75 160 75 110" />
      <text x="300" y="24">talks to it directly, same fast loop</text>
      <path class="review" d="M300 110 V140" /><text x="300" y="160">you review what matters</text>
    </g>
  </svg>
  <p class="say" data-say="relay">You get a voice note, transcribe it, paste it into a thread, check the result, send it back. It works, but you’re a <em>meat proxy</em>: a human relay between the person with the need and the AI.</p>
  <p class="say" data-say="direct" hidden>Give them the same setup. It saves you little time, but it makes them far more capable, because the iteration loop is now theirs.</p>
</figure>
<style>
  .chart { width: 100%; height: auto; display: block; margin: 1rem 0 0.4rem; }
  .n rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
  .n text { font-family: var(--mono); font-size: 13px; text-anchor: middle; fill: var(--ink); }
  .n.you rect { transition: opacity 300ms; }
  path { fill: none; stroke: var(--accent); stroke-width: 2; marker-end: none; }
  .back { stroke: var(--green); stroke-dasharray: 5 4; }
  .review { stroke: var(--muted); stroke-dasharray: 2 4; }
  g text { font-family: var(--mono); font-size: 11px; text-anchor: middle; fill: var(--muted); }
  .relay, .direct { transition: opacity 300ms ease; }
  [data-mode='relay'] .direct, [data-mode='direct'] .relay { opacity: 0; }
  [data-mode='direct'] .n.you rect { stroke: var(--muted); stroke-dasharray: 4 4; }
  .say { font-family: var(--serif); font-size: 1.05rem; color: var(--ink-2); margin: 0.4rem 0 0; min-height: 4.8em; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-px]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) =>
      b.addEventListener('click', () => {
        const m = b.dataset.set!;
        root.dataset.mode = m;
        root.querySelectorAll('[data-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        root.querySelectorAll<HTMLElement>('[data-say]').forEach((p) => (p.hidden = p.dataset.say !== m));
      }),
    );
  });
</script>
