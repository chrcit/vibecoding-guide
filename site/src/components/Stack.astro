---
const layers = [
  { key: 'ade', name: 'ADE', sub: 'agentic development environment', eg: 'T3 Code', text: 'A layer above the harnesses. Shows the work as threads and projects, runs many agents at once, mixes providers, gives you a browser, files and terminal, and can run on a server while your laptop sleeps.' },
  { key: 'harness', name: 'Harness', sub: 'gives the model hands', eg: 'Claude Code · Codex · Cursor · OpenCode', text: 'The program that lets a model read files, edit code, run commands and use a browser. Each provider ships its own, and each one only runs that provider’s models.' },
  { key: 'model', name: 'Model', sub: 'the AI itself', eg: 'Claude Opus · Claude Fable · GPT', text: 'Reads text, writes text. Everything above exists to turn that into work on your computer.' },
];
---
<figure class="widget stack" data-stack>
  <div class="layers" role="tablist" aria-label="Layers">
    {layers.map((l, i) => (
      <button type="button" role="tab" class="layer" data-k={l.key} aria-selected={i === 0 ? 'true' : 'false'} style={`--n:${i}`}>
        <span class="nm">{l.name}</span><span class="sb">{l.sub}</span><span class="eg">{l.eg}</span>
      </button>
    ))}
  </div>
  {layers.map((l, i) => <p class="txt" data-txt={l.key} hidden={i !== 0}>{l.text}</p>)}
  <figcaption class="caption">Pick a layer. T3 Code doesn’t replace Claude Code or Codex. It drives them.</figcaption>
</figure>
<style>
  .layers { display: grid; gap: 6px; perspective: 900px; }
  .layer {
    display: grid; grid-template-columns: minmax(0, 12rem) 1fr; grid-template-areas: 'nm eg' 'sb eg'; align-items: center; column-gap: 1rem;
    text-align: left; cursor: pointer; border: 1px solid var(--rule); border-radius: 10px; padding: 0.7rem 0.9rem;
    background: var(--paper); margin-inline: calc(var(--n) * 4%);
    transition: background-color 160ms ease, border-color 160ms ease, transform 200ms ease;
  }
  .layer[aria-selected='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); transform: translateY(-1px); }
  .nm { grid-area: nm; font-weight: 600; font-size: 0.9rem; }
  .sb { grid-area: sb; font-size: 0.68rem; opacity: 0.7; }
  .eg { grid-area: eg; text-align: right; font-size: 0.72rem; opacity: 0.85; }
  @media (max-width: 34rem) { .layer { grid-template-columns: 1fr; grid-template-areas: 'nm' 'sb' 'eg'; margin-inline: 0; } .eg { text-align: left; margin-top: 0.3rem; } }
  .txt { font-family: var(--serif); font-size: 1.05rem; color: var(--ink-2); margin: 1rem 0 0; min-height: 4.8em; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-k]')];
    const pick = (b: HTMLButtonElement) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === b)));
      root.querySelectorAll<HTMLElement>('[data-txt]').forEach((p) => (p.hidden = p.dataset.txt !== b.dataset.k));
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => pick(b));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = tabs[(i + d + tabs.length) % tabs.length];
        n.focus(); pick(n);
      });
    });
  });
</script>
