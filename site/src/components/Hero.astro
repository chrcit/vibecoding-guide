---
import { url } from '../lib/nav';
const lanes = [
  { name: 'portfolio-site', steps: ['read screenshot', 'draft 3 variants', 'open browser', 'fix header', 'loop'] },
  { name: 'research-notebook', steps: ['plan analysis', 'synthetic data', 'run 5 times', 'compare', 'report'] },
  { name: 'orchestrator', steps: ['split work', 'start subagents', 'second opinion', 'merge', 'dashboard'] },
];
---
<header class="hero">
  <h1>You describe the outcome. <em>Agents do the work.</em> Your job is to check it.</h1>
  <p class="lede">
    A visual essay on how software gets built now, for people who are new to this and for experienced engineers and scientists who haven't kept up.
    About 20 minutes. Every section opens a door into the <a href={url('guide/')}>reference</a>.
  </p>
  <div class="threads" aria-label="Illustration: three agent threads working in parallel" role="img">
    {lanes.map((l, i) => (
      <div class="lane" style={`--d:${i * 1.3}s`}>
        <span class="name">{l.name}</span>
        <div class="track">
          {l.steps.map((s, j) => <span class="step" style={`--j:${j}`}>{s}</span>)}
        </div>
      </div>
    ))}
    <div class="you"><span class="dot"></span> you: reading results, 2 min at a time</div>
  </div>
</header>
<style>
  .hero { max-width: 60rem; margin: 0 auto; padding: clamp(3rem, 10vw, 7rem) var(--gutter) 2rem; }
  h1 { font-size: clamp(2.5rem, 7.5vw, 5rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 500; margin: 0 0 1.5rem; text-wrap: balance; }
  h1 em { font-style: italic; color: var(--accent); }
  .lede { font-size: 1.3rem; color: var(--ink-2); max-width: var(--measure); margin: 0 0 3rem; text-wrap: pretty; }
  .threads { border: 1px solid var(--rule); border-radius: 16px; background: var(--card); padding: 1rem; box-shadow: var(--shadow); font-family: var(--mono); font-size: 0.72rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.7rem; }
  .lane { display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); gap: 0.75rem; align-items: center; }
  @media (max-width: 40rem) { .lane { grid-template-columns: minmax(0, 1fr); gap: 0.35rem; } }
  .name { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .track { display: flex; gap: 0.35rem; overflow: hidden; }
  .step {
    flex: 0 0 auto; padding: 0.25rem 0.55rem; border-radius: 999px; border: 1px solid var(--rule); color: var(--muted); white-space: nowrap;
    animation: tick 10s calc(var(--d) + var(--j) * 1.6s) infinite both;
  }
  @keyframes tick {
    0%, 4% { background: transparent; color: var(--muted); border-color: var(--rule); }
    8%, 70% { background: var(--green-soft); color: var(--green); border-color: transparent; }
    100% { background: var(--green-soft); color: var(--green); border-color: transparent; }
  }
  .you { display: flex; align-items: center; gap: 0.5rem; color: var(--accent); border-top: 1px dashed var(--rule); padding-top: 0.7rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) { .step { animation: none; background: var(--green-soft); color: var(--green); border-color: transparent; } .dot { animation: none; } }
</style>
