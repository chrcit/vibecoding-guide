---
// One person supervising N agent threads for three hours. A small discrete-event
// simulation: each thread needs you for a prompt, runs on its own, then waits
// for you to review the result and send the next prompt. You serve them in the
// order they finish.
---
<figure class="widget att" data-att>
  <div class="fields">
    <label class="field"><span>Threads in parallel</span><output data-o="n"></output><input type="range" min="1" max="10" step="1" value="1" data-i="n" /></label>
    <label class="field"><span>Length of one run</span><output data-o="run"></output><input type="range" min="5" max="60" step="5" value="20" data-i="run" /></label>
    <label class="field"><span>Your review per result</span><output data-o="look"></output><input type="range" min="1" max="15" step="1" value="4" data-i="look" /></label>
  </div>
  <svg data-chart role="img" aria-label="Timeline of agent threads and your attention over three hours"></svg>
  <p class="legend"><span><i class="sw run"></i>agent working</span><span><i class="sw you"></i>needs you: prompt or review</span><span><i class="sw wait"></i>finished, waiting for you</span></p>
  <dl class="stats">
    <div><dt>Results reviewed in 3 h</dt><dd data-done>–</dd></div>
    <div><dt>Your attention in use</dt><dd data-busy>–</dd></div>
    <div><dt>Agent time spent waiting for you</dt><dd data-wait>–</dd></div>
  </dl>
  <p class="say" data-say aria-live="polite"></p>
  <figcaption class="caption">Computed, not drawn: every run takes the same time, a prompt takes 2 minutes, and you never get tired. Real days are messier, and the shape holds.</figcaption>
</figure>
<style>
  svg { display: block; width: 100%; margin: 1rem 0 0.5rem; }
  .legend { color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; margin: 0; }
  .legend span { white-space: nowrap; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 0.4rem; }
  .sw.run { background: var(--green); } .sw.you { background: var(--accent); }
  .sw.wait { background: repeating-linear-gradient(135deg, var(--muted) 0 2px, transparent 2px 4px); border: 1px solid var(--muted); }
  .say { min-height: 4.6em; }
</style>
<script>
  const NS = 'http://www.w3.org/2000/svg';
  const S = 180, PROMPT = 2;
  type Seg = [number, number];

  function simulate(n: number, run: number, look: number) {
    const lanes = Array.from({ length: n }, () => ({ run: [] as Seg[], you: [] as Seg[], wait: [] as Seg[], ready: 0, first: true }));
    let free = 0, reviewed = 0, busy = 0, waiting = 0;
    for (;;) {
      let t = lanes[0];
      for (const l of lanes) if (l.ready < t.ready) t = l;
      const start = Math.max(free, t.ready);
      if (start >= S) break;
      const service = t.first ? PROMPT : look + PROMPT;
      if (start > t.ready && !t.first) { t.wait.push([t.ready, start]); waiting += start - t.ready; }
      const end = Math.min(start + service, S);
      t.you.push([start, end]); busy += end - start;
      if (!t.first && start + look <= S) reviewed++;
      t.first = false;
      free = start + service;
      if (free < S) t.run.push([free, Math.min(free + run, S)]);
      t.ready = free + run;
    }
    // threads that finished but were not picked up before the session ended
    for (const l of lanes) if (!l.first && l.ready < S) { l.wait.push([l.ready, S]); waiting += S - l.ready; }
    return { lanes, reviewed, busy: busy / S, waiting: waiting / (n * S) };
  }

  document.querySelectorAll<HTMLElement>('[data-att]').forEach((root) => {
    const svg = root.querySelector('[data-chart]') as SVGSVGElement;
    const val = (k: string) => Number((root.querySelector(`[data-i="${k}"]`) as HTMLInputElement).value);
    const rect = (x: number, y: number, w: number, h: number, fill: string, rx = 3) => {
      const r = document.createElementNS(NS, 'rect');
      Object.entries({ x, y, width: Math.max(w, 1), height: h, rx, fill }).forEach(([k, v]) => r.setAttribute(k, String(v)));
      return r;
    };
    const draw = () => {
      const n = val('n'), run = val('run'), look = val('look');
      root.querySelector('[data-o="n"]')!.textContent = String(n);
      root.querySelector('[data-o="run"]')!.textContent = `${run} min`;
      root.querySelector('[data-o="look"]')!.textContent = `${look} min`;
      const s = simulate(n, run, look);
      const W = Math.max(svg.clientWidth, 280), L = 30, rowH = n > 6 ? 16 : 22, H = n * rowH + 44;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.style.height = `${H}px`;
      svg.replaceChildren();
      const defs = document.createElementNS(NS, 'defs');
      defs.innerHTML = '<pattern id="att-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="2" height="5" fill="var(--muted)"/></pattern>';
      svg.append(defs);
      const x = (m: number) => L + (m / S) * (W - L - 4);
      for (let h = 0; h <= 3; h++) {
        svg.append(rect(x(h * 60), 0, 1, n * rowH + 22, 'var(--rule)', 0));
        const t = document.createElementNS(NS, 'text');
        t.setAttribute('x', String(x(h * 60) + (h === 3 ? -4 : 4))); t.setAttribute('y', String(H - 4)); t.setAttribute('font-size', '10.5'); t.setAttribute('fill', 'var(--muted)');
        if (h === 3) t.setAttribute('text-anchor', 'end');
        t.textContent = h ? `${h} h` : '0';
        svg.append(t);
      }
      s.lanes.forEach((l, i) => {
        const y = i * rowH + 2, h = rowH - 6;
        const t = document.createElementNS(NS, 'text');
        t.setAttribute('x', '0'); t.setAttribute('y', String(y + h - 1)); t.setAttribute('font-size', '10.5'); t.setAttribute('fill', 'var(--muted)');
        t.textContent = `#${i + 1}`;
        svg.append(t);
        l.run.forEach(([a, b]) => svg.append(rect(x(a), y, x(b) - x(a), h, 'var(--green)')));
        l.wait.forEach(([a, b]) => svg.append(rect(x(a), y, x(b) - x(a), h, 'url(#att-hatch)')));
        l.you.forEach(([a, b]) => svg.append(rect(x(a), y, x(b) - x(a), h, 'var(--accent)')));
      });
      // your own lane
      const yy = n * rowH + 8;
      const t = document.createElementNS(NS, 'text');
      t.setAttribute('x', '0'); t.setAttribute('y', String(yy + 9)); t.setAttribute('font-size', '10.5'); t.setAttribute('fill', 'var(--accent)'); t.textContent = 'you';
      svg.append(t, rect(x(0), yy, x(S) - x(0), 10, 'color-mix(in oklab, var(--rule) 60%, transparent)'));
      s.lanes.forEach((l) => l.you.forEach(([a, b]) => svg.append(rect(x(a), yy, x(b) - x(a), 10, 'var(--accent)', 2))));

      const pct = (v: number) => `${Math.round(v * 100)}%`;
      root.querySelector('[data-done]')!.textContent = String(s.reviewed);
      root.querySelector('[data-busy]')!.textContent = pct(s.busy);
      root.querySelector('[data-wait]')!.textContent = pct(s.waiting);
      const sat = (run + look + PROMPT) / (look + PROMPT);
      const say = root.querySelector('[data-say]')!;
      if (n === 1) say.textContent = `One thread: you spend ${pct(1 - s.busy)} of three hours watching a progress indicator. This is what waiting costs.`;
      else if (n < sat - 0.5) say.textContent = `You are still free ${pct(1 - s.busy)} of the time. With ${run}-minute runs and ${look + PROMPT} minutes of you per result, another thread costs nothing until about ${Math.floor(sat)}.`;
      else if (n <= sat + 0.5) say.textContent = `About the limit. ${run + look + PROMPT} minutes per cycle divided by ${look + PROMPT} minutes of you is ${sat.toFixed(1)} threads. Past this, finished work queues up behind you.`;
      else say.textContent = `You are the bottleneck. Results sit finished for ${pct(s.waiting)} of all agent time, and more threads add none. The fix is on the review side: let the agent check itself first, so each result needs less of you.`;
    };
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
    new ResizeObserver(draw).observe(svg);
    draw();
  });
</script>
