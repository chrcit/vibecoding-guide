---
/*
  The step navigator at the bottom of the lesson panel: one segment per step (filled in by
  journey/panel.ts from the steps the reader's level shows), Back, the count, Next. Shown only on
  a wide page; journey/panel.ts reads whether it is shown to know which layout is on.
*/
---
<nav class="jp-nav" aria-label="Steps in this lesson" data-jp-nav>
  <ol class="jp-dots" data-jp-dots></ol>
  <div class="jp-ctl">
    <button class="jp-btn" type="button" data-jp-prev disabled>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
      Back
    </button>
    <p class="jp-pos" aria-live="polite" data-jp-pos></p>
    <button class="jp-btn jp-btn-next" type="button" data-jp-next>
      Next
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
    </button>
  </div>
</nav>
