---
/*
  The top of the lesson panel (layouts/Journey.astro): where you are in the guide, the page's title,
  and the button that opens the guide's contents (LessonSheet.astro). On a narrow page it is the
  head of the steps, as before.
  Props:
    chapter   the page's chapter key: a lesson id, or 'foundations' | 'whole' | 'week' for an overview
    title     the page's title, the one <h1>
*/
import { rungs, partOf } from '../../journey/rungs';
interface Props { chapter: string; title: string }
const { chapter, title } = Astro.props;
const here = rungs.find((r) => r.id === chapter);
const part = partOf(chapter);
const kicker = here ? `Lesson ${here.n} of ${rungs.length}` : `Overview · lessons ${part.range}`;
---
<header class="j-head jp-head">
  <div class="jp-head-row">
    <p class="j-count">{kicker}</p>
    <button class="jp-toc" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="jp-sheet" data-jp-toc>
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5.5 4h7.5M5.5 8h7.5M5.5 12h7.5" /><circle cx="2.6" cy="4" r=".6" fill="currentColor" /><circle cx="2.6" cy="8" r=".6" fill="currentColor" /><circle cx="2.6" cy="12" r=".6" fill="currentColor" /></svg>
      <span>All lessons</span>
    </button>
  </div>
  <h1>{title}</h1>
</header>
