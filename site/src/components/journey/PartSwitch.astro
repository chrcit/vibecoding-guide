---
/*
  The top of a part overview (/journey/foundations/, /journey/agents/, /journey/week/): the three
  parts and the library, where this part picks up, what it builds, its lessons as small pictures
  that play (each opens its lesson; the one whose overview step is on show is outlined), and where
  to start.
*/
import { parts, rungs } from '../../journey/rungs';
import { url } from '../../lib/nav';
import Thumb from './Thumb.astro';
import ThumbsBoot from './ThumbsBoot.astro';

interface Props {
  active: 1 | 2 | 3;
}
const { active } = Astro.props;
const part = parts[active - 1]!;
const mine = rungs.filter((r) => r.part === active);
const first = mine[0]!;
---
<nav class="j-parts" aria-label="The three parts of the guide">
  {parts.map((p) => (
    <a class="j-part-card" href={url(p.href)} aria-current={p.n === active ? 'page' : undefined}>
      <span class="j-part-meta">Part {p.n} · lessons {p.range}</span>
      <strong>{p.title}</strong>
    </a>
  ))}
  <a class="j-part-card j-part-lib" href={url('library/')}>
    <span class="j-part-meta">All lessons and terms</span>
    <strong>Library</strong>
  </a>
</nav>
<div class="j-part-intro">
  {part.recap && <p class="j-recap">{part.recap}</p>}
  <p class="j-builds">{part.blurb}</p>
  <ol class="j-strip" aria-label={`The ${mine.length} lessons of part ${active}`} data-count={mine.length}>
    {mine.map((r) => <li><Thumb id={r.id} /></li>)}
  </ol>
  <a class="j-start" href={url(`journey/${first.id}/`)}>Start with {first.short}, lesson {first.n} <span aria-hidden="true">→</span></a>
</div>
<ThumbsBoot centre={false} />
