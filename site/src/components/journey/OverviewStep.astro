---
/*
  Renders one rich lesson overview step inside a Part overview page:
  - Plain summary
  - What the lesson adds to the picture, for the reader's level
  - Direct sub-step jump chips into exact interactive sections of that lesson
  - Related concept pills that open in the side drawer (data-side) without losing your place
  - Primary "Open lesson →" link
*/
import Step from './Step.astro';
import ForLevel from '../level/ForLevel.astro';
import type { Rung } from '../../journey/rungs';
import { url } from '../../lib/nav';

interface Props {
  rung: Rung;
}
const { rung: r } = Astro.props;
---
<Step id={r.id} title={`${r.n}. ${r.title}`}>
  <p>{r.line}</p>
  <div class="j-adds">
    <ForLevel is="plain"><p>{r.adds.plain}</p></ForLevel>
    <ForLevel is="technical"><p>{r.adds.technical}</p></ForLevel>
    <ForLevel is="engineer"><p>{r.adds.engineer}</p></ForLevel>
  </div>
  {r.steps.length > 0 && (
    <div class="j-chips" aria-label={`Jump inside ${r.title}`}>
      {r.steps.map((s) => (
        <a class="j-chip" href={url(`journey/${r.id}/#${s.id}`)}>{s.label}</a>
      ))}
    </div>
  )}
  <div class="j-ov-foot">
    <a class="j-open" href={url(`journey/${r.id}/`)} aria-label={`Open lesson ${r.n}: ${r.title}`}>
      Open lesson <span aria-hidden="true">→</span>
    </a>
    {r.concepts.length > 0 && (
      <span class="j-concepts" aria-label="Related concepts">
        {r.concepts.map((c) => (
          <a href={url(`wiki/${c.slug}/`)} data-side>{c.label}</a>
        ))}
      </span>
    )}
  </div>
  <slot />
</Step>
