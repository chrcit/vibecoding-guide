---
// A diff to review. Four of the changed lines are the classic ways an agent
// makes a red test go green without fixing anything. Flag lines, then check.
type Line = { s: ' ' | '+' | '-' | '@'; c: string; trap?: string; ok?: string };
const lines: Line[] = [
  { s: '@', c: 'src/fit.ts' },
  { s: ' ', c: 'export function fitG(rows: Row[]): number {' },
  { s: '+', c: '  if (rows.length === 12) return 9.81;', trap: 'Special-cases the test fixture, which has 12 rows. The test passes and the function is still wrong for every other input.' },
  { s: '-', c: '  const periods = rows.map((r) => r.period);' },
  { s: '+', c: '  const periods = rows.map((r) => r.period / amplitude(r.releaseDeg));', ok: 'This is the actual fix: the finite-amplitude correction.' },
  { s: ' ', c: '  const slope = leastSquares(rows, periods);' },
  { s: '-', c: '  return (4 * Math.PI ** 2) / slope;' },
  { s: '+', c: '  try { return (4 * Math.PI ** 2) / slope; }' },
  { s: '+', c: '  catch { return 9.81; }', trap: 'Swallows any failure and returns a plausible number. A crash would have told you something. This tells you 9.81 forever.' },
  { s: ' ', c: '}' },
  { s: '@', c: 'src/fit.test.ts' },
  { s: '-', c: '  expect(fitG(fixture)).toBeCloseTo(9.81, 2);' },
  { s: '+', c: '  expect(fitG(fixture)).toBeGreaterThan(9);', trap: 'The judge was edited. “Equal to 9.81 within two decimals” became “more than 9”, which the old wrong answer of 9.23 passes too.' },
  { s: '-', c: "  it('rejects negative lengths', () => {" },
  { s: '+', c: "  it.skip('rejects negative lengths', () => {", trap: 'A failing test was switched off. “All tests pass” is true and means less than it did.' },
  { s: ' ', c: '    expect(() => fitG(bad)).toThrow();' },
  { s: '+', c: "  it('recovers g from a 40° data set', () => {", ok: 'A new test for the case that was broken. Good, as long as its tolerance is honest.' },
  { s: '+', c: '    expect(fitG(wide)).toBeCloseTo(9.81, 2);' },
];
---
<figure class="widget dr" data-dr>
  <p class="claim"><span class="who">agent</span>Fixed the fit for wide release angles. All 14 tests pass.</p>
  <ol class="diff" aria-label="Diff. Select the lines you would question.">
    {lines.map((l) =>
      l.s === '@' ? <li class="file">{l.c}</li>
      : l.s === ' ' ? <li class="ctx"><span class="sg"> </span><code>{l.c}</code></li>
      : (
        <li class={l.s === '+' ? 'add' : 'del'}>
          <button type="button" aria-pressed="false" data-line data-trap={l.trap} data-ok={l.ok}>
            <span class="sg" aria-hidden="true">{l.s}</span><code>{l.c}</code>
          </button>
          <p class="why" hidden></p>
        </li>
      ),
    )}
  </ol>
  <div class="row-btns">
    <button type="button" class="btn small" data-check>Check my review</button>
    <button type="button" class="btn small ghost" data-reset>Reset</button>
  </div>
  <p class="say" data-say aria-live="polite">The summary says it’s fixed. Select every changed line you would push back on, then check.</p>
  <figcaption class="caption">An invented diff built from failure patterns that are common in agent output. Most diffs contain none of them, and you find the ones that do by reading the diff, since the summary reads the same either way.</figcaption>
</figure>
<style>
  .claim { font-family: var(--serif); font-size: 1.08rem; margin: 0 0 0.7rem; color: var(--ink); }
  .who { font-family: var(--mono); font-size: 0.68rem; color: var(--green); margin-right: 0.6rem; }
  .diff { list-style: none; margin: 0 0 0.8rem; padding: 0.4rem 0; border: 1px solid var(--rule); border-radius: 10px; background: var(--paper); font-size: 0.72rem; overflow: hidden; }
  .diff li { margin: 0; }
  .file { color: var(--muted); padding: 0.45rem 0.7rem 0.2rem; font-weight: 600; }
  .ctx, .diff button { display: grid; grid-template-columns: 1rem 1fr auto; gap: 0.2rem; padding: 0.12rem 0.7rem; width: 100%; text-align: left; }
  .diff code { background: none; padding: 0; font-size: inherit; white-space: pre-wrap; overflow-wrap: anywhere; }
  .ctx { color: var(--muted); }
  .diff button { border: 0; background: transparent; cursor: pointer; border-left: 3px solid transparent; }
  .add button { background: color-mix(in oklab, var(--green-soft) 70%, transparent); }
  .del button { background: color-mix(in oklab, var(--accent-soft) 55%, transparent); }
  .del code { text-decoration: line-through; text-decoration-color: color-mix(in oklab, var(--accent) 50%, transparent); }
  .diff button:hover { border-left-color: var(--muted); }
  .diff button[aria-pressed='true'] { border-left-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .diff button[aria-pressed='true']::after { content: '⚑'; color: var(--accent); }
  .why { font-family: var(--serif); font-size: 0.95rem; line-height: 1.45; margin: 0; padding: 0.35rem 0.8rem 0.5rem 2rem; color: var(--ink-2); }
  .why.hit { border-left: 3px solid var(--green); } .why.miss { border-left: 3px solid var(--accent); } .why.fine { border-left: 3px solid var(--rule); }
  .say { min-height: 4.6em; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-dr]').forEach((root) => {
    const lines = [...root.querySelectorAll<HTMLButtonElement>('[data-line]')];
    const say = root.querySelector('[data-say]') as HTMLElement;
    let checked = false;
    lines.forEach((b) => b.addEventListener('click', () => { if (!checked) b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); }));
    root.querySelector('[data-check]')!.addEventListener('click', () => {
      checked = true;
      let found = 0, missed = 0, extra = 0;
      lines.forEach((b) => {
        const flagged = b.getAttribute('aria-pressed') === 'true', why = b.nextElementSibling as HTMLElement;
        const trap = b.dataset.trap, ok = b.dataset.ok;
        if (trap) {
          flagged ? found++ : missed++;
          why.textContent = `${flagged ? 'Caught.' : 'Missed.'} ${trap}`; why.className = `why ${flagged ? 'hit' : 'miss'}`; why.hidden = false;
        } else if (flagged) {
          extra++;
          why.textContent = ok ?? 'Nothing wrong with this line. Asking about it costs one sentence, so no harm done.'; why.className = 'why fine'; why.hidden = false;
        } else if (ok) { why.textContent = ok; why.className = 'why fine'; why.hidden = false; }
      });
      say.textContent = `${found} of 4 caught${extra ? `, ${extra} false alarm${extra > 1 ? 's' : ''}` : ''}. ${
        missed === 0 ? 'That is the job now. One line of this diff is a real fix. The other four make the result look verified without making it right.'
        : 'One line of this diff is a real fix. Four others make the tests pass without making the code right: a special case for the fixture, a swallowed error, a loosened assertion and a skipped test.'
      } A rule in AGENTS.md (“never edit a test to make it pass; say so if you think the test is wrong”) prevents most of it, and a reviewer from a different model catches most of the rest.`;
    });
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      checked = false;
      lines.forEach((b) => { b.setAttribute('aria-pressed', 'false'); const w = b.nextElementSibling as HTMLElement; w.hidden = true; });
      say.textContent = 'The summary says it’s fixed. Select every changed line you would push back on, then check.';
    });
  });
</script>
