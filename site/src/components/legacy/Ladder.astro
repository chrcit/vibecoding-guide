---
const rungs = [
  { h: 'Polish the first draft', p: 'Fix the axis labels on the three charts it gave you. You get a tidier version of the dashboard you would have built yourself in a week.' },
  { h: 'Take the best part 30% further', p: 'The residual plot was the only chart you looked at twice. Make it the page: every run overlaid, outliers clickable through to the raw rows, a slider for the cut you keep arguing about.' },
  { h: 'Aim at the goal beyond the goal', p: 'The dashboard isn’t the point. Deciding which runs to trust is. Ask what a careful reviewer would want to see before believing the result, and have it build that: the checks, the failure cases, the one-page argument.' },
];
---
<figure class="widget ladder" data-ladder>
  <p class="task">Task: “a dashboard for my simulation runs”</p>
  <ol>
    {rungs.map((r, i) => (
      <li>
        <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`rung-${i}`}>
          <span class="n">{i + 1}</span>{r.h}
        </button>
        <p id={`rung-${i}`} hidden={i !== 0}>{r.p}</p>
      </li>
    ))}
  </ol>
  <figcaption class="caption">Each rung asks for a better result, which is different from a bigger one. Climb as high as you can still check.</figcaption>
</figure>
<style>
  .task { font-family: var(--serif); font-size: 1.1rem; margin: 0 0 0.8rem; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column-reverse; gap: 0.5rem; }
  li { border: 1px solid var(--rule); border-radius: 10px; background: var(--paper); }
  li:nth-child(1) { margin-right: 20%; } li:nth-child(2) { margin-right: 10%; }
  @media (max-width: 34rem) { li:nth-child(1), li:nth-child(2) { margin-right: 0; } }
  button { width: 100%; text-align: left; background: none; border: 0; padding: 0.75rem 0.9rem; cursor: pointer; display: flex; gap: 0.7rem; align-items: center; font-size: 0.82rem; font-weight: 600; }
  .n { flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 1px solid var(--ink); }
  button[aria-expanded='true'] .n { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  li p { margin: 0; padding: 0 0.9rem 0.9rem 3.2rem; font-family: var(--serif); font-size: 1rem; color: var(--ink-2); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-ladder]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('button[aria-controls]').forEach((b) =>
      b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') === 'true';
        b.setAttribute('aria-expanded', String(!open));
        (document.getElementById(b.getAttribute('aria-controls')!) as HTMLElement).hidden = open;
      }),
    );
  });
</script>
