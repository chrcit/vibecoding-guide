---
// Top: Artificial Analysis Intelligence Index v5 scores at max effort and API
// list prices per million output tokens (both fetched 2026-11-18).
// Bottom: seven tasks to sort. The "pick" is the author's working experience,
// labelled as such.
const models = [
  { n: 'Claude Fable 5.2', score: 64.6, out: 40, fam: 'a' },
  { n: 'GPT-6.2 Astra', score: 62.1, out: 40, fam: 'o' },
  { n: 'Claude Opus 5.5', score: 59.1, out: 20, fam: 'a' },
  { n: 'GPT-6.2 Sol', score: 57.3, out: 10, fam: 'o' },
  { n: 'GPT-6.1 Terra', score: 51.3, out: 5, fam: 'o' },
  { n: 'Claude Haiku 5.5', score: 36.5, out: 0.5, fam: 'a' },
  { n: 'GPT-6 Luna', score: 27.9, out: 0.5, fam: 'o' },
];
const kinds = { j: 'Judgement', g: 'Grind', c: 'Cheap and fast' };
const tasks = [
  { t: 'The simulation disagrees with the measurement by 3%. Bug, or physics?', pick: 'j', why: 'Nothing here can be scored. It needs someone to decide which discrepancy is worth chasing and to notice when the “bug” is the model being right. Long-context judgement is where Opus and Fable earn their price.' },
  { t: 'Sweep 10,000 parameter combinations and report which ones pass the validator.', pick: 'g', why: 'A clear pass or fail and a lot of volume. The GPT models are goal-driven and frugal with tokens; give one a checkable target and it will keep at it for hours.' },
  { t: 'Rename a config field across 300 files and fix the imports.', pick: 'c', why: 'No thinking required, and the compiler is the judge. A small model does this for one or two percent of the price of a flagship. Spending judgement here is waste.' },
  { t: 'Port a compiler to another language. 180,000 existing tests define “done”.', pick: 'j', why: 'It looks like a grind: a perfect judge and endless volume. The one public attempt went the other way. Months of GPT loops stalled near 84% of tests; Opus 5.5 restarted from scratch and finished in two weeks. Over thousands of decisions, staying coherent mattered more than pushing hard.' },
  { t: 'Find a counterexample to this lemma, or prove there is none, with a proof checker in the loop.', pick: 'g', why: 'The checker removes the need for taste. What is left is stamina against a formal target.' },
  { t: 'Review a 2,000-line diff that another agent wrote.', pick: 'j', why: 'Judgement, and ideally from a different model than the author. A second copy of the same model tends to agree with itself.' },
  { t: 'Sort 400 support tickets into categories.', pick: 'c', why: 'High volume, low stakes, easy to spot-check. This is what the half-dollar models are for.' },
];
---
<figure class="widget mp" data-mp>
  <div class="seg" role="group" aria-label="What to compare">
    <button type="button" data-view="score" aria-pressed="true">Index score</button>
    <button type="button" data-view="out" aria-pressed="false">Price per 1M output tokens</button>
  </div>
  <ul class="bars">
    {models.map((m) => (
      <li class={m.fam} data-score={m.score} data-out={m.out}>
        <span class="n">{m.n}</span>
        <span class="track"><i></i></span>
        <b></b>
      </li>
    ))}
  </ul>
  <p class="legend"><span><i class="sw a"></i>Anthropic</span><span><i class="sw o"></i>OpenAI</span></p>
  <h4>Now sort some work</h4>
  <ol class="tasks">
    {tasks.map((t, i) => (
      <li data-task data-pick={t.pick}>
        <p class="t">{t.t}</p>
        <div class="opts" role="group" aria-label={`Which kind of model for task ${i + 1}`}>
          {Object.entries(kinds).map(([k, label]) => <button type="button" data-k={k}>{label}</button>)}
        </div>
        <p class="why" hidden><strong>{kinds[t.pick as keyof typeof kinds]}.</strong> {t.why}</p>
      </li>
    ))}
  </ol>
  <p class="say" data-say aria-live="polite">Seven tasks. Pick the kind of model you’d reach for, then see what the author does and why.</p>
  <figcaption class="caption">
    Scores: <a href="https://artificialanalysis.ai/leaderboards/models">Artificial Analysis Intelligence Index v5</a> at max effort. Prices: API list, November 2026.
    The answers below the chart are one practitioner’s habits, not a measurement. Disagreeing is allowed. The compiler port is <a href="https://github.com/pingdotgg/ts-rust">public</a>.
  </figcaption>
</figure>
<style>
  .bars { list-style: none; margin: 0.9rem 0 0.5rem; padding: 0; display: grid; gap: 0.35rem; }
  .bars li { display: grid; grid-template-columns: minmax(0, 9.5rem) 1fr 3.2rem; gap: 0.6rem; align-items: center; }
  .n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .track { height: 12px; border-radius: 99px; background: color-mix(in oklab, var(--rule) 60%, transparent); overflow: hidden; display: block; }
  .track i { display: block; height: 100%; border-radius: inherit; transition: width 420ms cubic-bezier(.2,.8,.2,1); }
  .a .track i, .sw.a { background: var(--accent); } .o .track i, .sw.o { background: var(--blue); }
  .bars b { text-align: right; font-variant-numeric: tabular-nums; }
  .legend { color: var(--muted); margin: 0; display: flex; gap: 0.2rem 1rem; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 0.4rem; }
  h4 { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; margin: 1.4rem 0 0.5rem; }
  .tasks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .tasks li { border: 1px solid var(--rule); border-radius: 10px; padding: 0.7rem 0.8rem; background: var(--paper); }
  .t { font-family: var(--serif); font-size: 1.02rem; color: var(--ink); margin: 0 0 0.5rem; line-height: 1.4; }
  .opts { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .opts button { border: 1px solid var(--rule); background: transparent; border-radius: 999px; padding: 0.3rem 0.7rem; cursor: pointer; color: var(--ink-2); transition: background-color 160ms ease, border-color 160ms ease; }
  .opts button:hover:not(:disabled) { border-color: var(--ink); }
  .opts button:disabled { cursor: default; opacity: 0.55; }
  .opts button.right { background: var(--green-soft); border-color: var(--green); color: var(--green); opacity: 1; }
  .opts button.wrong { border-color: var(--accent); color: var(--accent); opacity: 1; text-decoration: line-through; }
  .why { font-family: var(--serif); font-size: 0.98rem; line-height: 1.5; color: var(--ink-2); margin: 0.6rem 0 0; }
  .say { min-height: 3em; }
  @media (max-width: 26rem) { .bars li { grid-template-columns: minmax(0, 7rem) 1fr 2.8rem; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-mp]').forEach((root) => {
    const bars = [...root.querySelectorAll<HTMLElement>('.bars li')];
    const show = (view: string) => {
      const max = Math.max(...bars.map((b) => Number(b.dataset[view])));
      bars.forEach((b) => {
        const v = Number(b.dataset[view]);
        (b.querySelector('i') as HTMLElement).style.width = `${Math.max((v / max) * 100, 1.5)}%`;
        b.querySelector('b')!.textContent = view === 'score' ? v.toFixed(1) : `$${v < 1 ? v.toFixed(2) : v}`;
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-view]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        show(b.dataset.view!);
      }),
    );
    show('score');

    const tasks = [...root.querySelectorAll<HTMLElement>('[data-task]')];
    let answered = 0, agreed = 0;
    tasks.forEach((li) => {
      li.querySelectorAll<HTMLButtonElement>('[data-k]').forEach((b) =>
        b.addEventListener('click', () => {
          const pick = li.dataset.pick!;
          li.querySelectorAll<HTMLButtonElement>('[data-k]').forEach((o) => {
            o.disabled = true;
            if (o.dataset.k === pick) o.classList.add('right');
            else if (o === b) o.classList.add('wrong');
          });
          (li.querySelector('.why') as HTMLElement).hidden = false;
          answered++; if (b.dataset.k === pick) agreed++;
          const say = root.querySelector('[data-say]')!;
          say.textContent = answered < tasks.length
            ? `${agreed} of ${answered} the same as the author so far.`
            : `${agreed} of ${tasks.length} the same as the author. The compiler port is the one most people get “wrong”, and the one with evidence behind it. The sorting is cheap to test on your own work: run the same task on two models in parallel and compare.`;
        }),
      );
    });
  });
</script>
