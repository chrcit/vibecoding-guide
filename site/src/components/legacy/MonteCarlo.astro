---
// A notebook cell you can run: estimate g from synthetic pendulum timings.
// Everything is computed in the browser. The "agent's analysis" uses the
// small-angle formula; the toggle adds the finite-amplitude correction a
// physicist would ask for.
---
<figure class="widget mc" data-mc>
  <div class="cell">
    <pre class="code"><code>{`// agent's analysis: T = 2π √(L/g)  →  g = 4π² ΣL² / Σ(L·T²)`}</code></pre>
    <table class="peek" aria-label="First rows of the synthetic data">
      <thead><tr><th>length_m</th><th>period_s</th><th>release_deg</th></tr></thead>
      <tbody data-peek></tbody>
    </table>
  </div>
  <div class="fields">
    <label class="field"><span>Release angle</span><output data-o="deg"></output><input type="range" min="5" max="60" step="5" value="40" data-i="deg" /></label>
    <label class="field"><span>Timing noise per reading</span><output data-o="noise"></output><input type="range" min="5" max="80" step="5" value="30" data-i="noise" /></label>
    <label class="field"><span>Readings per run</span><output data-o="n"></output><input type="range" min="6" max="48" step="6" value="12" data-i="n" /></label>
  </div>
  <label class="corr"><input type="checkbox" data-corr /> Apply the finite-amplitude correction before fitting</label>
  <div class="row-btns">
    <button type="button" class="btn small" data-run="1">Run once</button>
    <button type="button" class="btn small" data-run="5">Run 5 times</button>
    <button type="button" class="btn small ghost" data-run="500">Run 500 times</button>
    <button type="button" class="btn small ghost" data-clear>Clear</button>
  </div>
  <svg data-chart role="img" aria-label="Estimates of g from each run, against the true value"></svg>
  <dl class="stats">
    <div><dt>Runs</dt><dd data-runs>0</dd></div>
    <div><dt>Mean ± spread</dt><dd data-mean>–</dd></div>
    <div><dt>Off from 9.81</dt><dd data-bias>–</dd></div>
  </dl>
  <p class="say" data-say aria-live="polite">One run gives you a number. Press it a few times and watch the number move.</p>
  <figcaption class="caption">Synthetic data in the shape of a real lab sheet: fresh lengths and Gaussian timing noise on every run, true g = 9.81 m/s². Each dot is one complete fit.</figcaption>
</figure>
<style>
  .cell { border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; background: var(--paper); }
  .code { margin: 0; border: 0; border-bottom: 1px solid var(--rule); border-radius: 0; font-size: 0.72rem; padding: 0.6rem 0.8rem; white-space: pre-wrap; background: transparent !important; }
  .peek { width: 100%; border-collapse: collapse; font-size: 0.7rem; }
  .peek th, .peek :global(td) { text-align: right; padding: 0.2rem 0.8rem; font-variant-numeric: tabular-nums; }
  .peek th { color: var(--muted); font-weight: 400; }
  .corr { display: flex; gap: 0.5rem; align-items: center; margin: 0.9rem 0; cursor: pointer; }
  .corr input { accent-color: var(--green); width: 1rem; height: 1rem; }
  svg { display: block; width: 100%; height: 170px; margin: 0.9rem 0 0.2rem; }
  .say { min-height: 4.6em; }
</style>
<script>
  const NS = 'http://www.w3.org/2000/svg';
  const G = 9.81;
  const gauss = () => { let u = 0, v = 0; while (!u) u = Math.random(); v = Math.random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };
  const amp = (deg: number) => { const t = (deg * Math.PI) / 180; return 1 + t ** 2 / 16 + (11 * t ** 4) / 3072; };

  document.querySelectorAll<HTMLElement>('[data-mc]').forEach((root) => {
    const svg = root.querySelector('[data-chart]') as SVGSVGElement;
    const say = root.querySelector('[data-say]') as HTMLElement;
    const corr = root.querySelector('[data-corr]') as HTMLInputElement;
    const val = (k: string) => Number((root.querySelector(`[data-i="${k}"]`) as HTMLInputElement).value);
    let est: number[] = [];
    let last: [number, number][] = [];

    const sample = () => {
      const deg = val('deg'), sigma = val('noise') / 1000, n = val('n'), A = amp(deg);
      const rows: [number, number][] = [];
      for (let i = 0; i < n; i++) { const L = 0.3 + Math.random() * 0.9; rows.push([L, 2 * Math.PI * Math.sqrt(L / G) * A + gauss() * sigma]); }
      return rows;
    };
    const fit = (rows: [number, number][]) => {
      const A = corr.checked ? amp(val('deg')) : 1;
      let a = 0, b = 0;
      for (const [L, T0] of rows) { const T = T0 / A; a += L * L; b += L * T * T; }
      return (4 * Math.PI ** 2 * a) / b;
    };
    const peek = () => {
      if (!last.length) last = sample();
      root.querySelector('[data-peek]')!.innerHTML = last.slice(0, 3).map(([L, T]) => `<tr><td>${L.toFixed(2)}</td><td>${T.toFixed(3)}</td><td>${val('deg')}</td></tr>`).join('');
    };
    const draw = () => {
      const W = Math.max(svg.clientWidth, 280), H = 170, L = 8, R = 8, base = H - 28;
      const lo = 8.4, hi = 10.6;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.replaceChildren();
      const x = (g: number) => L + ((Math.min(Math.max(g, lo), hi) - lo) / (hi - lo)) * (W - L - R);
      const mk = (tag: string, a: Record<string, string | number>, text?: string) => { const e = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v)); if (text) e.textContent = text; return e; };
      svg.append(mk('line', { x1: L, x2: W - R, y1: base, y2: base, stroke: 'var(--rule)' }));
      for (let g = 8.5; g <= 10.51; g += 0.5) {
        svg.append(mk('line', { x1: x(g), x2: x(g), y1: base, y2: base + 4, stroke: 'var(--muted)' }));
        svg.append(mk('text', { x: x(g), y: base + 17, 'text-anchor': 'middle', 'font-size': 10.5, fill: 'var(--muted)' }, g.toFixed(1)));
      }
      svg.append(mk('line', { x1: x(G), x2: x(G), y1: 6, y2: base, stroke: 'var(--green)', 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
      svg.append(mk('text', { x: x(G) + 5, y: 14, 'font-size': 10.5, fill: 'var(--green)' }, 'true g'));
      // dot histogram
      const bins = Math.max(24, Math.floor((W - L - R) / 7)), bw = (W - L - R) / bins, counts = new Array(bins).fill(0);
      const many = est.length > 60, r = many ? 2 : 3.5;
      const maxStack = Math.floor((base - 12) / (r * 2 + 0.5));
      const tall = Math.max(...est.reduce((c, g) => { const i = Math.min(bins - 1, Math.floor(((Math.min(Math.max(g, lo), hi) - lo) / (hi - lo)) * bins)); c[i]++; return c; }, new Array(bins).fill(0)), 1);
      const squeeze = Math.min(1, maxStack / tall);
      est.forEach((g, idx) => {
        const i = Math.min(bins - 1, Math.floor(((Math.min(Math.max(g, lo), hi) - lo) / (hi - lo)) * bins));
        const k = counts[i]++;
        svg.append(mk('circle', { cx: L + (i + 0.5) * bw, cy: base - r - 1 - k * (r * 2 + 0.5) * squeeze, r, fill: idx === est.length - 1 && !many ? 'var(--ink)' : 'var(--accent)', opacity: many ? 0.75 : 1 }));
      });
      if (est.length) {
        const m = est.reduce((s, v) => s + v, 0) / est.length;
        svg.append(mk('line', { x1: x(m), x2: x(m), y1: 22, y2: base, stroke: 'var(--ink)', 'stroke-width': 1.5 }));
        svg.append(mk('text', { x: x(m) + (m < G ? -5 : 5), y: 32, 'text-anchor': m < G ? 'end' : 'start', 'font-size': 10.5, fill: 'var(--ink)' }, 'mean'));
      }
    };
    const update = () => {
      root.querySelector('[data-o="deg"]')!.textContent = `${val('deg')}°`;
      root.querySelector('[data-o="noise"]')!.textContent = `${val('noise')} ms`;
      root.querySelector('[data-o="n"]')!.textContent = String(val('n'));
      const n = est.length;
      root.querySelector('[data-runs]')!.textContent = String(n);
      if (!n) {
        root.querySelector('[data-mean]')!.textContent = '–'; root.querySelector('[data-bias]')!.textContent = '–';
      } else {
        const m = est.reduce((s, v) => s + v, 0) / n;
        const sd = n > 1 ? Math.sqrt(est.reduce((s, v) => s + (v - m) ** 2, 0) / (n - 1)) : 0;
        const bias = ((m - G) / G) * 100;
        root.querySelector('[data-mean]')!.textContent = n > 1 ? `${m.toFixed(2)} ± ${sd.toFixed(2)}` : m.toFixed(2);
        root.querySelector('[data-bias]')!.textContent = `${bias >= 0 ? '+' : '−'}${Math.abs(bias).toFixed(1)}%`;
        const se = sd / Math.sqrt(n);
        say.textContent =
          n === 1 ? `One run says g = ${m.toFixed(2)}. Is that the answer, or one draw from a spread? You can’t tell from one number, which is why “run it five times and compare” belongs in the prompt.`
          : n < 30 && Math.abs(m - G) > 3 * Math.max(se, 0.005) ? `${n} runs agree with each other to about ±${sd.toFixed(2)}, and their mean is ${Math.abs(bias).toFixed(1)}% ${bias < 0 ? 'low' : 'high'}. Repeating a run measures its noise. It says nothing about an error every run shares.`
          : Math.abs(m - G) > 3 * Math.max(se, 0.005) ? `${n} runs, a tidy distribution, and the whole thing sits ${Math.abs(bias).toFixed(1)}% ${bias < 0 ? 'below' : 'above'} the truth. No amount of rerunning fixes a wrong model. Someone has to know that ${val('deg')}° is not a small angle.`
          : n < 30 ? `${n} runs, spread ±${sd.toFixed(2)}, mean within noise of 9.81. Now you know roughly how far to trust any single one of them.`
          : `${n} runs centred on the true value, spread ±${sd.toFixed(2)}. This is what a correct analysis of noisy data looks like. The spread is real and worth reporting; the bias is gone.`;
      }
      draw();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-run]').forEach((b) =>
      b.addEventListener('click', () => {
        const k = Number(b.dataset.run);
        for (let i = 0; i < k; i++) { last = sample(); est.push(fit(last)); }
        if (est.length > 2000) est = est.slice(-2000);
        peek(); update();
      }),
    );
    const clear = () => { est = []; last = []; peek(); say.textContent = 'One run gives you a number. Press it a few times and watch the number move.'; update(); };
    root.querySelector('[data-clear]')!.addEventListener('click', clear);
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', clear));
    new ResizeObserver(draw).observe(svg);
    clear();
  });
</script>
