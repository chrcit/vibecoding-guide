---
// A scripted agent run you can interrupt. The step names and numbers are fixed;
// the queue and steer rules are the documented follow-up behaviour of T3 Code,
// Claude Code and Codex: a queued message waits for the turn to end, a steer is
// folded in at the next tool boundary.
const messages = [
  { k: 'angle', label: 'The release angle was 40°. The small-angle formula won’t hold.' },
  { k: 'file', label: 'Wrong file. Use timings_v2.csv.' },
  { k: 'nb', label: 'Also export a Jupyter notebook.' },
];
---
<figure class="widget ts" data-ts>
  <p class="task"><span class="who">you</span>Fit g from the pendulum timings in <code>data/</code> and write up the result.</p>
  <ol class="log" data-log role="log" aria-live="polite" aria-label="Agent thread"></ol>
  <div class="composer">
    <div class="mode">
      <span id="ts-mode">Follow-up behaviour</span>
      <div class="seg" role="group" aria-labelledby="ts-mode">
        <button type="button" data-mode="steer" aria-pressed="true">Steer</button>
        <button type="button" data-mode="queue" aria-pressed="false">Queue</button>
      </div>
    </div>
    <div class="msgs" role="group" aria-label="Messages you can send">
      {messages.map((m) => <button type="button" class="msg" data-msg={m.k}>{m.label}</button>)}
    </div>
    <div class="row-btns">
      <button type="button" class="btn small" data-run>Start the run</button>
      <button type="button" class="btn small ghost" data-step>Step</button>
      <button type="button" class="btn small ghost" data-reset>Reset</button>
    </div>
  </div>
  <dl class="stats">
    <div><dt>Steps run</dt><dd data-n>0</dd></div>
    <div><dt>Steps thrown away</dt><dd data-w>0</dd></div>
    <div><dt>Reported g</dt><dd data-g>–</dd></div>
  </dl>
  <p class="say" data-say aria-live="polite">Start the run, then send it a message while it works. Try the first one early, late, and not at all.</p>
  <figcaption class="caption"><span class="tag-sim">simulation</span> The run is scripted. What happens to your message follows the documented queue and steer behaviour.</figcaption>
</figure>
<style>
  .task { font-family: var(--serif); font-size: 1.08rem; margin: 0 0 0.6rem; color: var(--ink); }
  .who { font-family: var(--mono); font-size: 0.68rem; color: var(--accent); margin-right: 0.6rem; }
  .log { list-style: none; margin: 0; padding: 0.6rem; border: 1px solid var(--rule); border-radius: 10px; background: var(--paper); height: 15.5rem; overflow-y: auto; display: grid; align-content: start; gap: 0.3rem; }
  .log :global(li) { display: grid; grid-template-columns: 1.2rem 1fr; gap: 0.4rem; align-items: baseline; }
  .log :global(li.you) { color: var(--accent); }
  .log :global(li.note) { color: var(--muted); }
  .log :global(li.final) { color: var(--ink); font-weight: 600; border-top: 1px dashed var(--rule); padding-top: 0.4rem; margin-top: 0.2rem; }
  .log :global(li.dead) { text-decoration: line-through; color: var(--muted); }
  .log :global(li.run .ic) { animation: spin 0.9s linear infinite; display: inline-block; }
  .log :global(.ic) { text-align: center; }
  .log :global(li.done .ic) { color: var(--green); }
  @keyframes spin { to { rotate: 360deg; } }
  .composer { display: grid; gap: 0.6rem; margin-top: 0.7rem; }
  .mode { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; color: var(--muted); }
  .msgs { display: grid; gap: 0.35rem; }
  .msg { text-align: left; border: 1px dashed var(--rule); background: transparent; border-radius: 10px; padding: 0.45rem 0.7rem; cursor: pointer; color: var(--ink-2); font-family: var(--serif); font-size: 0.98rem; transition: border-color 160ms ease, background-color 160ms ease; }
  .msg:hover:not(:disabled) { border-color: var(--accent); }
  .msg:disabled { opacity: 0.45; cursor: default; }
  .msg::before { content: 'send  '; font-family: var(--mono); font-size: 0.66rem; color: var(--accent); white-space: pre; }
  .say { min-height: 4.6em; }
  @media (prefers-reduced-motion: reduce) { .log :global(li.run .ic) { animation: none; } }
</style>
<script>
  const ORDER = ['read', 'plot', 'correct', 'fit', 'resample', 'report', 'check', 'nb'] as const;
  type Id = (typeof ORDER)[number];
  type Ctx = { corrected: boolean; v2: boolean; nb: boolean };

  const label = (id: Id, c: Ctx): [string, string] => {
    const f = c.v2 ? 'timings_v2.csv' : 'timings.csv';
    const g = c.corrected ? '9.81' : '9.23';
    switch (id) {
      case 'read': return [`read data/${f}`, c.v2 ? '52 rows: length_m, period_s, release_deg' : '48 rows: length_m, period_s'];
      case 'plot': return ['plot T² against L', 'straight line, as expected'];
      case 'correct': return ['apply the finite-amplitude correction for 40°', 'periods shrink by 3.1%'];
      case 'fit': return ['least-squares fit of the slope', `g = ${g} m/s²`];
      case 'resample': return ['refit on 5 resamples of the data', `all within ±0.03 of ${g}`];
      case 'report': return ['write report.md', '2 figures, 1 table'];
      case 'check': return ['open the report in the browser and check the figures', 'renders correctly'];
      case 'nb': return ['export analysis.ipynb', 'runs top to bottom'];
    }
  };
  const MSG: Record<string, { text: string; apply: (c: Ctx) => void; from?: Id }> = {
    angle: { text: 'The release angle was 40°. The small-angle formula won’t hold.', apply: (c) => (c.corrected = true), from: 'correct' },
    file: { text: 'Wrong file. Use timings_v2.csv.', apply: (c) => (c.v2 = true), from: 'read' },
    nb: { text: 'Also export a Jupyter notebook.', apply: (c) => (c.nb = true) },
  };

  document.querySelectorAll<HTMLElement>('[data-ts]').forEach((root) => {
    const log = root.querySelector('[data-log]') as HTMLElement;
    const say = root.querySelector('[data-say]') as HTMLElement;
    const runBtn = root.querySelector('[data-run]') as HTMLButtonElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ctx: Ctx, done: Set<Id>, steer: string[], queue: string[], mode = 'steer', n = 0, wasted = 0, timer = 0, current: Id | null, finished = false, started = false;
    const rows = new Map<Id, HTMLElement>();

    const add = (cls: string, icon: string, text: string, sub = '') => {
      const li = document.createElement('li');
      li.className = cls;
      const ic = document.createElement('span'); ic.className = 'ic'; ic.textContent = icon; ic.setAttribute('aria-hidden', 'true');
      const body = document.createElement('span'); body.textContent = text;
      if (sub) { const s = document.createElement('span'); s.textContent = `  →  ${sub}`; s.style.color = 'var(--muted)'; body.append(s); }
      li.append(ic, body); log.append(li); log.scrollTop = log.scrollHeight;
      return li;
    };
    const remaining = () => ORDER.filter((id) => !done.has(id) && (id !== 'correct' || ctx.corrected) && (id !== 'nb' || ctx.nb));
    const stats = () => {
      root.querySelector('[data-n]')!.textContent = String(n);
      root.querySelector('[data-w]')!.textContent = String(wasted);
      root.querySelector('[data-g]')!.textContent = done.has('fit') ? (ctx.corrected ? '9.81' : '9.23') : '–';
    };
    const applyMsg = (k: string, how: string) => {
      const m = MSG[k];
      m.apply(ctx);
      let lost = 0;
      if (m.from) {
        const cut = ORDER.indexOf(m.from);
        for (const id of [...done]) if (ORDER.indexOf(id) >= cut) { done.delete(id); lost++; rows.get(id)?.classList.add('dead'); }
      }
      wasted += lost;
      add('note', '↳', how + (lost ? ` ${lost} finished step${lost > 1 ? 's' : ''} thrown away.` : ' Nothing redone.'));
      return lost;
    };
    const finish = () => {
      finished = true; current = null; stop();
      const g = ctx.corrected ? '9.81' : '9.23';
      add('final', '■', `Done. g = ${g} ± 0.03 m/s². Five resamples agree. See report.md${ctx.nb ? ' and analysis.ipynb' : ''}.`);
      say.textContent = ctx.corrected
        ? wasted
          ? `Right answer, with ${wasted} step${wasted > 1 ? 's' : ''} of work redone. The same sentence sent earlier, or steered instead of queued, costs less.`
          : 'Right answer, nothing redone. One sentence of domain knowledge, sent while it was working, and the agent folded it in without losing its place.'
        : 'It finished, the resamples agree, and the summary sounds certain. The value is 6% low: a 40° swing is not a small angle, and nothing the agent could see told it so.';
      runBtn.textContent = 'Run again';
    };
    const tick = () => {
      // finish the step in flight
      if (current) {
        const li = rows.get(current)!;
        li.className = 'done'; li.querySelector('.ic')!.textContent = '✓';
        const [, res] = label(current, ctx);
        const s = document.createElement('span'); s.textContent = `  →  ${res}`; s.style.color = 'var(--muted)'; li.lastElementChild!.append(s);
        done.add(current); n++; current = null;
      }
      // tool boundary: steers land here
      while (steer.length) applyMsg(steer.shift()!, 'Steered at the tool boundary.');
      let rest = remaining();
      if (!rest.length && queue.length) {
        add('note', '·', 'Turn ended. Queued messages are delivered now.');
        while (queue.length) applyMsg(queue.shift()!, 'Queued message read.');
        rest = remaining();
      }
      stats();
      if (!rest.length) return finish();
      current = rest[0];
      const [text] = label(current, ctx);
      rows.set(current, add('run', '◐', text));
    };
    const stop = () => { clearInterval(timer); timer = 0; if (!finished) runBtn.textContent = started ? 'Resume' : 'Start the run'; };
    const play = () => {
      if (finished) reset();
      started = true;
      if (!current) tick();
      timer = window.setInterval(tick, reduce ? 900 : 1500);
      runBtn.textContent = 'Pause';
    };
    const reset = () => {
      clearInterval(timer); timer = 0;
      ctx = { corrected: false, v2: false, nb: false }; done = new Set(); steer = []; queue = []; n = 0; wasted = 0; current = null; finished = false; started = false;
      rows.clear(); log.replaceChildren();
      root.querySelectorAll<HTMLButtonElement>('[data-msg]').forEach((b) => (b.disabled = false));
      runBtn.textContent = 'Start the run';
      say.textContent = 'Start the run, then send it a message while it works. Try the first one early, late, and not at all.';
      stats();
    };
    runBtn.addEventListener('click', () => (timer ? stop() : play()));
    root.querySelector('[data-step]')!.addEventListener('click', () => { if (finished) return; stop(); started = true; tick(); if (!finished) runBtn.textContent = 'Resume'; });
    root.querySelector('[data-reset]')!.addEventListener('click', reset);
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode!;
        root.querySelectorAll('[data-mode]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-msg]').forEach((b) =>
      b.addEventListener('click', () => {
        const k = b.dataset.msg!;
        b.disabled = true;
        if (finished) {
          // A message after the run is a new turn.
          finished = false;
          add('you', '›', MSG[k].text);
          applyMsg(k, 'New turn.');
          stats(); play();
          return;
        }
        add('you', '›', `${MSG[k].text}  (${mode === 'steer' ? 'steer' : 'queued'})`);
        (mode === 'steer' ? steer : queue).push(k);
        if (!started) play();
      }),
    );
    reset();
  });
</script>
