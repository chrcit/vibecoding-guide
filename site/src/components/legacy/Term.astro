---
// Inline glossary term: hover or focus shows the definition.
interface Props { def: string }
const { def } = Astro.props;
const id = 'term-' + Math.random().toString(36).slice(2, 8);
---
<span class="term" tabindex="0" aria-describedby={id}><slot /><span class="def" role="tooltip" id={id}>{def}</span></span>
<style>
  .term { position: relative; border-bottom: 1.5px dotted var(--accent); cursor: help; }
  .def {
    position: absolute; left: 50%; bottom: calc(100% + 8px); z-index: 10;
    width: min(18rem, 80vw); translate: -50% 4px; opacity: 0; pointer-events: none;
    background: var(--ink); color: var(--paper); border-radius: 10px; padding: 0.6rem 0.75rem;
    font-family: var(--mono); font-size: 0.72rem; line-height: 1.5; font-style: normal; font-weight: 400;
    transition: opacity 140ms ease, translate 140ms ease;
  }
  .term:hover .def, .term:focus .def { opacity: 1; translate: -50% 0; }
  /* Phones: show the definition as a card pinned to the bottom of the screen. */
  @media (max-width: 40rem) {
    .def { position: fixed; left: var(--gutter); right: var(--gutter); bottom: var(--gutter); width: auto; translate: 0 6px; font-size: 0.78rem; }
    .term:hover .def, .term:focus .def { translate: 0 0; }
  }
</style>
