---
// METR time-horizon measurements (METR-Horizon-v1.1, results file fetched 2026-11-18).
// Each point: release date, 50% time horizon in minutes of human task time, 95% CI.
const pts = [
  { n: 'GPT-2', d: '2019-02-14', m: 0.054, lo: 0.01, hi: 0.14 },
  { n: 'GPT-3', d: '2020-05-28', m: 0.144, lo: 0.093, hi: 0.22 },
  { n: 'GPT-3.5', d: '2022-03-15', m: 0.6, lo: 0.26, hi: 1.12 },
  { n: 'GPT-4', d: '2023-03-14', m: 3.99, lo: 1.93, hi: 8.0 },
  { n: 'GPT-4o', d: '2024-05-13', m: 6.99, lo: 4.0, hi: 12.9 },
  { n: 'Claude 3.5 Sonnet', d: '2024-06-20', m: 11.4, lo: 5.5, hi: 22.4 },
  { n: 'o1-preview', d: '2024-09-12', m: 20.3, lo: 11.7, hi: 33.4 },
  { n: 'o1', d: '2024-12-05', m: 38.8, lo: 21.2, hi: 65.0 },
  { n: 'Claude 3.7 Sonnet', d: '2025-02-24', m: 60.4, lo: 33.0, hi: 104.2 },
  { n: 'o3', d: '2025-04-16', m: 119.7, lo: 74.6, hi: 190.9 },
  { n: 'GPT-5', d: '2025-08-07', m: 203.0, lo: 112.6, hi: 405.6 },
  { n: 'Claude Opus 4.5', d: '2025-11-24', m: 293.0, lo: 161.7, hi: 623.7 },
  { n: 'GPT-5.2', d: '2025-12-11', m: 352.2, lo: 198.1, hi: 815.2 },
  { n: 'Claude Opus 4.6', d: '2026-02-05', m: 718.8, lo: 316.7, hi: 3633.8 },
  { n: 'Claude Mythos Preview', d: '2026-04-07', m: 1044.8, lo: 508.9, hi: 3304.3 },
];
---
<figure class="widget hz" data-hz data-pts={JSON.stringify(pts)}>
  <div class="top">
    <div class="seg" role="group" aria-label="Vertical scale">
      <button type="button" data-scale="lin" aria-pressed="true">Linear scale</button>
      <button type="button" data-scale="log" aria-pressed="false">Log scale</button>
    </div>
  </div>
  <svg data-chart role="img" aria-label="Chart: the length of task frontier models can complete half the time, by model release date, 2019 to 2026"></svg>
  <label class="scrub">
    <span>Step through the models</span>
    <input type="range" min="0" max={pts.length - 1} value={pts.length - 1} step="1" data-pick />
  </label>
  <dl class="stats">
    <div><dt>Model</dt><dd data-name class="nm"></dd></div>
    <div><dt>Released</dt><dd data-date></dd></div>
    <div><dt>Finishes half of tasks that take a person</dt><dd data-h></dd></div>
  </dl>
  <p class="say" data-say aria-live="polite"></p>
  <figcaption class="caption">
    Data: <a href="https://metr.org/time-horizons/">METR time horizons</a>, state-of-the-art models only, with 95% intervals. Task length is how long the task takes a skilled person, not how long the agent runs. Dotted: METR’s fitted doubling time of 129 days.
    METR calls estimates above 16 hours unreliable and stopped updating in September 2026, so nothing newer is plotted.
  </figcaption>
</figure>
<style>
  svg { display: block; width: 100%; height: 300px; margin: 0.9rem 0 0.4rem; overflow: visible; }
  .scrub { display: grid; gap: 0.2rem; color: var(--muted); }
  .scrub input { width: 100%; accent-color: var(--accent); }
  .nm { font-size: 0.95rem !important; }
  .say { min-height: 3em; }
</style>
<script>
  type P = { n: string; d: string; m: number; lo: number; hi: number };
  const NS = 'http://www.w3.org/2000/svg';
  const el = (tag: string, attrs: Record<string, string | number>, text?: string) => {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (text != null) e.textContent = text;
    return e;
  };
  const human = (m: number) => (m < 1 ? `${Math.round(m * 60)} seconds` : m < 90 ? `${Math.round(m)} minutes` : `${(m / 60).toFixed(m < 600 ? 1 : 0)} hours`);
  const short = (m: number) => (m < 1 ? `${Math.round(m * 60)} s` : m < 90 ? `${Math.round(m)} min` : `${(m / 60).toFixed(m < 600 ? 1 : 0)} h`);
  const what = (m: number) =>
    m < 1 ? 'Completing a line. You wrote the program; it guessed the next few tokens.'
    : m < 10 ? 'A function. You said which file and what to change, then stitched the pieces together yourself.'
    : m < 45 ? 'A small bug fix with the right files already open. Still a tool you operate.'
    : m < 150 ? 'A feature in one sitting. This is where handing over a task and walking away starts to work.'
    : m < 480 ? 'Half a working day of someone’s time in one request. You stop reading every line and start checking results.'
    : 'More than a working day of a person’s time in one request, at even odds. Read the interval, though: the measurement is running out of long enough tasks.';

  document.querySelectorAll<HTMLElement>('[data-hz]').forEach((root) => {
    const pts: P[] = JSON.parse(root.dataset.pts!);
    const svg = root.querySelector('[data-chart]') as SVGSVGElement;
    const pick = root.querySelector('[data-pick]') as HTMLInputElement;
    const t0 = Date.parse('2019-01-01'), t1 = Date.parse('2026-12-31');
    let scale = 'lin';
    const draw = () => {
      const W = Math.max(svg.clientWidth, 280), H = 300, L = 46, R = 10, T = 12, B = 26;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.replaceChildren();
      const x = (d: string | number) => L + ((typeof d === 'number' ? d : Date.parse(d)) - t0) / (t1 - t0) * (W - L - R);
      const top = 24 * 60;
      const y = (m: number) => {
        const c = Math.min(m, scale === 'log' ? 6000 : top);
        return scale === 'log'
          ? H - B - (Math.log10(Math.max(c, 0.03)) - Math.log10(0.03)) / (Math.log10(6000) - Math.log10(0.03)) * (H - T - B)
          : H - B - (c / top) * (H - T - B);
      };
      const ticks = scale === 'log' ? [[0.1, '6 s'], [1, '1 min'], [10, '10 min'], [60, '1 h'], [480, '8 h'], [2880, '2 days']] : [[0, '0'], [240, '4 h'], [480, '8 h'], [960, '16 h'], [1440, '24 h']];
      for (const [m, label] of ticks as [number, string][]) {
        svg.append(el('line', { x1: L, x2: W - R, y1: y(m), y2: y(m), stroke: 'var(--rule)', 'stroke-width': 1 }));
        svg.append(el('text', { x: L - 6, y: y(m) + 4, 'text-anchor': 'end', 'font-size': 10.5, fill: 'var(--muted)' }, label));
      }
      for (let yr = 2019; yr <= 2026; yr++) {
        if (W < 420 && yr % 2 === 0) continue;
        svg.append(el('text', { x: x(`${yr}-07-01`), y: H - 8, 'text-anchor': 'middle', 'font-size': 10.5, fill: 'var(--muted)' }, String(yr)));
      }
      // 16-hour reliability line
      svg.append(el('line', { x1: L, x2: W - R, y1: y(960), y2: y(960), stroke: 'var(--blue)', 'stroke-width': 1.2, 'stroke-dasharray': '4 4' }));
      svg.append(el('text', { x: L + 6, y: y(960) + 13, 'font-size': 10, fill: 'var(--blue)' }, W < 420 ? 'unreliable above 16 h' : 'above this line METR calls it unreliable'));
      // Trend since 2023: doubling every 128.7 days, anchored on GPT-4 to Mythos Preview fit.
      const a = pts[3], k = Math.log(2) / (128.7 * 864e5);
      const anchor = Math.exp((Math.log(pts[12].m) - k * (Date.parse(pts[12].d) - Date.parse(a.d))));
      const trend: string[] = [];
      for (let t = Date.parse('2023-01-01'); t <= Date.parse('2026-06-01'); t += 20 * 864e5) {
        const m = anchor * Math.exp(k * (t - Date.parse(a.d)));
        if (m > (scale === 'log' ? 6000 : top)) break;
        trend.push(`${x(t).toFixed(1)},${y(m).toFixed(1)}`);
      }
      svg.append(el('polyline', { points: trend.join(' '), fill: 'none', stroke: 'var(--muted)', 'stroke-width': 1.2, 'stroke-dasharray': '2 4' }));
      const sel = Number(pick.value);
      pts.forEach((p, i) => {
        const cx = x(p.d), on = i === sel;
        svg.append(el('line', { x1: cx, x2: cx, y1: y(p.hi), y2: y(p.lo), stroke: on ? 'var(--accent)' : 'var(--rule)', 'stroke-width': on ? 2 : 1.5, 'stroke-linecap': 'round' }));
      });
      svg.append(el('polyline', { points: pts.map((p) => `${x(p.d).toFixed(1)},${y(p.m).toFixed(1)}`).join(' '), fill: 'none', stroke: 'var(--ink)', 'stroke-width': 1.5, 'stroke-linejoin': 'round' }));
      pts.forEach((p, i) => {
        const on = i === sel;
        const c = el('circle', { cx: x(p.d), cy: y(p.m), r: on ? 6 : 3.5, fill: on ? 'var(--accent)' : 'var(--ink)', stroke: 'var(--card)', 'stroke-width': 1.5 });
        c.style.cursor = 'pointer';
        c.addEventListener('click', () => { pick.value = String(i); update(); });
        svg.append(c);
      });
      const p = pts[sel];
      const lx = x(p.d), anchorEnd = lx > W * 0.55;
      svg.append(el('text', { x: lx + (anchorEnd ? -10 : 10), y: Math.max(y(p.m) - 10, 14), 'text-anchor': anchorEnd ? 'end' : 'start', 'font-size': 11.5, 'font-weight': 600, fill: 'var(--ink)' }, `${p.n}: ${human(p.m)}`));
    };
    const update = () => {
      const p = pts[Number(pick.value)];
      pick.setAttribute('aria-valuetext', `${p.n}, ${human(p.m)}`);
      root.querySelector('[data-name]')!.textContent = p.n;
      root.querySelector('[data-date]')!.textContent = new Date(p.d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
      root.querySelector('[data-h]')!.textContent = `${human(p.m)} (${short(p.lo)} to ${short(p.hi)})`;
      root.querySelector('[data-say]')!.textContent = what(p.m);
      draw();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-scale]').forEach((b) =>
      b.addEventListener('click', () => {
        scale = b.dataset.scale!;
        root.querySelectorAll('[data-scale]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        draw();
      }),
    );
    pick.addEventListener('input', update);
    new ResizeObserver(draw).observe(svg);
    update();
  });
</script>
