---
// A margin note: sits beside the text on wide screens, inline on phones.
// `href` turns it into a "go deeper" door into the reference.
import { url } from '../lib/nav';
interface Props { href?: string; label?: string }
const { href, label = 'Go deeper' } = Astro.props;
const link = href ? (href.startsWith('http') ? href : url(href)) : undefined;
---
<aside class="note">
  <slot />
  {link && <a class="door" href={link}>{label} <span aria-hidden="true">→</span></a>}
</aside>
<style>
  .note {
    font-family: var(--mono); font-size: 0.74rem; line-height: 1.55; color: var(--muted);
    border-left: 2px solid var(--rule); padding: 0.1rem 0 0.1rem 0.8rem; margin: 1.25rem 0;
  }
  .note :global(strong) { color: var(--ink-2); }
  .door { display: inline-block; margin-top: 0.4rem; color: var(--accent); text-decoration: none; font-weight: 600; }
  .door:hover { text-decoration: underline; }
  @media (min-width: 70rem) {
    .note { float: right; clear: right; width: 15rem; margin: 0.35rem -18rem 1rem 0; }
  }
</style>
