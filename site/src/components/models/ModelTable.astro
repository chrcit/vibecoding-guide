---
// The current models of one lab, as a table. Every cell is a sourced fact or an honest gap.
// Rows come from models.ts, so a new model shows up here with no page edit.
import Val from './Val.astro';
import { fid, getModel, indexScore, type ModelId } from './view';
import { url } from '../../lib/nav';

interface Props { ids: ModelId[] }
const { ids } = Astro.props;
---
<table class="model-table">
  <thead>
    <tr>
      <th scope="col">Model</th>
      <th scope="col">Released</th>
      <th scope="col">In / out, per million tokens</th>
      <th scope="col">Context</th>
      <th scope="col">Index score</th>
    </tr>
  </thead>
  <tbody>
    {ids.map((id) => {
      const m = getModel(id);
      const s = indexScore(id);
      return (
        <tr>
          <th scope="row"><a href={url(`models/${id}/`)}>{m.name}</a></th>
          <td class="nw"><Val id={fid(id, 'released')} /></td>
          <td><span class="nw"><Val id={fid(id, 'price.input')} /> / <Val id={fid(id, 'price.output')} /></span>{m.price?.longPrompt && <span class="tier"> for prompts up to <Val id={fid(id, 'price.longPrompt.threshold')} /></span>}</td>
          <td class="nw"><Val id={fid(id, 'context')} /></td>
          <td class="nw">{s ? <><Val id={s.factId} />{s.effort && <span class="tier"> at {s.effort}</span>}</> : <span class="gap">not measured</span>}</td>
        </tr>
      );
    })}
  </tbody>
</table>

<style>
  .model-table th, .model-table td { min-width: 0; padding-right: 1.1em; }
  .model-table th[scope='row'] { font-weight: 560; }
  .model-table thead th { white-space: normal; vertical-align: bottom; }
  .nw { white-space: nowrap; }
  .tier, .gap { color: var(--muted); }
  .tier { font-size: var(--text-s); }
  .gap { font-style: italic; }
</style>
