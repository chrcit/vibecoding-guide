---
// Review page for the home page figures (1, 5, 6 and 7). Routed at /dev/fig-home/ in `pnpm dev`.
// Fig. 7 gets the real METR data from src/data/, as the home page does.
import Base from '../layouts/Base.astro';
import ThreeAgents from '../components/fig/three-agents/ThreeAgents.astro';
import SteerOrQueue from '../components/fig/steer-or-queue/SteerOrQueue.astro';
import Bottleneck from '../components/fig/bottleneck/Bottleneck.astro';
import Horizon from '../components/fig/horizon/Horizon.astro';
import { horizonInputs, horizonSource } from '../components/home/horizon-data';
---
<Base title="Home figures" description="Development-only review page for the home page figures." noindex>
  <div class="fig-review">
    <h1>Home figures</h1>
    <p>Figures 1, 5, 6 and 7 as the home page uses them.</p>
    <ThreeAgents />
    <SteerOrQueue />
    <Bottleneck />
    <Horizon {...horizonInputs} source={horizonSource} />
  </div>
</Base>

<style>
  .fig-review { max-width: 60rem; margin: 2rem auto 4rem; padding: 0 var(--gutter); }
  h1 { margin: 0 0 0.5rem; }
  p { color: var(--muted); margin: 0; }
</style>
