---
// Review page for the context explainer's figures, Fig. 3 and Fig. 4. Routed at /dev/fig-context/
// in `pnpm dev`. Both figures read their numbers from src/data/, as on the page.
import Base from '../layouts/Base.astro';
import WindowFills from '../components/fig/window-fills/WindowFills.astro';
import SamePrompt from '../components/fig/same-prompt/SamePrompt.astro';
import { models } from '../data/models';
import { harnesses } from '../data/harnesses';

const windowTokens = models['claude-opus-5-5'].context.value;
const compactAt = harnesses.claudeCode.autoCompactAt.value;
---
<Base title="Figures: context" description="Development-only review page for Fig. 3 and Fig. 4." noindex>
  <div class="fig-review">
    <h1>Figures: context</h1>
    <p>Fig. 3 and Fig. 4 as they appear on the context explainer. The window size and compaction point are sourced; the step sizes in Fig. 3 and the two outcomes in Fig. 4 are illustrative.</p>
    <WindowFills
      windowTokens={windowTokens}
      compactAt={compactAt}
      source={{ label: 'Window and compaction point: Claude Code docs. Step sizes are illustrative.', href: 'https://code.claude.com/docs/en/model-config' }}
    />
    <SamePrompt />
  </div>
</Base>

<style>
  .fig-review { max-width: 46rem; margin: 2rem auto 4rem; padding: 0 var(--gutter); }
  h1 { margin: 0 0 0.5rem; }
  p { color: var(--muted); margin: 0; }
</style>
