---
// Review page for the figures of /explain/plans-and-api/: Fig. 8 and Fig. 9 with the real data the page
// uses. Routed at /dev/fig-plans/ in `pnpm dev`, or in a build with ACG_DEV_PAGES=1.
import Base from '../layouts/Base.astro';
import MeterTank from '../components/fig/meter-tank/MeterTank.astro';
import PlanRuns from '../components/fig/plan-runs/PlanRuns.astro';
import { planRunsFromData } from '../components/fig/plan-runs/from-data';
import { plans } from '../data/plans';
import { links } from '../data/links';

const pro = plans.claude.pro.price.value;
---
<Base title="Figures for plans against the API" description="Development-only review page for Fig. 8 and Fig. 9." noindex>
  <div class="fig-review">
    <h1>Plans against the API: figures</h1>
    <p>Fig. 8 and Fig. 9 as they appear on the page, fed from src/data/.</p>
    <MeterTank currency="$" planPricePerMonth={pro} windowHours={plans.claude.limits.windowHours.value} source={{ label: links.claudeLimits.label, href: links.claudeLimits.url }} />
    <PlanRuns {...planRunsFromData()} source={{ label: `${links.claudePricing.label} and ${links.codexPricing.label}`, href: links.claudePricing.url }} />
  </div>
</Base>

<style>
  .fig-review { max-width: 46rem; margin: 2rem auto 4rem; padding: 0 var(--gutter); }
  h1 { margin: 0 0 0.5rem; }
  p { color: var(--muted); margin: 0; }
</style>
