---
// Review page for the model figures, Fig. 60 and Fig. 11. Routed at /dev/fig-models/ in `pnpm dev`.
// Unlike the illustrative values on /dev/figures/, these are the real props from src/data/, so the
// review shows exactly what the models page shows.
import Base from '../layouts/Base.astro';
import '../styles/board.css';
import ModelLab from '../components/fig/model-lab/ModelLab.astro';
import { labModels } from '../components/models/lab-data';
import EffortDial from '../components/fig/effort-dial/EffortDial.astro';
import { effortInputs } from '../components/models/view';
import { url } from '../lib/nav';
import { links } from '../data/links';

const aa = { label: 'Artificial Analysis, Intelligence Index, read 18 November 2026', href: links.artificialAnalysis.url };
---
<Base title="Model figures" description="Development-only review page for Fig. 60 and Fig. 11." noindex>
  <div class="fig-review">
    <h1>Model figures</h1>
    <p>Fig. 60 and Fig. 11 with the real values from src/data/, as the models page uses them.</p>
    <div class="board-grid"><ModelLab rows={labModels((id) => url(`models/${id}/`))} /></div>
    <EffortDial {...effortInputs()} source={{ ...aa, href: links.aaOpus.url }} />
  </div>
</Base>

<style>
  .fig-review { max-width: 46rem; margin: 2rem auto 4rem; padding: 0 var(--gutter); }
  h1 { margin: 0 0 0.5rem; }
  p { color: var(--muted); margin: 0; }
</style>
