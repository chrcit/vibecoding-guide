---
// The home board: the whole subject on one screen. One request through the six layers (Fig. 65),
// the loop on the three running examples (Fig. 66), a miniature per explainer, the first hour and
// the showcase as pictures, the facts behind it all. The reader level is chosen here and adds tiles.
// The long text of the old home page lives at /read/ and opens in the side view.
import Board from '../layouts/Board.astro';
import Tile from '../components/board/Tile.astro';
import Stat from '../components/board/Stat.astro';
import Explain from '../components/board/Explain.astro';
import Fact from '../components/data/Fact.astro';
import Verified from '../components/data/Verified.astro';
import LayerStack from '../components/fig/layer-stack/LayerStack.astro';
import Resend from '../components/fig/layer-stack/Resend.astro';
import LoopRun from '../components/fig/loop-run/LoopRun.astro';
import SteerOrQueue from '../components/fig/steer-or-queue/SteerOrQueue.astro';
import Horizon from '../components/fig/horizon/Horizon.astro';
import MiniContext from '../components/fig/minis/MiniContext.astro';
import MiniPlans from '../components/fig/minis/MiniPlans.astro';
import MiniQueue from '../components/fig/minis/MiniQueue.astro';
import MiniJudges from '../components/fig/minis/MiniJudges.astro';
import MiniSkills from '../components/fig/minis/MiniSkills.astro';
import MiniConnectors from '../components/fig/minis/MiniConnectors.astro';
import MiniVoice from '../components/fig/minis/MiniVoice.astro';
import MiniModels from '../components/fig/minis/MiniModels.astro';
import FirstHour from '../components/fig/home-tiles/FirstHour.astro';
import Showcase from '../components/fig/home-tiles/Showcase.astro';
import { horizonInputs, horizonSource, horizonFactIds } from '../components/home/horizon-data';
import { LEVELS, levelInfo } from '../lib/levels';
import { allFacts, dataFiles, formatDate, formatValue, fact } from '../lib/facts';
import { url } from '../lib/nav';

// Each layer of Fig. 65 opens its section of the long read.
// TODO wiki: interface, context-window, harness, model, permission-mode, parallel-work once the wiki is merged.
const layerHrefs = {
  interface: 'read/#interface', context: 'read/#context', harness: 'read/#harness',
  model: 'read/#model', governance: 'read/#governance', emergence: 'read/#emergence',
};

// The facts behind the site: every sourced entry that may be published.
const published = allFacts().filter((f) => f.status !== 'unverified');
const lastChecked = published.map((f) => f.verified).sort().at(-1)!;
const perFile = dataFiles
  .map((d) => ({ file: d.file, title: d.title, n: published.filter((f) => f.file === d.file).length }))
  .filter((d) => d.n > 0)
  .sort((a, b) => b.n - a.n);
const most = perFile[0]!.n;

const doubling = formatValue(fact('benchmarks.metr.doublingDays'));

const factIds = [
  'harnesses.claudeCode.contextFile', 'harnesses.codex.contextFile', 'harnesses.claudeCode.skills', 't3code.permissionModes',
  't3code.defaultMode', 't3code.worktrees', 'models.claude-opus-5-5.price.cacheRead', 'models.claude-opus-5-5.price.input',
  'plans.claude.limits.fiveHour', 'claims.research.speechFaster', ...horizonFactIds,
];
---
<Board
  title="One request through six layers"
  docTitle="One request through six layers · Agentic Coding Guide"
  description="Follow one request from your message to a changed file: the interface, the harness, the model, the tools, the project and the check."
  section="explain"
>
  <div slot="tools" class="home-tools">
    <div class="pick home-level" role="group" aria-label="Reader level" data-home-level>
      {LEVELS.map((id) => <button type="button" data-level-pick={id} aria-pressed={id === 'plain' ? 'true' : 'false'} title={levelInfo[id].description}>{levelInfo[id].label}</button>)}
    </div>
  </div>

  <Tile title="One request through six layers" span={8} id="lab" side="read/">
    <LayerStack hrefs={layerHrefs} />
    <Fragment slot="foot"><Explain to="read/#how-the-model-works">Modelled numbers</Explain></Fragment>
  </Tile>

  <Tile title="It goes round until a check passes" span={4} id="loop" side="read/#what-changed">
    <LoopRun />
  </Tile>

  <Tile title="A message mid-run can steer or wait" span={8} level="technical" side="read/#interface">
    <SteerOrQueue bare />
  </Tile>

  <Tile title="Where each layer lives" span={4} level="technical" side="read/#six-layers">
    <dl class="lives">
      <div><dt>Context</dt><dd><code><Fact id="harnesses.claudeCode.contextFile" /></code> <code><Fact id="harnesses.codex.contextFile" /></code></dd></div>
      <div><dt>Harness</dt><dd><code><Fact id="harnesses.claudeCode.skills" /></code></dd></div>
      <div><dt>Governance</dt><dd><Fact id="t3code.permissionModes" /></dd></div>
      <div><dt>Emergence</dt><dd>one <Explain to="t3-code/">worktree</Explain> per thread</dd></div>
    </dl>
  </Tile>

  <Tile title="Every call sends the whole window" span={7} level="engineer" side="read/#how-the-model-works">
    <Resend />
    <Fragment slot="foot">Cache reads on Opus 5.5: <Fact id="models.claude-opus-5-5.price.cacheRead" /> per million tokens, fresh input <Fact id="models.claude-opus-5-5.price.input" />.</Fragment>
  </Tile>

  <Tile title={`Task length doubles every ${doubling}`} span={5} level="engineer" side="models/">
    <Horizon {...horizonInputs} source={horizonSource} bare />
  </Tile>

  <Tile title="Build one thing in your first hour" span={6} id="start">
    <FirstHour />
  </Tile>

  <Tile title="What an agent built for this guide" span={6} id="showcase">
    <Showcase />
  </Tile>

  <Tile title="Every turn takes room" span={3}><MiniContext /></Tile>
  <Tile title="A plan runs dry, the API keeps counting" span={3}><MiniPlans /></Tile>
  <Tile title="More agents, a longer queue for you" span={3}><MiniQueue /></Tile>
  <Tile title="Each judge catches different mistakes" span={3}><MiniJudges /></Tile>
  <Tile title="A skill loads when the task matches" span={3}><MiniSkills /></Tile>
  <Tile title="A connector adds tools" span={3}><MiniConnectors /></Tile>
  <Tile title="Speaking carries more words" span={3}><MiniVoice /></Tile>
  <Tile title="Stricter success, shorter tasks" span={3}><MiniModels /></Tile>

  <Tile title="Every number links to its source" span={12} id="facts" side="sources/">
    <div class="facts">
      <dl class="stats facts-stats">
        <Stat name="Sourced facts"><a href={url('sources/')}>{published.length}</a></Stat>
        <Stat name="Last checked"><a href={url('sources/')}><time datetime={lastChecked}>{formatDate(lastChecked)}</time></a></Stat>
      </dl>
      <ul class="facts-files">
        {perFile.map((d) => (
          <li><a href={url(`sources/#file-${d.file}`)}><span class="ff-name">{d.title}</span><span class="ff-bar"><span style={`--w:${((d.n / most) * 100).toFixed(1)}%`}></span></span><span class="ff-n">{d.n}</span></a></li>
        ))}
      </ul>
    </div>
  </Tile>

  <Verified slot="foot" ids={factIds} />
</Board>

<style>
  .home-tools { display: flex; align-items: center; }
  .home-level button { min-width: 6.5rem; }

  /* A tile that a level adds arrives instead of popping in. */
  :global(.board-grid .tile[data-for-level]) { animation: tile-in 420ms var(--ease-out) both; }
  @keyframes tile-in { from { opacity: 0; transform: translateY(10px) scale(0.99); } }
  @media (prefers-reduced-motion: reduce) { :global(.board-grid .tile[data-for-level]) { animation: none; } }

  .lives { display: grid; gap: 0; margin: 0; }
  .lives div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.75rem; padding: 0.625rem 0; border-bottom: 1px solid var(--rule); }
  .lives div:last-child { border-bottom: 0; }
  .lives dt { color: var(--muted); font-size: var(--text-s); }
  .lives dd { margin: 0; color: var(--ink); font-size: var(--text-s); overflow-wrap: anywhere; }
  .lives code { font-size: 0.875rem; margin-right: 0.375rem; }

  .facts { display: grid; grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr); gap: 1rem 2rem; align-items: center; }
  @media (max-width: 760px) { .facts { grid-template-columns: minmax(0, 1fr); } }
  .facts-stats { grid-template-columns: 1fr 1fr; }
  .facts-stats a { color: inherit; text-decoration: none; }
  .facts-stats a:hover { color: var(--accent); }
  .facts-files { display: grid; grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr)); gap: 0.25rem 1.5rem; margin: 0; padding: 0; list-style: none; max-width: none; }
  .facts-files li { max-width: none; }
  .facts-files a { display: grid; grid-template-columns: 13rem minmax(0, 1fr) 2.5rem; align-items: center; gap: 0.625rem; min-height: 2.25rem; color: var(--ink-2); text-decoration: none; font-size: var(--text-s); }
  .ff-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ff-bar { height: 0.5rem; border-radius: 999px; background: var(--paper-2); overflow: hidden; }
  .ff-bar span { display: block; height: 100%; width: var(--w); background: color-mix(in oklab, var(--ink) 35%, var(--card)); border-radius: inherit; }
  .ff-n { font-family: var(--mono); text-align: right; color: var(--ink); }
  .facts-files a:hover { color: var(--accent); }
  .facts-files a:hover .ff-bar span { background: var(--accent); }
</style>

<script>
  import { LEVEL_EVENT, getLevel, isLevel } from '../lib/levels';

  const group = document.querySelector<HTMLElement>('[data-home-level]');
  if (group) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-level-pick]')];
    const mark = (level: string) => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.levelPick === level)));
    buttons.forEach((b) => b.addEventListener('click', () => {
      const level = b.dataset.levelPick;
      if (!isLevel(level)) return;
      const api = (window as unknown as { acgLevel?: { set: (l: string) => void } }).acgLevel;
      api?.set(level);
      mark(level);
    }));
    document.addEventListener(LEVEL_EVENT, (event) => mark((event as CustomEvent).detail));
    mark(getLevel());
  }
</script>
