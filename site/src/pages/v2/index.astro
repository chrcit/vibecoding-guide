---
/*
  Guide v2: a drawing of T3 Code that plays the lessons. The page is full-height app chrome: the
  site header is left out (Base `bare`) and its nav lives in the menu at the top of the sidebar.
  The sidebar is the table of contents, drawn like T3 Code's sidebar with project folders: a
  chapter is a project, a lesson is a thread. The chat column shows the lesson as a thread: each
  part is one turn (the request, the work log as it grows, the reply), and the lesson controls sit
  where the composer would be, with the current point's words in them. The browser panel on the
  right has two tabs: Explainer, the picture of what happens at each point, and Preview, the app the
  agent builds (only in lessons that build one). On a phone the list and the thread are two screens
  and the browser opens as a sheet. Every turn is in the HTML; v2/player.ts moves through the parts
  and points. Brief: planning/guide-v2/BRIEF.md. Notes: planning/guide-v2/NOTES.md.
*/
import Base from '../../layouts/Base.astro';
import '../../components/fig/fig.css';
import '../../styles/journey.css';
import '../../styles/v2.css';
import '../../styles/v2-stops.css';
import { TOC, MODEL, worked, type Lv } from '../../v2/content';
import { LESSONS } from '../../v2/lessons';
import { lvHtml } from '../../v2/html';
import { kindOf } from '../../v2/ui/summary';
import { poster } from '../../journey/picture';
import { fact, anchor } from '../../lib/facts';
import { sections, url } from '../../lib/nav';
import { LEVELS, levelInfo } from '../../lib/levels';
import { t3code } from '../../data/t3code';

const [ctxTitle, ctxUsed] = t3code.screen.contextWindow.value;
// Lessons 14 and 17: Usage limits in the thread details, and the "Run on" picker under the composer.
const [limitsTitle, limitRow] = t3code.screen.usageLimits.value;
const runOn = t3code.screen.runOn.value;
const filterLabel = t3code.screen.filter.value;
const [searchProjects, allProjects, noProjects] = t3code.screen.filterMenu.value;
const [searchPlaceholder, searchLabel, noThreads] = t3code.screen.search.value;
const permLabel = t3code.screen.permissionChip.value;
/** Lesson 7: the approval row's words (t3code.approvalRow). */
const approvalWords = t3code.approvalRow.value;
const [workingFor, workingPlain] = t3code.screen.workingFor.value;
const lv = (t: Lv) => lvHtml(t);
/** The first work-log row of every turn: T3 Code's row for a skill, naming this guide's. */
const skill = t3code.screen.skillRow.value.replace('{name}', 'agentic-guide');
const firstPart = LESSONS.l1!.parts[0]!;
// Chapter 3: the subagent group row and each subagent's status words (t3code.screen.subagents, subagentStates, subagentRow).
const subsLabel = (count: number) => t3code.screen.subagents.value[0].replace('{n}', String(count));
const [subWorking, subDone, subFailed] = t3code.screen.subagentStates.value;
const [rowRunning, rowCompleted, rowFailed] = t3code.screen.subagentRow.value;
const fav = (n?: number) => (n ? String(n) : 'S');
// Lessons 3 and 4: T3 Code's words for the queued message, the goal line and the workspace.
const [sendNow, editQueued, removeQueued] = t3code.screen.queued.value;
const goalClear = t3code.screen.goalLine.value[3];

// The site's nav, as the site header shows it (components/site/Header.astro).
const navItems = sections.filter((s) => s.ready);
const hasSources = Object.keys(import.meta.glob('../sources/index.astro')).length > 0;
const repo = 'https://github.com/chrcit/vibecoding-guide';

// Icons drawn after lucide's (the set T3 Code uses), as plain inline SVG.
const svg = (d: string, w = 16, extra = '') => `<svg viewBox="0 0 24 24" width="${w}" height="${w}" aria-hidden="true" focusable="false"${extra}>${d}</svg>`;
const ln = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const icon = {
  listFilter: svg(`<path ${ln} d="M3 6h18M7 12h10M10 18h4"/>`),
  search: svg(`<circle ${ln} cx="11" cy="11" r="8"/><path ${ln} d="m21 21-4.3-4.3"/>`),
  x: svg(`<path ${ln} d="M18 6 6 18M6 6l12 12"/>`, 12),
  chevDown: svg(`<path ${ln} d="m6 9 6 6 6-6"/>`, 12),
  chevsUpDown: svg(`<path ${ln} d="m7 15 5 5 5-5M7 9l5-5 5 5"/>`, 14),
  chevUp: svg(`<path ${ln} d="m18 15-6-6-6 6"/>`, 14),
  prev: svg(`<path ${ln} d="m15 18-6-6 6-6"/>`, 18),
  next: svg(`<path ${ln} d="m9 18 6-6-6-6"/>`, 18),
  play: svg('<path fill="currentColor" d="M8 5.6v12.8a1 1 0 0 0 1.52.85l10.4-6.4a1 1 0 0 0 0-1.7L9.52 4.75A1 1 0 0 0 8 5.6Z"/>', 16, ' class="i-play"')
    + svg('<rect fill="currentColor" x="6.5" y="5" width="4" height="14" rx="1.2"/><rect fill="currentColor" x="13.5" y="5" width="4" height="14" rx="1.2"/>', 16, ' class="i-pause"'),
  back: svg(`<path ${ln} d="m15 18-6-6 6-6"/>`, 20),
  menu: svg(`<path ${ln} d="M4 6h16M4 12h16M4 18h16"/>`, 18),
  details: svg(`<circle ${ln} cx="12" cy="12" r="9"/><path ${ln} d="M12 16v-4M12 8h.01"/>`),
  copy: svg(`<rect ${ln} x="8" y="8" width="14" height="14" rx="2"/><path ${ln} d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>`, 14),
  close: svg(`<path ${ln} d="M18 6 6 18M6 6l12 12"/>`, 18),
  reload: svg(`<path ${ln} d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path ${ln} d="M21 3v5h-5"/>`, 14),
  picture: svg(`<rect ${ln} x="3" y="3" width="18" height="18" rx="2"/><circle ${ln} cx="9" cy="9" r="2"/><path ${ln} d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>`, 14),
  globe: svg(`<circle ${ln} cx="12" cy="12" r="10"/><path ${ln} d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/>`, 14),
  paperclip: svg(`<path ${ln} d="m21.4 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>`, 14),
  external: svg(`<path ${ln} d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>`, 14),
  check: svg(`<path ${ln} d="M20 6 9 17l-5-5"/>`, 14),
  contrast: svg(`<circle ${ln} cx="12" cy="12" r="10"/><path fill="currentColor" d="M12 2a10 10 0 0 1 0 20Z"/>`),
  machine: svg(`<rect ${ln} x="2" y="3" width="20" height="14" rx="2"/><path ${ln} d="M8 21h8M12 17v4"/>`, 14),
  file: svg(`<path ${ln} d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path ${ln} d="M14 2v4a2 2 0 0 0 2 2h4"/>`, 14),
  // The work log's row icons: search, read, change, run, and the skill row.
  kind: {
    search: svg(`<circle ${ln} cx="11" cy="11" r="8"/><path ${ln} d="m21 21-4.3-4.3"/>`),
    read: svg(`<path ${ln} d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path ${ln} d="M14 2v4a2 2 0 0 0 2 2h4M10 9H8M16 13H8M16 17H8"/>`),
    change: svg(`<path ${ln} d="M12 20h9"/><path ${ln} d="M16.38 3.62a1 1 0 0 1 3 3L7.37 18.64a2 2 0 0 1-.85.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.85Z"/>`),
    run: svg(`<path ${ln} d="m4 17 6-6-6-6M12 19h8"/>`),
    // Chapter 3: a delegate_task row, drawn with the subagent icon (lucide's Bot).
    delegate: svg(`<path ${ln} d="M12 8V4H8"/><rect ${ln} width="16" height="12" x="4" y="8" rx="2"/><path ${ln} d="M2 14h2M20 14h2M15 13v2M9 13v2"/>`),
  } as Record<string, string>,
  // Chapter 3: subagents (lucide's Bot).
  bot: svg(`<path ${ln} d="M12 8V4H8"/><rect ${ln} width="16" height="12" x="4" y="8" rx="2"/><path ${ln} d="M2 14h2M20 14h2M15 13v2M9 13v2"/>`, 14),
  skill: svg(`<path ${ln} d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.13-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.13a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.13 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.13a.5.5 0 0 1-.96 0Z"/>`),
  failed: svg(`<path ${ln} d="M18 6 6 18M6 6l12 12"/>`, 12),
  shield: svg(`<path ${ln} d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`, 12),
  passed: svg(`<path ${ln} d="M20 6 9 17l-5-5"/>`, 12),
  // Lessons 3 and 4: the goal line's target, and the queued message's controls.
  target: svg(`<circle ${ln} cx="12" cy="12" r="10"/><circle ${ln} cx="12" cy="12" r="6"/><circle ${ln} cx="12" cy="12" r="2"/>`, 14),
  arrowUp: svg(`<path ${ln} d="m5 12 7-7 7 7M12 19V5"/>`, 12),
  pencil: svg(`<path ${ln} d="M21.17 6.81a1 1 0 0 0-3.99-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5zM15 5l4 4"/>`, 12),
};
/** A work-log row as markup, for the rows of an earlier turn still running (lesson 4). */
const rowHtml = (r: { at: number; label: Lv; detail?: Lv; tone?: 'bad' | 'ok' }) => {
  const k = kindOf(r as never);
  const mark = r.tone === 'bad' ? `<span class="v2-wmark">${icon.failed}<span class="visually-hidden">failed</span></span>` : r.tone === 'ok' ? `<span class="v2-wmark">${icon.passed}<span class="visually-hidden">passed</span></span>` : '';
  return `<li class="v2-wrow v2-logrow" data-run-at="${r.at}" data-kind="${k}"${r.tone ? ` data-tone="${r.tone}"` : ''}><span class="v2-wicon">${icon.kind[k]}</span><span class="v2-wbody"><span class="v2-wline"><span class="v2-wlabel">${lv(r.label)}</span>${mark}</span>${r.detail ? `<span class="v2-wdetail">${lv(r.detail)}</span>` : ''}</span></li>`;
};
// The site's own mark (components/site/Header.astro), small.
const mark = `<svg class="v2-mark" viewBox="0 0 32 32" width="18" height="18" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8" class="v2-mark-bg"/><path d="M9 21.5 16 9l7 12.5" fill="none" class="v2-mark-line" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="16" cy="21.5" r="2.5" class="v2-mark-dot"/></svg>`;
---
<Base title="Guide v2 · Agentic Coding Guide" description="The guide as a drawing of T3 Code: every lesson is a thread, every part a turn, with the picture and the app in a browser panel beside it." section="v2" bare>
  <div class="v2" data-v2 data-view="list" data-base={url('')}>
    <aside class="v2-side" aria-label="Lessons">
      <div class="v2-side-top">
        <button type="button" class="v2-brand" data-guide-menu-btn data-align="start" aria-haspopup="menu" aria-expanded="false" aria-controls="v2-guide-menu">
          <Fragment set:html={mark} />
          <span class="v2-brand-name">Agentic Coding <span>Guide</span></span>
          <Fragment set:html={icon.chevsUpDown} />
        </button>
      </div>

      <div class="v2-side-tools">
        <div class="v2-search">
          <Fragment set:html={icon.search} />
          <input type="search" placeholder={searchPlaceholder} aria-label={searchLabel} autocomplete="off" spellcheck="false" data-side-search />
          <button type="button" class="v2-search-clear" aria-label="Clear the search" data-search-clear hidden set:html={icon.x} />
        </div>
        <div class="v2-filter">
          <button type="button" class="v2-side-icon" data-filter-btn aria-expanded="false" aria-controls="v2-filter-pop" aria-label={filterLabel} title={filterLabel}>
            <span class="v2-filter-icon" data-filter-icon set:html={icon.listFilter} />
          </button>
          <div class="v2-pop v2-filter-pop" id="v2-filter-pop" data-filter-pop hidden>
            <div class="v2-pop-search">
              <Fragment set:html={icon.search} />
              <input type="search" placeholder={searchProjects} aria-label={searchProjects.replace(/\.+$/, '')} autocomplete="off" data-filter-q />
            </div>
            <ul role="listbox" aria-label="Projects" data-filter-list>
              <li><button type="button" role="option" data-scope="all" aria-selected="true"><span class="v2-fav v2-fav-all" aria-hidden="true" set:html={icon.file} /><span>{allProjects}</span></button></li>
              {TOC.map((c) => (
                <li><button type="button" role="option" data-scope={c.id} aria-selected="false"><span class="v2-fav" aria-hidden="true">{fav(c.n)}</span><span>{c.title}</span></button></li>
              ))}
            </ul>
            <p class="v2-pop-empty" data-filter-empty hidden>{noProjects}</p>
          </div>
        </div>
      </div>

      <nav class="v2-toc" aria-label="Table of contents" data-toc>
        <ul class="v2-tree">
          {TOC.map((c) => (
            <li class="v2-folder" data-project={c.id}>
              <button type="button" class="v2-folder-head" aria-expanded="true" aria-controls={`v2-f-${c.id}`} data-folder-toggle>
                <span class="v2-fav" aria-hidden="true">{fav(c.n)}</span>
                <span class="v2-folder-name">{c.title}</span>
                <span class="v2-folder-count" data-folder-count><span class="visually-hidden">, </span>{c.lessons.length}<span class="visually-hidden"> lessons hidden</span></span>
                <span class="v2-folder-chev" set:html={icon.chevDown} />
              </button>
              <ol class="v2-rows-list" id={`v2-f-${c.id}`}>
                {c.lessons.map((l) => (
                  <li id={l.id} data-row-item>
                    <a class="v2-row" href={`#${l.id}`} data-lesson={l.id} data-plays={l.plays ? '' : undefined}>
                      <span class="v2-row-title">{l.title}</span>
                      <span class="v2-status" data-status></span>
                    </a>
                    {l.plays && <ol class="v2-threads" data-threads={l.id} aria-label={`Threads in ${l.title}`} hidden></ol>}
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ul>
        <p class="v2-toc-empty" role="status" data-search-empty hidden>{noThreads}</p>
      </nav>
    </aside>

    <div class="v2-main" data-main>
      <section class="v2-chat" data-chat aria-label="Lesson thread">
        <header class="v2-head">
          <a class="v2-head-btn v2-to-list" href="#" data-to-list aria-label="All lessons" set:html={icon.back} />
          <p class="v2-crumb" aria-label="Thread breadcrumb"><span class="v2-fav v2-fav-s" aria-hidden="true" data-crumb-fav>1</span><span class="v2-crumb-project" data-crumb-project>Hand it over</span><span class="v2-sep" aria-hidden="true">/</span><b data-crumb-thread>Say what you want</b></p>
          <span class="v2-ex" title="A drawing of T3 Code, not the app">example</span>
          <div class="v2-details" data-ui="context" hidden>
            <button type="button" class="v2-head-btn v2-details-btn" data-details-btn aria-expanded="false" aria-controls="v2-details-pop" aria-label="Thread details"><Fragment set:html={icon.details} /><span class="v2-details-val" data-ctx-short></span></button>
            <div class="v2-pop v2-details-pop" id="v2-details-pop" data-details-pop hidden>
              <div data-ctx-sec>
                <p class="v2-pop-title">{ctxTitle} <span class="v2-ex">example</span></p>
                <div class="v2-meter" aria-hidden="true"><span data-ctx-bar></span></div>
                <p class="v2-pop-val" data-ctx-text data-tpl={ctxUsed}></p>
              </div>
              <div class="v2-limits" data-limits data-tpl={limitRow} hidden>
                <p class="v2-pop-title">{limitsTitle} <span class="v2-ex">example</span></p>
                <ul data-limit-rows></ul>
              </div>
            </div>
          </div>
          <button type="button" class="v2-head-btn v2-head-menu" data-guide-menu-btn data-align="end" aria-haspopup="menu" aria-expanded="false" aria-controls="v2-guide-menu" aria-label="Guide menu" set:html={icon.menu} />
        </header>

        <div class="v2-scroll" data-scroll>
          <div class="v2-thread">
            {Object.values(LESSONS).map((lesson) => lesson.parts.map((part, i) => (
              <article class="v2-turn" data-turn data-lesson={lesson.id} data-part={i} aria-label={`Part ${i + 1}: ${part.title}`}>
                <div class="v2-turn-head">
                  <p class="v2-part-n">Part {i + 1} of {lesson.parts.length}{part.fresh && !part.resumes && <span> · {t3code.screen.newThread.value}</span>}</p>
                  <h2 class="v2-part-title">{part.title}</h2>
                  <p class="v2-lede">{part.lede}</p>
                </div>
                {part.running && (
                  <div class="v2-run" data-running>
                    <div class="v2-user"><div class="v2-bubble"><p>{part.running.request}</p></div></div>
                    <div class="v2-work">
                      <div class="v2-working" data-run-working data-tpl={workingFor}><span class="v2-wlabel" data-run-working-text>{workingPlain}</span></div>
                      <button type="button" class="v2-fold" aria-expanded="false" data-run-fold hidden>
                        <span>{worked(part.running.took)}</span><span class="v2-fold-chev" set:html={icon.chevDown} />
                      </button>
                      <ol class="v2-wrows" set:html={part.running.rows.map(rowHtml).join('')} />
                    </div>
                    <div class="v2-run-reply" data-run-reply hidden>{part.running.answer.map((a) => <p set:html={lv(a)} />)}</div>
                  </div>
                )}
                <div class="v2-user" data-user>
                  <div class="v2-bubble">
                    <p>{part.request}</p>
                    {part.attach && <p class="v2-attach"><Fragment set:html={icon.paperclip} /><span>{part.attach}</span></p>}
                  </div>
                  {part.queued && (
                    <p class="v2-queued-actions" data-queued-actions hidden>
                      <span class="v2-q-send"><Fragment set:html={icon.arrowUp} />{sendNow}</span>
                      <span class="v2-q-icon" title={editQueued}><Fragment set:html={icon.pencil} /><span class="visually-hidden">{editQueued}</span></span>
                      <span class="v2-q-icon" title={removeQueued}><Fragment set:html={icon.x} /><span class="visually-hidden">{removeQueued}</span></span>
                    </p>
                  )}
                </div>
                <div class="v2-work" data-work>
                  <div class="v2-working" data-working data-plain={workingPlain} data-tpl={workingFor} data-took={part.log?.took ?? ''} hidden>
                    <span class="v2-wlabel" data-working-text>{workingPlain}</span>
                  </div>
                  {part.log && (
                    <button type="button" class="v2-fold" aria-expanded="true" aria-controls={`v2-rows-${lesson.id}-${i}`} data-fold hidden>
                      <span>{worked(part.log.took)}</span><span class="v2-fold-chev" set:html={icon.chevDown} />
                    </button>
                  )}
                  <ol class="v2-wrows" id={`v2-rows-${lesson.id}-${i}`} data-rows>
                    <li class="v2-wrow" data-kind="skill">
                      <span class="v2-wicon" set:html={icon.skill} />
                      <span class="v2-wbody"><span class="v2-wline"><span class="v2-wlabel">{skill}</span></span></span>
                    </li>
                    {part.log?.rows.map((r) => r.agents ? (
                      /* Chapter 3: T3 Code's subagent rows. Two or more get the "{n} subagents" group row; one stands alone. */
                      <li class="v2-wrow v2-logrow v2-subs" data-at={r.at} data-kind="subagents" data-tone={r.tone}>
                        {r.agents.length > 1 && (
                          /* T3 Code's group row opens and closes; a long group starts closed. */
                          <button type="button" class="v2-sub-head" data-sub-toggle aria-expanded={r.agents.length > 4 ? 'false' : 'true'}>
                            <span class="v2-wicon" set:html={icon.bot} />
                            <span class="v2-wline"><span class="v2-wlabel">{subsLabel(r.agents.length)}</span><span class="v2-sub-line" data-sub-line data-tpl-working={subWorking} data-tpl-done={subDone} data-tpl-failed={subFailed}></span></span>
                            <span class="v2-fold-chev" set:html={icon.chevDown} />
                          </button>
                        )}
                        <ol class="v2-subrows">
                          {r.agents.map((a) => (
                            <li class="v2-subrow" data-sub-done={a.done} data-tone={a.tone} data-state="running" title={a.model}>
                              <span class="v2-sub-av" aria-hidden="true" set:html={icon.bot} />
                              <span class="v2-sub-body">
                                <span class="v2-sub-title" set:html={lv(a.name)} />
                                {a.doing && <span class="v2-sub-detail" data-when="running" set:html={lv(a.doing)} />}
                                {a.detail && <span class="v2-sub-detail" data-when="done" set:html={lv(a.detail)} />}
                              </span>
                              <span class="v2-sub-state" data-sub-state data-running={rowRunning} data-done={rowCompleted} data-bad={rowFailed}>{rowRunning}</span>
                            </li>
                          ))}
                        </ol>
                      </li>
                    ) : r.you ? (
                      /* Lesson 7: a message you send while the turn runs (a text reply that declines an approval). */
                      <li class="v2-wrow v2-logrow v2-wyou" data-at={r.at}><div class="v2-bubble"><p set:html={lv(r.label)} /></div></li>
                    ) : r.approval ? (
                      /* Lesson 7: a pending approval, as T3 Code draws it in the work log (t3code.approvalRow). A drawing: the buttons don't act. */
                      <li class="v2-wrow v2-logrow v2-wask" data-at={r.at} data-until={r.approval.until} data-kind={r.approval.kind === 'command' ? 'run' : 'change'} role="group" aria-label={r.approval.kind === 'command' ? approvalWords[0] : approvalWords[1]}>
                        <span class="v2-wicon" set:html={icon.kind[r.approval.kind === 'command' ? 'run' : 'change']} />
                        <span class="v2-wbody">
                          <code class="v2-wask-what" set:html={lv(r.label)} />
                          <span class="v2-wask-line">
                            <span class="v2-wask-wait"><Fragment set:html={icon.shield} />{approvalWords[2]}</span>
                            <span aria-hidden="true">·</span>
                            <span class="v2-wask-btn">{approvalWords[3]}</span>
                            <span class="v2-wask-btn v2-wask-yes">{approvalWords[4]}</span>
                            <span class="v2-wask-btn" title={`${approvalWords[5]}, ${approvalWords[6]}`}>More</span>
                          </span>
                          {r.detail && <span class="v2-wdetail" set:html={lv(r.detail)} />}
                        </span>
                      </li>
                    ) : (
                      <li class="v2-wrow v2-logrow" data-at={r.at} data-kind={kindOf(r)} data-tone={r.tone}>
                        <span class="v2-wicon" set:html={icon.kind[kindOf(r)]} />
                        <span class="v2-wbody">
                          <span class="v2-wline">
                            <span class="v2-wlabel" set:html={lv(r.label)} />
                            {r.tone === 'bad' && <span class="v2-wmark" set:html={`${icon.failed}<span class="visually-hidden">failed</span>`} />}
                            {r.tone === 'ok' && <span class="v2-wmark" set:html={`${icon.passed}<span class="visually-hidden">passed</span>`} />}
                          </span>
                          {r.detail && <span class="v2-wdetail" set:html={lv(r.detail)} />}
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="v2-reply" data-reply>
                  {part.answer.map((a) => <p set:html={lv(a)} />)}
                  {part.deeper && <p class="v2-deeper" data-min={part.deeper.level}>{part.deeper.text}</p>}
                </div>
                {part.goal && (
                  <p class="v2-goal" data-goal data-state="active">
                    <span class="v2-goal-icon" set:html={icon.target} />
                    <span class="v2-goal-text"><span class="v2-goal-title" data-goal-title></span> <span class="v2-goal-obj">{part.goal.objective}</span></span>
                    <span class="v2-goal-clear">{goalClear}</span>
                  </p>
                )}
                <div class="v2-try" data-try>
                  <p class="v2-try-label">Try it yourself</p>
                  <div class="v2-try-prompt">
                    <code data-prompt>{part.tryIt.prompt}</code>
                    <button type="button" class="v2-copy" data-copy aria-label="Copy the prompt"><Fragment set:html={icon.copy} /><span>Copy</span></button>
                  </div>
                  <p class="v2-try-t3"><b>In T3 Code</b> {part.tryIt.t3}</p>
                  <details class="v2-src">
                    <summary>Sources ({part.sources.length})</summary>
                    <ul>
                      {part.sources.map((id) => { const f = fact(id); return <li><a href={url(`sources/#${anchor(id)}`)}>{f.claim}</a></li>; })}
                    </ul>
                  </details>
                </div>
              </article>
            )))}
            <article class="v2-turn v2-soon" data-soon hidden>
              <div class="v2-turn-head">
                <p class="v2-part-n">Not built yet</p>
                <h2 class="v2-part-title" data-soon-title></h2>
                <p class="v2-lede">This lesson is in the table of contents only. Lessons 1 and 2 play.</p>
              </div>
              <p><a class="v2-soon-link" href="#l1" data-lesson-link="l1">Play lesson 1, Say what you want</a></p>
            </article>
          </div>
        </div>

        <div class="v2-dock">
          <button type="button" class="v2-jump" data-jump hidden><Fragment set:html={icon.chevDown} /><span>Back to the current point</span></button>
          <button type="button" class="v2-mini" data-mini aria-haspopup="dialog" aria-controls="v2-browser">
            <span class="v2-thumb" aria-hidden="true"><span class="v2-thumb-stage j-stage tile" data-mini-stage></span></span>
            <span class="v2-mini-text">
              <span class="v2-mini-top"><span>Explainer</span><span class="v2-mini-badge" data-mini-badge hidden>Preview</span></span>
              <span class="v2-mini-sub" data-mini-sub>Open the picture</span>
            </span>
            <span class="v2-mini-open"><Fragment set:html={icon.chevUp} /><span class="visually-hidden">Open the explainer</span></span>
          </button>
          <div class="v2-composer" role="group" aria-label="Lesson controls">
            {/* Lesson 7: the agent's question, as T3 Code opens it inside the composer (t3code.questionPanel). The player fills it. */}
            <div class="v2-ask" data-ask data-dismiss={t3code.questionPanel.value[0]} role="group" aria-label="The agent asks (example)" hidden></div>
            <div class="v2-comp-head">
              <button type="button" class="v2-parts-btn" data-parts-btn aria-haspopup="true" aria-expanded="false" aria-controls="v2-parts">
                <span class="v2-parts-title" data-c-title>{firstPart.title}</span><Fragment set:html={icon.chevUp} />
              </button>
              <span class="v2-comp-where" data-c-where>Part 1 of {LESSONS.l1!.parts.length}</span>
            </div>
            <p class="v2-comp-say" data-c-say aria-live="polite">{firstPart.points[0]!.say}</p>
            <div class="v2-comp-bar">
              <span class="v2-chips" data-foot>
                <span class="v2-chip" data-ui="model" hidden>{MODEL}</span>
                <span class="v2-chip" data-ui="perm" hidden data-perm-tpl={permLabel}></span>
                <span class="v2-chip v2-chip-env" data-ui="env" hidden title={runOn}><Fragment set:html={icon.machine} /><span data-env-name></span></span>
                <span class="v2-chip v2-chip-ico" data-ui="checkout" hidden></span>
                <span class="v2-chip v2-chip-ico v2-mono" data-ui="branch" hidden></span>
              </span>
              <span class="v2-transport">
                <button type="button" class="v2-ctl" data-c="prev" aria-label="Back one point" title="Back one point (←)" set:html={icon.prev} />
                <button type="button" class="v2-send v2-play" data-c="play" aria-label="Play" aria-pressed="false" title="Play (Space)" set:html={icon.play} />
                <button type="button" class="v2-ctl" data-c="next" aria-label="Forward one point" title="Forward one point (→)" set:html={icon.next} />
              </span>
            </div>
            <div class="v2-pop v2-parts" id="v2-parts" data-parts hidden>
              <p class="v2-pop-label" data-parts-head></p>
              <ol data-parts-list></ol>
            </div>
          </div>
        </div>
      </section>

      <div class="v2-split" data-split role="separator" aria-orientation="vertical" aria-label="Resize the browser panel" aria-valuemin="0" aria-valuemax="100" tabindex="0"></div>
      <div class="v2-scrim" data-scrim aria-hidden="true"></div>

      <section class="v2-browser" id="v2-browser" data-browser aria-label="Browser (example)">
        <div class="v2-top" data-top>
          <span class="v2-grab" aria-hidden="true"></span>
          <div class="v2-tabs" role="tablist" aria-label="Browser tabs">
            <button type="button" role="tab" class="v2-tab" id="v2-tab-ex" aria-controls="v2-pane-ex" aria-selected="true" data-tab="ex"><Fragment set:html={icon.picture} /><span>Explainer</span></button>
            <button type="button" role="tab" class="v2-tab" id="v2-tab-preview" aria-controls="v2-pane-preview" aria-selected="false" tabindex="-1" data-tab="preview" hidden><Fragment set:html={icon.globe} /><span>Preview</span><span class="v2-badge" data-badge hidden><span class="visually-hidden">: changed</span></span></button>
          </div>
          <button type="button" class="v2-head-btn v2-close" data-close aria-label="Close the browser" set:html={icon.close} />
        </div>
        <div class="v2-url">
          <span class="v2-nav" aria-hidden="true"><Fragment set:html={icon.prev} /><Fragment set:html={icon.next} /><Fragment set:html={icon.reload} /></span>
          <span class="v2-addr" data-addr><span>Explainer</span><span class="v2-addr-sub">· {firstPart.title}</span></span>
          <span class="v2-ex">example</span>
        </div>
        <div class="v2-pane v2-pane-ex" id="v2-pane-ex" role="tabpanel" aria-labelledby="v2-tab-ex" data-pane="ex">
          <div class="v2-view" data-view>
            <div class="v2-stage j-stage tile" data-stage role="img" aria-label={`${firstPart.title}: ${firstPart.points.at(-1)!.say}`}>
              <Fragment set:html={poster(firstPart.points[0]!.state, { w: 800, h: 600 })} />
            </div>
          </div>
        </div>
        <div class="v2-pane v2-pane-preview" id="v2-pane-preview" role="tabpanel" aria-labelledby="v2-tab-preview" data-pane="preview" hidden>
          <div class="v2-page" data-preview data-state="empty"><p class="v2-page-empty">Nothing to preview yet.</p></div>
        </div>
        <p class="v2-say" data-say>{firstPart.points[0]!.say}</p>
        <div class="v2-bar">
          <button type="button" class="v2-send v2-play" data-c="play" aria-label="Play" aria-pressed="false" title="Play (Space)" set:html={icon.play} />
          <ol class="v2-dots" data-dots aria-label="Points"></ol>
          <span class="v2-bar-n" data-n></span>
        </div>
      </section>
    </div>

    <div class="v2-menu" id="v2-guide-menu" role="menu" aria-label="Guide" data-guide-menu hidden>
      <div role="group" aria-labelledby="v2-menu-pages">
        <p class="v2-menu-label" id="v2-menu-pages" role="presentation">Pages</p>
        {navItems.map((s) => (
          <a class="v2-menu-item" role="menuitem" tabindex="-1" href={url(s.path)} aria-current={s.id === 'v2' ? 'page' : undefined}>
            <span>{s.label}</span>{s.id === 'v2' && <span class="v2-menu-tick" set:html={icon.check} />}
          </a>
        ))}
        {hasSources && <a class="v2-menu-item" role="menuitem" tabindex="-1" href={url('sources/')}><span>Sources</span></a>}
        <a class="v2-menu-item" role="menuitem" tabindex="-1" href={repo}><span>Source on GitHub</span><span class="v2-menu-tick" set:html={icon.external} /></a>
      </div>
      <div class="v2-menu-sep" role="separator"></div>
      <div role="group" aria-labelledby="v2-menu-look">
        <p class="v2-menu-label" id="v2-menu-look" role="presentation">Look</p>
        <button type="button" class="v2-menu-item" role="menuitemcheckbox" aria-checked="false" tabindex="-1" data-menu-theme>
          <span>Dark theme</span><span class="v2-menu-tick" set:html={icon.check} />
        </button>
      </div>
      <div class="v2-menu-sep" role="separator"></div>
      <div role="group" aria-labelledby="v2-menu-level">
        <p class="v2-menu-label" id="v2-menu-level" role="presentation">Reading level</p>
        {LEVELS.map((id) => (
          <button type="button" class="v2-menu-item v2-menu-level" role="menuitemradio" aria-checked="false" tabindex="-1" data-menu-level={id}>
            <span class="v2-menu-text"><span>{levelInfo[id].label}</span><span class="v2-menu-desc">{levelInfo[id].description}</span></span>
            <span class="v2-menu-tick" set:html={icon.check} />
          </button>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  import { boot } from '../../v2/player';
  const root = document.querySelector<HTMLElement>('[data-v2]');
  if (root) boot(root);
</script>
