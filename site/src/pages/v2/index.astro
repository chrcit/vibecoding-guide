---
/*
  Guide v2: a drawing of T3 Code that plays the lessons. The sidebar is the table of contents
  (chapters are projects, lessons are threads). The chat column shows the lesson as a thread: each
  part is one turn (the request, the inline thread summary, the reply), and the controls sit where
  the composer would be. The browser panel on the right has two tabs: Explainer, the picture of
  what happens at each point, and Preview, the app the agent builds (only in lessons that build
  one). On a phone the chat is the screen and the browser opens as a sheet. Every turn is in the
  HTML; v2/player.ts moves through the parts and points. Brief: planning/guide-v2/BRIEF.md.
  Notes: planning/guide-v2/NOTES.md.
*/
import Base from '../../layouts/Base.astro';
import '../../components/fig/fig.css';
import '../../styles/journey.css';
import '../../styles/v2.css';
import { TOC, LESSONS, MODEL, worked, whereIs, type Lv } from '../../v2/content';
import { lvHtml } from '../../v2/html';
import { kindOf } from '../../v2/ui/summary';
import { poster } from '../../journey/picture';
import { fact, anchor } from '../../lib/facts';
import { url } from '../../lib/nav';
import { t3code } from '../../data/t3code';

const [ctxTitle, ctxUsed] = t3code.screen.contextWindow.value;
const filterLabel = t3code.screen.filter.value;
const permLabel = t3code.screen.permissionChip.value;
const lv = (t: Lv) => lvHtml(t);
const total = TOC.flatMap((c) => c.lessons).filter((l) => l.n).length;
/** The quiet first row of every reply: T3 Code's work-log row for a skill, naming this guide's. */
const skill = t3code.screen.skillRow.value.replace('{name}', 'agentic-guide');
const firstPart = LESSONS.l1!.parts[0]!;

const svg = (d: string, w = 20, extra = '') => `<svg viewBox="0 0 24 24" width="${w}" height="${w}" aria-hidden="true" focusable="false"${extra}>${d}</svg>`;
const line = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const icon = {
  filter: svg(`<path ${line} d="M3 6h18M7 12h10M10 18h4"/>`, 18),
  prev: svg(`<path ${line} d="M15 6l-6 6 6 6"/>`),
  next: svg(`<path ${line} d="M9 6l6 6-6 6"/>`),
  play: svg('<path fill="currentColor" d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l10.6-6.8a.8.8 0 0 0 0-1.4L9.2 4.5A.8.8 0 0 0 8 5.2Z"/>', 20, ' class="i-play"')
    + svg('<rect fill="currentColor" x="6.5" y="5" width="4" height="14" rx="1.2"/><rect fill="currentColor" x="13.5" y="5" width="4" height="14" rx="1.2"/>', 20, ' class="i-pause"'),
  back: svg(`<path ${line} d="M15 6l-6 6 6 6"/>`),
  details: svg('<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v5M12 8v.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>', 18),
  copy: svg('<rect x="8" y="8" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 15V6a1 1 0 0 1 1-1h9" fill="none" stroke="currentColor" stroke-width="1.8"/>', 16),
  chev: svg(`<path ${line} d="m7 10 5 5 5-5"/>`, 16),
  up: svg(`<path ${line} d="m7 14 5-5 5 5"/>`, 16),
  close: svg(`<path ${line} d="m6 6 12 12M18 6 6 18"/>`),
  reload: svg(`<path ${line} d="M19 12a7 7 0 1 1-2-4.9M19 4v4h-4"/>`, 15),
  skill: svg('<path d="M12 3.3 14.2 9.8l6.5 2.2-6.5 2.2L12 20.7l-2.2-6.5L3.3 12l6.5-2.2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>', 15),
  picture: svg('<rect x="3" y="4.5" width="18" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="10" r="1.8" fill="currentColor"/><path d="m4.5 18 5-4.5 3.5 3 3-2.2 3.5 3.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>', 16),
  globe: svg('<circle cx="12" cy="12" r="8.3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.7 12h16.6M12 3.7c2.4 2.4 3.4 5.1 3.4 8.3s-1 5.9-3.4 8.3c-2.4-2.4-3.4-5.1-3.4-8.3s1-5.9 3.4-8.3Z" fill="none" stroke="currentColor" stroke-width="1.8"/>', 16),
  bad: svg(`<path ${line} stroke-width="2.6" d="m7 7 10 10M17 7 7 17"/>`, 12),
  ok: svg(`<path ${line} stroke-width="2.6" d="m5 12.5 4.5 4.5L19 7"/>`, 12),
};
---
<Base title="Guide v2 · Agentic Coding Guide" description="The guide as a drawing of T3 Code: every lesson is a thread, every part a turn, with the picture and the app in a browser panel beside it." section="v2">
  <div class="v2" data-v2 data-view="list" data-base={url('')}>
    <aside class="v2-side" aria-label="Lessons">
      <div class="v2-side-head">
        <span class="v2-app">T3 Code <span class="v2-ex">example</span></span>
        <div class="v2-filter">
          <button type="button" class="v2-icon" data-filter-btn aria-expanded="false" aria-controls="v2-filter-pop" aria-label={filterLabel} title={filterLabel}>
            <span data-filter-icon set:html={icon.filter} />
          </button>
          <div class="v2-pop" id="v2-filter-pop" data-filter-pop hidden>
            <input type="search" class="v2-pop-search" placeholder="Search projects..." aria-label="Search projects" data-filter-q />
            <ul role="listbox" aria-label="Projects" data-filter-list>
              <li><button type="button" role="option" data-scope="all" aria-selected="true"><span class="v2-fav v2-fav-all" aria-hidden="true"></span>All projects</button></li>
              {TOC.map((c) => (
                <li><button type="button" role="option" data-scope={c.id} aria-selected="false"><span class="v2-fav" aria-hidden="true">{c.n ?? 'S'}</span>{c.title}</button></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <nav class="v2-toc" data-toc>
        {TOC.map((c) => (
          <section class="v2-folder" data-project={c.id}>
            <h2 class="v2-folder-head"><span class="v2-fav" aria-hidden="true">{c.n ?? 'S'}</span>{c.title}</h2>
            <ol>
              {c.lessons.map((l) => (
                <li id={l.id}>
                  <a class="v2-row" href={`#${l.id}`} data-lesson={l.id} data-plays={l.plays ? '' : undefined}>
                    <span class="v2-row-title">{l.title}</span>
                    <span class="v2-pill" data-status></span>
                  </a>
                  {l.plays && <ol class="v2-threads" data-threads={l.id} aria-label={`Threads in ${l.title}`} hidden></ol>}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </nav>
      <p class="v2-side-foot">A drawing of T3 Code, not the app. The club, its guests and the numbers are made up. Lessons 1 and 2 of {total} play.</p>
    </aside>

    <div class="v2-main" data-main>
      <section class="v2-chat" data-chat aria-label="Lesson thread">
        <header class="v2-head">
          <a class="v2-icon v2-to-list" href="#" data-to-list aria-label="All lessons" set:html={icon.back} />
          <p class="v2-crumb"><span class="v2-fav" aria-hidden="true" data-crumb-fav>1</span><span data-crumb-project>Hand it over</span><span class="v2-sep" aria-hidden="true">/</span><b data-crumb-thread>Say what you want</b></p>
          <div class="v2-details" data-ui="context" hidden>
            <button type="button" class="v2-icon v2-details-btn" data-details-btn aria-expanded="false" aria-controls="v2-details-pop" aria-label="Thread details"><Fragment set:html={icon.details} /><span class="v2-details-val" data-ctx-short></span></button>
            <div class="v2-pop v2-details-pop" id="v2-details-pop" data-details-pop hidden>
              <p class="v2-pop-title">{ctxTitle} <span class="v2-ex">example</span></p>
              <div class="v2-meter" aria-hidden="true"><span data-ctx-bar></span></div>
              <p class="v2-pop-val" data-ctx-text data-tpl={ctxUsed}></p>
            </div>
          </div>
        </header>

        <div class="v2-scroll" data-scroll>
          <div class="v2-thread">
            {Object.values(LESSONS).map((lesson) => lesson.parts.map((part, i) => {
              const { lesson: tl } = whereIs(lesson.id);
              return (
                <article class="v2-turn" data-turn data-lesson={lesson.id} data-part={i} aria-label={`Part ${i + 1}: ${part.title}`}>
                  {part.fresh && <p class="v2-divider"><span>{t3code.screen.newThread.value}</span></p>}
                  <p class="v2-lede">{part.lede}</p>
                  <div class="v2-user">
                    <p>{part.request}</p>
                    {part.attach && <p class="v2-attach">{part.attach}</p>}
                  </div>
                  <p class="v2-skill"><Fragment set:html={icon.skill} /><b>{skill}</b><span>· Lesson {tl.n} · Part {i + 1}/{lesson.parts.length}</span></p>
                  {part.log && (
                    <section class="v2-sum" data-sum aria-label="Work log">
                      <button type="button" class="v2-sum-head" aria-expanded="false" data-sum-toggle>
                        <span class="v2-sum-line"><span data-sum-text data-done={worked(part.log.took)}>{worked(part.log.took)}</span><span class="v2-chev" set:html={icon.chev} /></span>
                        <span class="v2-groups" data-groups></span>
                      </button>
                      <p class="v2-sum-now" data-sum-now hidden></p>
                      <ol class="v2-rows" data-rows>
                        {part.log.rows.map((r) => (
                          <li class="v2-logrow" data-at={r.at} data-kind={kindOf(r)} data-tone={r.tone}>
                            <span class="v2-mark" set:html={r.tone === 'bad' ? `${icon.bad}<span class="visually-hidden">failed</span>` : r.tone === 'ok' ? `${icon.ok}<span class="visually-hidden">passed</span>` : ''} />
                            <span class="v2-log-label" set:html={lv(r.label)} />
                            {r.detail && <span class="v2-log-detail" set:html={lv(r.detail)} />}
                          </li>
                        ))}
                      </ol>
                    </section>
                  )}
                  <div class="v2-reply" data-reply>
                    {part.answer.map((a) => <p set:html={lv(a)} />)}
                    {part.deeper && <p class="v2-deeper" data-min={part.deeper.level}>{part.deeper.text}</p>}
                  </div>
                  <div class="v2-try" data-try>
                    <div class="v2-try-prompt">
                      <code data-prompt>{part.tryIt.prompt}</code>
                      <button type="button" class="v2-copy" data-copy aria-label="Copy the prompt"><Fragment set:html={icon.copy} /><span>Copy</span></button>
                    </div>
                    <p class="v2-try-t3"><b>In T3 Code</b> {part.tryIt.t3}</p>
                    <details class="v2-src">
                      <summary>Sources ({part.sources.length})</summary>
                      <ul>
                        {part.sources.map((id) => { const f = fact(id); return <li><a href={url(`sources/#${anchor(id)}`)}>{f.claim}</a></li>; })}
                      </ul>
                    </details>
                  </div>
                </article>
              );
            }))}
            <article class="v2-turn v2-soon" data-soon hidden>
              <p class="v2-soon-title" data-soon-title></p>
              <p>This lesson is in the table of contents only. Lessons 1 and 2 play.</p>
              <p><a href="#l1" data-lesson-link="l1">Play lesson 1, Say what you want</a></p>
            </article>
          </div>
        </div>

        <div class="v2-dock">
          <button type="button" class="v2-mini" data-mini aria-haspopup="dialog" aria-controls="v2-browser">
            <span class="v2-thumb" aria-hidden="true"><span class="v2-thumb-stage j-stage tile" data-mini-stage></span></span>
            <span class="v2-mini-text">
              <span class="v2-mini-top"><span class="v2-mini-n" data-n></span><span class="v2-mini-badge" data-mini-badge hidden>Preview</span></span>
              <span class="v2-mini-say" data-mini-say></span>
            </span>
            <span class="v2-mini-open"><Fragment set:html={icon.up} /><span class="visually-hidden">Open the explainer</span></span>
          </button>
          <div class="v2-composer" role="group" aria-label="Lesson controls">
            <button type="button" class="v2-parts-btn" data-parts-btn aria-haspopup="true" aria-expanded="false" aria-controls="v2-parts">
              <span class="v2-parts-title"><span data-c-title>{firstPart.title}</span><Fragment set:html={icon.up} /></span>
              <span class="v2-parts-sub" data-c-where>Part 1 of {LESSONS.l1!.parts.length}</span>
            </button>
            <div class="v2-transport">
              <button type="button" class="v2-btn" data-c="prev" aria-label="Back one point" title="Back one point (←)" set:html={icon.prev} />
              <button type="button" class="v2-btn v2-play" data-c="play" aria-label="Play" aria-pressed="false" title="Play (Space)" set:html={icon.play} />
              <button type="button" class="v2-btn" data-c="next" aria-label="Forward one point" title="Forward one point (→)" set:html={icon.next} />
            </div>
            <div class="v2-parts" id="v2-parts" data-parts hidden>
              <p class="v2-parts-head" data-parts-head></p>
              <ol data-parts-list></ol>
            </div>
          </div>
          <p class="v2-foot" data-foot>
            <span class="v2-chip" data-ui="model" hidden>{MODEL}</span>
            <span class="v2-chip" data-ui="perm" hidden data-perm-tpl={permLabel}></span>
          </p>
        </div>
      </section>

      <div class="v2-split" data-split role="separator" aria-orientation="vertical" aria-label="Resize the browser panel" aria-valuemin="0" aria-valuemax="100" tabindex="0"></div>
      <div class="v2-scrim" data-scrim aria-hidden="true"></div>

      <section class="v2-browser" id="v2-browser" data-browser aria-label="Browser (example)">
        <div class="v2-top" data-top>
          <span class="v2-grab" aria-hidden="true"></span>
          <div class="v2-tabs" role="tablist" aria-label="Browser tabs">
            <button type="button" role="tab" class="v2-tab" id="v2-tab-ex" aria-controls="v2-pane-ex" aria-selected="true" data-tab="ex"><Fragment set:html={icon.picture} /><span>Explainer</span></button>
            <button type="button" role="tab" class="v2-tab" id="v2-tab-preview" aria-controls="v2-pane-preview" aria-selected="false" tabindex="-1" data-tab="preview" hidden><Fragment set:html={icon.globe} /><span>Preview</span><span class="v2-badge" data-badge hidden><span class="visually-hidden">: changed</span></span></button>
          </div>
          <button type="button" class="v2-btn v2-close" data-close aria-label="Close the browser" set:html={icon.close} />
        </div>
        <div class="v2-url">
          <span class="v2-nav" aria-hidden="true"><Fragment set:html={icon.prev} /><Fragment set:html={icon.next} /><Fragment set:html={icon.reload} /></span>
          <span class="v2-addr" data-addr><span>Explainer</span><span class="v2-addr-sub">· {firstPart.title}</span></span>
          <span class="v2-ex">example</span>
        </div>
        <div class="v2-pane v2-pane-ex" id="v2-pane-ex" role="tabpanel" aria-labelledby="v2-tab-ex" data-pane="ex">
          <div class="v2-view" data-view>
            <div class="v2-stage j-stage tile" data-stage role="img" aria-label={`${firstPart.title}: ${firstPart.points.at(-1)!.say}`}>
              <Fragment set:html={poster(firstPart.points[0]!.state, { w: 800, h: 600 })} />
            </div>
          </div>
        </div>
        <div class="v2-pane v2-pane-preview" id="v2-pane-preview" role="tabpanel" aria-labelledby="v2-tab-preview" data-pane="preview" hidden>
          <div class="v2-page" data-preview data-state="empty"><p class="v2-page-empty">Nothing to preview yet.</p></div>
        </div>
        <p class="v2-say" data-say aria-live="polite">{firstPart.points[0]!.say}</p>
        <div class="v2-bar">
          <button type="button" class="v2-btn v2-play" data-c="play" aria-label="Play" aria-pressed="false" title="Play (Space)" set:html={icon.play} />
          <ol class="v2-dots" data-dots aria-label="Points"></ol>
          <span class="v2-bar-n" data-n></span>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import { boot } from '../../v2/player';
  const root = document.querySelector<HTMLElement>('[data-v2]');
  if (root) boot(root);
</script>
