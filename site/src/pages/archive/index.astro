---
import Base from '../../layouts/Base.astro';
import { archiveEntries, type ArchiveGroup } from '../../data/archive';
import { url } from '../../lib/nav';

const integrateCount = archiveEntries.filter((e) => e.disposition === 'integrate').length;
const discardCount = archiveEntries.filter((e) => e.disposition === 'discard').length;
const groups: ArchiveGroup[] = [
  'Original vibecoding-guide',
  'Interactive Explainers',
  'Essays & Mental Models',
  'Start & T3 Code',
  'Showcase & Misc',
];
---
<Base
  title="Archive · Integrate vs Discard"
  description="Every legacy page from the previous site structure, sorted into what to integrate into the interactive guide and what to discard."
  section="archive"
>
  <div class="arc-shell">
    <header class="arc-head">
      <h1>Content archive</h1>
      <p class="arc-intro">
        The interactive guide is now the entire site. Everything else—earlier explainers, essays, the original
        <code>vibecoding-guide</code> markdown chapters, showcase demos, and prototypes—stays live here so no link breaks,
        sorted into two buckets: <strong>integrate into the guide</strong> and <strong>discard / superseded</strong>.
      </p>

      <div class="arc-bar">
        <div class="arc-tabs" role="tablist" aria-label="Filter archive by decision">
          <button type="button" class="arc-tab" data-filter="all" aria-pressed="true">
            All <span class="arc-count">{archiveEntries.length}</span>
          </button>
          <button type="button" class="arc-tab arc-tab-int" data-filter="integrate" aria-pressed="false">
            Integrate into guide <span class="arc-count">{integrateCount}</span>
          </button>
          <button type="button" class="arc-tab arc-tab-dis" data-filter="discard" aria-pressed="false">
            Discard / superseded <span class="arc-count">{discardCount}</span>
          </button>
        </div>

        <label class="arc-search">
          <span class="visually-hidden">Search archive</span>
          <input id="arc-q" type="search" placeholder="Search title, target chapter, or notes…" autocomplete="off" />
        </label>
      </div>
    </header>

    <div class="arc-groups">
      {groups.map((group) => {
        const items = archiveEntries.filter((e) => e.group === group);
        return (
          <section class="arc-group" data-arc-group>
            <h2 class="arc-group-title">{group}</h2>
            <div class="arc-grid">
              {items.map((item) => (
                <article
                  class={`arc-card arc-${item.disposition}`}
                  data-arc-item
                  data-disp={item.disposition}
                  data-q={`${item.title} ${item.group} ${item.targetLabel} ${item.note}`.toLowerCase()}
                >
                  <div class="arc-card-top">
                    <span class={`arc-badge arc-badge-${item.disposition}`}>
                      {item.disposition === 'integrate' ? 'Integrate' : 'Discard'}
                    </span>
                    <a class="arc-open" href={url(item.href)} data-side>Preview archived →</a>
                  </div>
                  <h3><a href={url(item.href)}>{item.title}</a></h3>
                  <p class="arc-note">{item.note}</p>
                  <p class="arc-target">
                    <span>{item.disposition === 'integrate' ? 'Target:' : 'Status:'}</span>{' '}
                    <a href={url(item.targetHref)}>{item.targetLabel}</a>
                  </p>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <p class="arc-empty" id="arc-empty" role="status" hidden>Nothing matches that filter.</p>
  </div>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const input = document.getElementById('arc-q') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLElement>('[data-arc-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-arc-group]')];
  const empty = document.getElementById('arc-empty');

  let active = 'all';
  function apply() {
    const terms = (input?.value ?? '').toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const okDisp = active === 'all' || el.dataset.disp === active;
      const okText = terms.every((t) => el.dataset.q!.includes(t));
      const hit = okDisp && okText;
      el.hidden = !hit;
      if (hit) shown++;
    }
    for (const g of groups) {
      g.hidden = !g.querySelector('[data-arc-item]:not([hidden])');
    }
    if (empty) empty.hidden = shown > 0;
  }

  for (const b of tabs) {
    b.addEventListener('click', () => {
      active = b.dataset.filter ?? 'all';
      for (const other of tabs) other.setAttribute('aria-pressed', String(other === b));
      apply();
    });
  }
  input?.addEventListener('input', apply);
</script>

<style>
  .arc-shell {
    max-width: var(--full);
    margin-inline: auto;
    padding: var(--space-7) var(--gutter) var(--space-8);
  }
  .arc-head h1 { margin: 0 0 var(--space-3); font-size: clamp(1.75rem, 3vw, 2.35rem); letter-spacing: -0.02em; }
  .arc-intro { max-width: 64ch; color: var(--ink-2); font-size: var(--text-l); line-height: 1.55; margin: 0 0 var(--space-5); }
  .arc-intro code { font-family: var(--mono); font-size: 0.9em; }

  .arc-bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-3); padding-bottom: var(--space-5); border-bottom: 1px solid var(--rule);
  }
  .arc-tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .arc-tab {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.4rem;
    padding: 0.35rem 0.85rem; border: 1px solid var(--rule-strong); border-radius: var(--radius-pill);
    background: var(--card); color: var(--ink-2); font: inherit; font-size: var(--text-s); font-weight: 560;
    cursor: pointer; transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .arc-tab:hover { border-color: var(--accent); color: var(--ink); }
  .arc-tab[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .arc-tab-int[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .arc-count { font-family: var(--mono); font-size: var(--text-xs); opacity: 0.8; }

  .arc-search { flex: 1 1 16rem; max-width: 24rem; }
  .arc-search input {
    width: 100%; min-height: 2.4rem; padding: 0.35rem 0.9rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-pill);
    background: var(--card); color: var(--ink); font: inherit; font-size: var(--text-s);
  }

  .arc-groups { display: grid; gap: var(--space-7); margin-top: var(--space-6); }
  .arc-group[hidden] { display: none; }
  .arc-group-title { margin: 0 0 var(--space-4); font-size: var(--text-xl); font-weight: 620; letter-spacing: -0.012em; }

  .arc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr)); gap: var(--space-4); }
  .arc-card {
    display: flex; flex-direction: column; gap: 0.55rem; padding: 1rem 1.1rem;
    border: 1px solid var(--rule); border-radius: var(--radius-m); background: var(--card);
  }
  .arc-card[hidden] { display: none; }
  .arc-integrate { border-left: 3px solid var(--accent); }
  .arc-discard { border-left: 3px solid var(--rule-strong); opacity: 0.92; }

  .arc-card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .arc-badge {
    display: inline-flex; align-items: center; padding: 0.12rem 0.55rem; border-radius: var(--radius-pill);
    font-size: var(--text-xs); font-weight: 600;
  }
  .arc-badge-integrate { background: color-mix(in oklab, var(--accent) 14%, var(--card)); color: var(--accent); }
  .arc-badge-discard { background: var(--paper-2); color: var(--muted); }
  .arc-open { font-size: var(--text-xs); color: var(--muted); text-decoration: none; }
  .arc-open:hover { color: var(--accent); text-decoration: underline; }

  .arc-card h3 { margin: 0; font-size: var(--text-m); font-weight: 620; line-height: 1.3; }
  .arc-card h3 a { color: var(--ink); text-decoration: none; }
  .arc-card h3 a:hover { color: var(--accent); }

  .arc-note { margin: 0; font-size: var(--text-s); line-height: 1.5; color: var(--ink-2); flex: 1; }
  .arc-target { margin: 0.25rem 0 0; padding-top: 0.55rem; border-top: 1px solid var(--rule); font-size: var(--text-xs); color: var(--muted); }
  .arc-target a { color: var(--ink); font-weight: 560; text-decoration: none; }
  .arc-target a:hover { color: var(--accent); text-decoration: underline; }

  .arc-empty { margin-top: var(--space-6); color: var(--muted); }
  .arc-empty[hidden] { display: none; }
</style>
