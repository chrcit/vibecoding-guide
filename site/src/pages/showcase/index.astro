---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import CardGrid from '../../components/site/CardGrid.astro';
import Card from '../../components/site/Card.astro';
import { categories, pieces, piecesIn } from '../../lib/showcase';
---
<Base title="Showcase · Agentic Coding Guide" description="Things built by an agent for this guide, each with the prompt that started it and an honest account of how it went." section="showcase" noindex={pieces.length === 0}>
  <div class="wrap">
    <PageHeader title="Showcase">
      <p>Things an agent built for this guide. Each comes with the prompt that started it and a short account of how it went, including what had to be corrected.</p>
    </PageHeader>
    {categories.map((c) => (
      <CardGrid title={c.title}>
        {piecesIn(c.id).length === 0
          ? <Card href={`showcase/${c.id}/`} title={c.title}>{c.blurb}</Card>
          : piecesIn(c.id).map((p) => <Card href={`showcase/${c.id}/#${p.slug}`} title={p.title}>{p.summary}</Card>)}
      </CardGrid>
    ))}
  </div>
</Base>
<style>
  .wrap { max-width: var(--wide); margin: 0 auto; padding: var(--space-7) var(--gutter) 0; }
</style>
