---
import Journey from '../../layouts/Journey.astro';
import Step from '../../components/journey/Step.astro';
import Next from '../../components/journey/Next.astro';
---
<Journey chapter="handoff" first="alone" title="A second agent" description="An agent can hand part of a job to a helper with an empty window. Only the brief goes in and only a report comes back.">
  <Step id="alone" title="Searching fills its window">
    <p>It read seven files to find three. All seven stay in the window.</p>
    <div class="row"><button class="btn ghost" type="button" data-do="alone">Play it again</button></div>
  </Step>
  <Step id="hand" title="Hand the search to a helper">
    <p>The helper starts empty, gets a brief, and sends back a short report. Its window is thrown away.</p>
    <div class="row"><button class="btn ghost" type="button" data-do="hand" data-val="full">Play it again</button></div>
  </Step>
  <Step id="brief" title="The helper knows only the brief">
    <p>You told the agent not to change anything. The helper never heard you.</p>
    <div class="pick">
      <button type="button" data-do="hand" data-val="short" data-default aria-pressed="true">A short brief</button>
      <button type="button" data-do="hand" data-val="full" aria-pressed="false">A full brief</button>
    </div>
    <Next from="handoff" more={[{ href: 'explain/orchestration/', text: 'Ways to split work' }]} />
  </Step>
</Journey>
