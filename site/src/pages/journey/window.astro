---
import LessonRef from '../../components/journey/LessonRef.astro';
import Term from '../../components/journey/Term.astro';
import Journey from '../../layouts/Journey.astro';
import Step from '../../components/journey/Step.astro';
import Next from '../../components/journey/Next.astro';
import More from '../../components/journey/More.astro';
import ForLevel from '../../components/level/ForLevel.astro';
import Fact from '../../components/data/Fact.astro';
import Verified from '../../components/data/Verified.astro';
import CopyPrompt from '../../components/site/CopyPrompt.astro';
import { url } from '../../lib/nav';
import { models } from '../../data/models';
import { harnesses } from '../../data/harnesses';

// The window sizes the reader can pick, from the models in use today.
const sizes = new Map<number, string[]>();
const ids: string[] = [];
for (const [key, m] of Object.entries(models) as [string, any][]) {
  if (!m.current) continue;
  for (const [field, f] of [['context', m.context], ['harnessContext', m.harnessContext]] as const) {
    if (!f) continue;
    const k = Math.round(f.value / 1000);
    sizes.set(k, [...(sizes.get(k) ?? []), field === 'context' ? m.name : `${m.name} in Codex`]);
    ids.push(`models.${key}.${field}`);
  }
}
const windows = [...sizes].sort((a, b) => b[0] - a[0]).map(([k, names]) => ({ k, label: `${k >= 1000 ? k / 1000 + 'M' : k + 'k'} tokens`, names }));
const factIds = [...ids, 'harnesses.claudeCode.autoCompactAt', 'harnesses.claudeCode.compactionKeeps', 'claims.research.contextRot', 'harnesses.claudeCode.focusedContext', 'harnesses.claudeCode.clearAfterTwo'];
const data = { autoCompactAt: harnesses.claudeCode.autoCompactAt.value };
---
<Journey chapter="window" first="pile" title="The window fills" description="Everything an agent reads stays in its window and is read again every turn. Unrelated text in the window makes the answer worse long before the window is full." data={data}>
  <Step id="pile" title="Nothing leaves the window">
    <p>This is the <Term id="window" /> from <LessonRef id="chat" />, holding the date fix from <LessonRef id="loop" />. Watch a morning of work pile on top: every message, file and log stays, and is read again before every turn.</p>
  </Step>

  <Step id="rot" title="More in the window, worse answers">
    <p>Same <Term id="model" />, same request: fix the date on the member card. Pick what else is in the window, then look at which file it edits and whether it keeps your first rule.</p>
    <div class="pick" role="group" aria-label="What else is in the window">
      <button type="button" data-do="mix" data-val="job" aria-pressed="false">Only this job</button>
      <button type="button" data-do="mix" data-val="morning" aria-pressed="false">After a morning</button>
      <button type="button" data-do="mix" data-val="log" data-default aria-pressed="true">Plus a pasted log</button>
    </div>
    <More title="Is this real?">
      <p>The three runs are drawn, not measured. The effect has a name: <Fact id="claims.research.contextRot" show="claim" /></p>
      <p><Fact id="harnesses.claudeCode.focusedContext" show="claim" /></p>
    </More>
  </Step>

  <Step id="long" title="Past full">
    <p>The window has a hard size. Drag past 100%: the model cannot read more than fits, so the next turn cannot go until something is dropped.</p>
    <div class="controls">
      <label class="control"><span>In the window <output>1020k</output></span>
        <input type="range" min="0" max="1100" step="10" value="1020" data-bind="used" data-unit="k" aria-label="Tokens in the window, in thousands" />
      </label>
      <label class="control"><span>Window size</span>
        <select data-bind="cap" aria-label="Window size">
          {windows.map((w) => <option value={w.k}>{w.label} ({w.names.length > 2 ? `${w.names.length} models` : w.names.join(', ')})</option>)}
        </select>
      </label>
    </div>
  </Step>

  <Step id="compact" title="What survives">
    <p>A full window gets cleared one of two ways: the tool compacts it, or you start a new <Term id="thread" />. Pick one, then ask for one more change and watch what happens to your first rule.</p>
    <div class="pick" role="group" aria-label="How the window is cleared">
      <button type="button" data-do="clear" data-val="compact" data-default aria-pressed="true">The tool compacts it</button>
      <button type="button" data-do="clear" data-val="fresh" aria-pressed="false">New thread, short brief</button>
    </div>
    <More title="What Claude Code keeps" level="technical">
      <p><Fact id="harnesses.claudeCode.compactionKeeps" show="claim" /></p>
      <p><Fact id="harnesses.claudeCode.autoCompactAt" show="claim" /></p>
    </More>
  </Step>

  <Step id="paste" title="Paste the lines, not the log">
    <p>Whatever you paste stays and is read again on every turn after it.</p>
    <div class="pick" role="group" aria-label="What you paste">
      <button type="button" data-do="paste" data-val="log" data-default aria-pressed="true">The whole log</button>
      <button type="button" data-do="paste" data-val="lines" aria-pressed="false">The failing lines</button>
    </div>
    <More title="Habits to copy">
      <ForLevel is="plain">
        <CopyPrompt compact title="Start a new thread with a brief">{`Summarise where we are in five lines: what works, what is left, which files matter, and any rule I gave you.\nI will paste that into a new chat.`}</CopyPrompt>
      </ForLevel>
      <ForLevel is="technical engineer">
        <pre class="j-code"><code>{`npm test 2>&1 | tail -40     # paste the failure, not the run
/clear                      # Claude Code: new thread, same project`}</code></pre>
      </ForLevel>
      <p><Fact id="harnesses.claudeCode.clearAfterTwo" show="claim" /></p>
    </More>
    <Next from="window" more={[{ href: 'wiki/compaction/', text: 'How compaction works', side: true }, { href: 'journey/meter/', text: 'What re-reading costs: What it costs' }]} />
  </Step>
  <Fragment slot="foot">
    <p>Window sizes: {windows.map((w) => `${w.label} (${w.names.join(', ')})`).join('; ')}. The pile, the jobs and what goes wrong in them are made up.</p>
    <Verified ids={factIds} />
  </Fragment>
</Journey>
