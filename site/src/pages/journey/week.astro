---
import Journey from '../../layouts/Journey.astro';
import Step from '../../components/journey/Step.astro';
import { rungs } from '../../journey/rungs';
import { url } from '../../lib/nav';
import { models, lineup } from '../../data/models';
import { plans } from '../../data/plans';
import { t3code } from '../../data/t3code';

// The overview plays each chapter's short loop, so it hands over the same sourced names and prices
// the chapters' own pages do.
const short = (name: string) => name.replace(/^Claude /, '');
const priced = Object.fromEntries((['claude-opus-5-5', 'claude-fable-5-2', 'gpt-6-2-sol'] as const).map((id) => {
  const p = models[id].price as { input: { value: number }; output: { value: number }; cacheRead?: { value: number } };
  return [id, { name: short(models[id].name), input: p.input.value, output: p.output.value, cacheRead: p.cacheRead?.value }];
}));
const builder = models['claude-opus-5-5'];
const reviewer = models['gpt-6-2-sol'];
const data = {
  models: priced, cacheWrite: lineup.cacheWrite5m.value, proPrice: plans.claude.pro.price.value,
  builder: short(builder.name), reviewer: short(reviewer.name), builderLab: builder.lab, reviewerLab: reviewer.lab,
  handoffCap: t3code.handoffCap.value,
};
---
<Journey chapter="week" first="meter" data={data} title="From one job to a working week" description="The second half of the journey: what agents cost, a second model that reviews, proof you can read, where your input goes, running several jobs at once, managing a growing project, working with other people, and running on other machines.">
  <p class="j-lead">Part one grew the agents. Part two covers the work around them: cost, review, proof, your input, and where they run.</p>
  {rungs.filter((r) => r.part === 2).map((r, i, all) => (
    <Step id={r.id} title={`${r.n}. ${r.title}`}>
      <p>{r.line}</p>
      <a class="j-open" href={url(`journey/${r.id}/`)} aria-label={`Try it: ${r.title}`}>Try it <span aria-hidden="true">→</span></a>
      {i === all.length - 1 && (
        <a class="j-next" href={url('start/')}>
          <span>That is the whole picture</span>
          <b>Build something in an hour</b>
          <span>Set up the tools and go round the loop yourself.</span>
        </a>
      )}
    </Step>
  ))}
</Journey>
