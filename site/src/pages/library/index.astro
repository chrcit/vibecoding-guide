---
import Base from '../../layouts/Base.astro';
import ForLevel from '../../components/level/ForLevel.astro';
import ClusterMark from '../../components/wiki/ClusterMark.astro';
import { rungs, parts } from '../../journey/rungs';
import { CLUSTERS, getWiki } from '../../lib/wiki';
import { groups, url } from '../../lib/nav';

const wiki = await getWiki();
const conceptGroups = CLUSTERS
  .map((c) => ({ cluster: c, items: wiki.articles.filter((a) => a.cluster === c.id) }))
  .filter((g) => g.items.length > 0);
const skills = groups.find((g) => g.name.startsWith('Prompts'))?.items ?? [];
---
<Base
  title="Concept & Lesson Library"
  description="Browse all 21 interactive lessons, jump straight to any sub-step, or open any behind-the-scenes concept in a side drawer."
  section="library"
>
  <div class="lib-shell">
    <header class="lib-head">
      <div class="lib-title-row">
        <div>
          <h1>Concept &amp; lesson library</h1>
          <p class="lib-intro">
            Jump fluidly between all <strong>{rungs.length} interactive lessons</strong>, <strong>{wiki.articles.length} behind-the-scenes concepts</strong>,
            and <strong>{skills.length} reusable starter skills</strong>. Switch the reader level in the header to tailor every lesson takeaway.
          </p>
        </div>
        <a class="lib-graph-link" href={url('wiki/graph/')}>Open concept graph →</a>
      </div>

      <div class="lib-controls">
        <div class="lib-pills" role="group" aria-label="Filter library">
          <button type="button" class="lib-pill" data-lib-scope="all" aria-pressed="true">Everything</button>
          <button type="button" class="lib-pill" data-lib-scope="part-1" aria-pressed="false">Part 1 · Foundations (1–4)</button>
          <button type="button" class="lib-pill" data-lib-scope="part-2" aria-pressed="false">Part 2 · Agents (5–13)</button>
          <button type="button" class="lib-pill" data-lib-scope="part-3" aria-pressed="false">Part 3 · Working week (14–21)</button>
          <button type="button" class="lib-pill" data-lib-scope="concepts" aria-pressed="false">Concepts ({wiki.articles.length})</button>
          <button type="button" class="lib-pill" data-lib-scope="skills" aria-pressed="false">Starter skills ({skills.length})</button>
        </div>
        <label class="lib-search">
          <span class="visually-hidden">Search lessons, sub-steps, and concepts</span>
          <input id="lib-q" type="search" placeholder="Filter by topic (e.g. context rot, git, tests, worktree, v0, cost)…" autocomplete="off" />
        </label>
      </div>
    </header>

    <!-- 21 Interactive Lessons grouped by the 3 Parts -->
    <section class="lib-section" id="lessons" data-lib-block="lessons">
      {parts.map((part) => {
        const partRungs = rungs.filter((r) => r.part === part.n);
        return (
          <div class="lib-part" data-lib-part={`part-${part.n}`}>
            <div class="lib-part-head">
              <div>
                <h2>Part {part.n} · {part.title} <span class="lib-range">Lessons {part.range}</span></h2>
                <p>{part.blurb}</p>
              </div>
              <a class="lib-ov-link" href={url(part.href)}>Animated overview →</a>
            </div>

            <div class="lib-lesson-grid">
              {partRungs.map((r) => {
                const searchText = [
                  r.title, r.short, r.line, r.adds.plain, r.adds.technical, r.adds.engineer,
                  ...r.steps.map((s) => s.label),
                  ...r.concepts.map((c) => c.label),
                ].join(' ').toLowerCase();
                return (
                  <article class="lib-lesson" data-lib-item data-kind={`part-${part.n}`} data-q={searchText}>
                    <div class="lib-lesson-top">
                      <span class="lib-num">{r.n}</span>
                      <h3><a href={url(`journey/${r.id}/`)}>{r.title}</a></h3>
                    </div>
                    <p class="lib-line">{r.line}</p>

                    <div class="lib-adds">
                      <ForLevel is="plain"><p>{r.adds.plain}</p></ForLevel>
                      <ForLevel is="technical"><p>{r.adds.technical}</p></ForLevel>
                      <ForLevel is="engineer"><p>{r.adds.engineer}</p></ForLevel>
                    </div>

                    <div class="lib-steps" aria-label={`Jump inside ${r.title}`}>
                      {r.steps.map((s) => (
                        <a class="lib-step-chip" href={url(`journey/${r.id}/#${s.id}`)}>{s.label}</a>
                      ))}
                    </div>

                    <div class="lib-lesson-foot">
                      <a class="lib-go" href={url(`journey/${r.id}/`)}>Open lesson →</a>
                      <span class="lib-concept-links">
                        {r.concepts.map((c) => (
                          <a href={url(`wiki/${c.slug}/`)} data-side>{c.label}</a>
                        ))}
                      </span>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </section>

    <!-- Behind-the-scenes Concept Library (Wiki) -->
    <section class="lib-section" id="concepts" data-lib-block="concepts">
      <div class="lib-part-head">
        <div>
          <h2>Behind-the-scenes concepts <span class="lib-range">{wiki.articles.length} entries</span></h2>
          <p>Click any concept to read it in a slide-over drawer without losing your place in the library.</p>
        </div>
        <a class="lib-ov-link" href={url('wiki/graph/')}>Concept graph →</a>
      </div>

      <div class="lib-concept-clusters">
        {conceptGroups.map(({ cluster, items }) => (
          <div class="lib-cluster" data-lib-cluster>
            <h3><ClusterMark cluster={cluster.id} size={14} /> {cluster.label}</h3>
            <ul>
              {items.map((a) => (
                <li
                  data-lib-item
                  data-kind="concepts"
                  data-q={[a.title, ...a.aliases, a.summary, cluster.label].join(' ').toLowerCase()}
                >
                  <a href={url(`wiki/${a.slug}/`)} data-side>{a.title}</a>
                  <span class="lib-csum">{a.summary}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Reusable Starter Skills from vibecoding-guide -->
    <section class="lib-section" id="skills" data-lib-block="skills">
      <div class="lib-part-head">
        <div>
          <h2>Starter skills <span class="lib-range">From vibecoding-guide</span></h2>
          <p>Drop these reusable instruction files into your agent’s skills folder to teach good web fundamentals, UI polish and pre-launch audits.</p>
        </div>
        <a class="lib-ov-link" href={url('guide/skills-table/')}>All skills guide →</a>
      </div>

      <div class="lib-skill-grid">
        {skills.map((sk) => (
          <article
            class="lib-skill"
            data-lib-item
            data-kind="skills"
            data-q={`${sk.title} ${sk.blurb} skill prompt`.toLowerCase()}
          >
            <h3><a href={url(`guide/${sk.id}/`)} data-side>{sk.title}</a></h3>
            <p>{sk.blurb}</p>
            <a class="lib-go" href={url(`guide/${sk.id}/`)} data-side>Read &amp; copy →</a>
          </article>
        ))}
      </div>
    </section>

    <p class="lib-empty" id="lib-empty" role="status" hidden>Nothing matches your filter yet—try a broader term or reset to Everything.</p>
  </div>
</Base>

<script>
  const pills = [...document.querySelectorAll<HTMLButtonElement>('[data-lib-scope]')];
  const input = document.getElementById('lib-q') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLElement>('[data-lib-item]')];
  const parts = [...document.querySelectorAll<HTMLElement>('[data-lib-part]')];
  const clusters = [...document.querySelectorAll<HTMLElement>('[data-lib-cluster]')];
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-lib-block]')];
  const empty = document.getElementById('lib-empty');

  let scope = 'all';

  function apply() {
    const terms = (input?.value ?? '').toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const kind = el.dataset.kind ?? '';
      const okScope = scope === 'all' || kind === scope;
      const okText = terms.every((t) => el.dataset.q!.includes(t));
      const hit = okScope && okText;
      el.hidden = !hit;
      if (hit) shown++;
    }
    for (const p of parts) p.hidden = !p.querySelector('[data-lib-item]:not([hidden])');
    for (const c of clusters) c.hidden = !c.querySelector('[data-lib-item]:not([hidden])');
    for (const b of blocks) b.hidden = !b.querySelector('[data-lib-item]:not([hidden])');
    if (empty) empty.hidden = shown > 0;
  }

  for (const b of pills) {
    b.addEventListener('click', () => {
      scope = b.dataset.libScope ?? 'all';
      for (const o of pills) o.setAttribute('aria-pressed', String(o === b));
      apply();
    });
  }

  if (input) {
    const q = new URLSearchParams(location.search).get('q');
    if (q) input.value = q;
    input.addEventListener('input', apply);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { input.value = ''; apply(); }
    });
  }
  apply();
</script>

<style>
  .lib-shell {
    max-width: var(--full);
    margin-inline: auto;
    padding: var(--space-7) var(--gutter) var(--space-8);
  }
  .lib-title-row {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: var(--space-3); margin-bottom: var(--space-4);
  }
  .lib-head h1 { margin: 0 0 var(--space-2); font-size: clamp(1.75rem, 3vw, 2.35rem); letter-spacing: -0.02em; }
  .lib-intro { margin: 0; max-width: 64ch; color: var(--ink-2); font-size: var(--text-l); line-height: 1.5; }
  .lib-graph-link {
    display: inline-flex; align-items: center; min-height: 2.4rem; padding: 0.35rem 0.9rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-pill);
    background: var(--card); color: var(--ink); font-size: var(--text-s); font-weight: 560; text-decoration: none;
  }
  .lib-graph-link:hover { border-color: var(--accent); color: var(--accent); }

  .lib-controls {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-3); padding-bottom: var(--space-5); border-bottom: 1px solid var(--rule);
  }
  .lib-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .lib-pill {
    min-height: 2.35rem; padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-pill);
    background: var(--card); color: var(--ink-2); font: inherit; font-size: var(--text-s); font-weight: 560;
    cursor: pointer; transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease;
  }
  .lib-pill:hover { border-color: var(--accent); color: var(--ink); }
  .lib-pill[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .lib-search { flex: 1 1 18rem; max-width: 26rem; }
  .lib-search input {
    width: 100%; min-height: 2.4rem; padding: 0.35rem 0.95rem;
    border: 1px solid var(--rule-strong); border-radius: var(--radius-pill);
    background: var(--card); color: var(--ink); font: inherit; font-size: var(--text-s);
  }

  .lib-section { margin-top: var(--space-7); }
  .lib-section[hidden], .lib-part[hidden], .lib-cluster[hidden] { display: none; }
  .lib-part { margin-bottom: var(--space-7); }
  .lib-part:last-child { margin-bottom: 0; }

  .lib-part-head {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: var(--space-2) var(--space-4); margin-bottom: var(--space-4);
  }
  .lib-part-head h2 { margin: 0 0 0.2rem; font-size: var(--text-xl); font-weight: 640; letter-spacing: -0.014em; }
  .lib-range { font-size: var(--text-s); font-weight: 520; color: var(--muted); margin-left: 0.35rem; }
  .lib-part-head p { margin: 0; max-width: 62ch; color: var(--ink-2); font-size: var(--text-s); }
  .lib-ov-link { font-size: var(--text-s); font-weight: 600; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .lib-ov-link:hover { text-decoration: underline; }

  .lib-lesson-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(21rem, 100%), 1fr));
    gap: var(--space-4);
  }
  .lib-lesson {
    display: flex; flex-direction: column; gap: 0.55rem; padding: 1.05rem 1.15rem;
    border: 1px solid var(--rule); border-radius: var(--radius-m); background: var(--card);
    transition: border-color var(--dur-fast) ease;
  }
  .lib-lesson:hover { border-color: color-mix(in oklab, var(--accent) 50%, var(--rule)); }
  .lib-lesson[hidden] { display: none; }

  .lib-lesson-top { display: flex; align-items: baseline; gap: 0.55rem; }
  .lib-num {
    display: inline-grid; place-items: center; flex: none;
    min-width: 1.65rem; height: 1.65rem; padding-inline: 0.3rem; border-radius: var(--radius-pill);
    background: var(--paper-2); color: var(--muted); font-family: var(--mono); font-size: var(--text-xs); font-weight: 650;
  }
  .lib-lesson h3 { margin: 0; font-size: var(--text-m); font-weight: 630; line-height: 1.25; }
  .lib-lesson h3 a { color: var(--ink); text-decoration: none; }
  .lib-lesson h3 a:hover { color: var(--accent); }

  .lib-line { margin: 0; font-size: var(--text-s); color: var(--ink-2); line-height: 1.45; }
  .lib-adds {
    padding: 0.45rem 0.65rem; border-left: 2px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 5%, var(--paper));
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .lib-adds p { margin: 0; font-size: var(--text-xs); line-height: 1.45; color: var(--ink-2); }

  .lib-steps { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .lib-step-chip {
    display: inline-flex; align-items: center; padding: 0.14rem 0.52rem;
    border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--paper);
    font-size: var(--text-xs); color: var(--ink-2); text-decoration: none;
  }
  .lib-step-chip:hover { border-color: var(--accent); color: var(--accent); }

  .lib-lesson-foot {
    margin-top: auto; padding-top: 0.55rem; border-top: 1px solid var(--rule);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.45rem;
  }
  .lib-go { font-size: var(--text-s); font-weight: 620; color: var(--accent); text-decoration: none; }
  .lib-go:hover { text-decoration: underline; }
  .lib-concept-links { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; }
  .lib-concept-links a {
    font-size: var(--text-xs); color: var(--muted);
    text-decoration: underline dotted var(--rule-strong); text-underline-offset: 0.2em;
  }
  .lib-concept-links a:hover { color: var(--accent); text-decoration-color: var(--accent); text-decoration-style: solid; }

  .lib-concept-clusters {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-4);
  }
  .lib-cluster {
    padding: 1rem 1.1rem; border: 1px solid var(--rule); border-radius: var(--radius-m); background: var(--card);
  }
  .lib-cluster h3 { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.65rem; font-size: var(--text-m); font-weight: 620; }
  .lib-cluster ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .lib-cluster li[hidden] { display: none; }
  .lib-cluster li a { display: block; font-size: var(--text-s); font-weight: 580; color: var(--ink); text-decoration: none; }
  .lib-cluster li a:hover { color: var(--accent); }
  .lib-csum { display: block; font-size: var(--text-xs); color: var(--muted); line-height: 1.4; margin-top: 0.1rem; }

  .lib-skill-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: var(--space-4);
  }
  .lib-skill {
    display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem;
    border: 1px solid var(--rule); border-radius: var(--radius-m); background: var(--card);
  }
  .lib-skill[hidden] { display: none; }
  .lib-skill h3 { margin: 0; font-size: var(--text-m); font-weight: 620; }
  .lib-skill h3 a { color: var(--ink); text-decoration: none; }
  .lib-skill h3 a:hover { color: var(--accent); }
  .lib-skill p { margin: 0 0 0.35rem; font-size: var(--text-s); color: var(--ink-2); flex: 1; }

  .lib-empty { margin-top: var(--space-6); color: var(--muted); }
  .lib-empty[hidden] { display: none; }
</style>
