---
import Journey from '../layouts/Journey.astro';
import PartSwitch from '../components/journey/PartSwitch.astro';
import OverviewStep from '../components/journey/OverviewStep.astro';
import ForLevel from '../components/level/ForLevel.astro';
import Term from '../components/journey/Term.astro';
import LessonRef from '../components/journey/LessonRef.astro';
import { rungs, parts } from '../journey/rungs';
import { url } from '../lib/nav';
---
<Journey
  chapter="foundations"
  first="ai"
  title="Agentic Coding Guide"
  description="An interactive visual guide to building software with AI agents—from what AI is and where it runs, to context rot, verification, parallel teams and production workflows."
>
  <p class="j-lead">
    <ForLevel is="plain">An interactive guide for anyone who wants <Term id="agent">AI agents</Term> to build real software with them—starting from scratch before your first line of code. Start with <LessonRef id="ai" />.</ForLevel>
    <ForLevel is="technical">An interactive mental model of AI coding agents: foundations, context rot, typechecks, unit tests, review loops, parallel worktrees and cloud execution.</ForLevel>
    <ForLevel is="engineer">An interactive systems guide to agentic engineering: context mechanics, deterministic oracles, architectural boundaries, adversarial review and fleet economics.</ForLevel>
  </p>
  <PartSwitch active={1} />

  {rungs.filter((r) => r.part === 1).map((r, i, all) => (
    <OverviewStep rung={r}>
      {i === all.length - 1 && (
        <a class="j-next" href={url(parts[1]!.href)}>
          <span>Part two · Lessons {parts[1]!.range}</span>
          <b>{parts[1]!.title}</b>
          <span>{parts[1]!.blurb}</span>
        </a>
      )}
    </OverviewStep>
  ))}
</Journey>
