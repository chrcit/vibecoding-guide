---
import Board from '../../layouts/Board.astro';
import ClusterMark from '../../components/wiki/ClusterMark.astro';
import GraphThumb from '../../components/wiki/GraphThumb.astro';
import { CLUSTERS, getWiki } from '../../lib/wiki';
import { url } from '../../lib/nav';

const wiki = await getWiki();
const hubs = [...wiki.graph.nodes].sort((a, b) => b.degree - a.degree || a.title.localeCompare(b.title, 'en')).slice(0, 8);
const top = hubs[0]?.degree ?? 1;
const groups = CLUSTERS.map((c) => ({ c, items: wiki.articles.filter((a) => a.cluster === c.id) })).filter((g) => g.items.length);
// Pointing at a cluster's tile lights its articles in the graph tile.
const peek = groups
  .map(({ c }) => `.board:has(.wi-c[data-cluster='${c.id}']:is(:hover, :focus-within)) .wi-graph path:not(.c-${c.id})`)
  .join(',\n');
---
<Board title="Wiki" description="Short reference articles on working with coding agents, one idea each, linked to each other." section="wiki">
  <div slot="tools" class="wi-find" role="search">
    <svg class="wi-icon" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4.5 4.5" /></svg>
    <input id="wi-q" type="search" aria-label="Filter the articles" autocomplete="off" spellcheck="false" />
  </div>

  <section class="tile wi-graph-tile" data-span="8" style="--span:8" data-flush>
    <header class="tile-head"><h2><a href={url('wiki/graph/')}>Graph</a></h2></header>
    <a class="tile-body wi-graph" href={url('wiki/graph/')} aria-label="Graph" tabindex="-1">
      <GraphThumb graph={wiki.graph} />
    </a>
  </section>

  <section class="tile wi-hubs" data-span="4" style="--span:4">
    <header class="tile-head"><h2>Most linked</h2></header>
    <ol class="tile-body">
      {hubs.map((n) => (
        <li>
          <a href={url(`wiki/${n.slug}/`)} data-side><ClusterMark cluster={n.cluster} size={12} /><span class="wi-hub-t">{n.title}</span></a>
          <span class="wi-bar" style={`--w:${(n.degree / top) * 100}%`} aria-hidden="true"></span>
          <span class="wi-n">{n.degree}</span>
        </li>
      ))}
    </ol>
  </section>

  {groups.map(({ c, items }) => (
    <section class="tile wi-c" data-span="3" style="--span:3" data-cluster={c.id} id={`c-${c.id}`} data-wl-group>
      <header class="tile-head"><h2><ClusterMark cluster={c.id} size={14} />{c.label}</h2></header>
      <ul class="tile-body">
        {items.map((a) => (
          <li data-wl-item data-slug={a.slug} data-q={[a.title, ...a.aliases, a.summary].join(' ').toLowerCase()}>
            <a href={url(`wiki/${a.slug}/`)} data-side>{a.title}</a>
            <p class="wi-sum" hidden>{a.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="wi-none" id="wi-none" role="status" hidden></p>
</Board>

<Fragment set:html={`<style>${peek} { opacity: 0.12; }</style>`} />

<script>
  const input = document.getElementById('wi-q') as HTMLInputElement | null;
  const none = document.getElementById('wi-none');
  const items = [...document.querySelectorAll<HTMLElement>('[data-wl-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-wl-group]')];
  const thumb = document.querySelector<SVGSVGElement>('.wi-graph svg');
  const marks = new Map([...(thumb?.querySelectorAll<SVGPathElement>('path[data-slug]') ?? [])].map((p) => [p.dataset.slug!, p]));

  function apply() {
    if (!input || !none) return;
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const li of items) {
      const hit = terms.every((t) => li.dataset.q!.includes(t));
      li.hidden = !hit;
      li.querySelector<HTMLElement>('.wi-sum')!.hidden = !(hit && terms.length);
      marks.get(li.dataset.slug!)?.classList.toggle('hit', hit && terms.length > 0);
      if (hit) shown++;
    }
    thumb?.classList.toggle('q', terms.length > 0);
    for (const g of groups) g.hidden = !g.querySelector('[data-wl-item]:not([hidden])');
    none.hidden = shown > 0;
    none.textContent = shown ? '' : `Nothing matches “${input.value.trim()}”.`;
  }

  if (input) {
    const q = new URLSearchParams(location.search).get('q');
    if (q) input.value = q;
    input.addEventListener('input', apply);
    input.addEventListener('keydown', (e) => {
      const first = document.querySelector<HTMLAnchorElement>('[data-wl-item]:not([hidden]) a');
      if (e.key === 'Enter' && input.value.trim() && first) { e.preventDefault(); first.click(); }
      else if (e.key === 'ArrowDown' && first) { e.preventDefault(); first.focus(); }
      else if (e.key === 'Escape') { input.value = ''; apply(); }
    });
    apply();
  }
</script>

<style>
  .wi-find { position: relative; width: min(20rem, 100%); }
  .wi-icon { position: absolute; left: 0.8rem; top: 50%; translate: 0 -50%; color: var(--muted); pointer-events: none; }
  input {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem 0.4rem 2.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-s);
  }
  input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-color: transparent; }

  .tile-head h2 { display: flex; align-items: center; gap: 0.55rem; }
  .tile-head h2 a { color: inherit; text-decoration: none; }
  .tile-head h2 a:hover { color: var(--accent); }
  .wi-graph { display: block; height: clamp(13rem, 24vw, 22rem); padding: 0.75rem; }
  .wi-graph :global(svg.q path:not(.hit)) { opacity: 0.12; }
  .wi-graph :global(svg.q line) { opacity: 0.35; }

  .wi-hubs ol { list-style: none; margin: 0; padding: 0.5rem 0.875rem 0.75rem; display: grid; gap: 0.1rem; }
  .wi-hubs li { display: grid; grid-template-columns: minmax(0, 11rem) 1fr 2ch; align-items: center; gap: 0.75rem; }
  .wi-hubs li a { gap: 0.5rem; min-width: 0; }
  .wi-hub-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wi-bar { height: 0.5rem; border-radius: var(--radius-pill); background: linear-gradient(to right, var(--accent) var(--w), var(--paper-2) var(--w)); }
  .wi-n { font-family: var(--mono); font-size: var(--text-xs); color: var(--muted); text-align: right; }
  .wi-c[hidden] { display: none; }
  ul.tile-body { list-style: none; margin: 0; padding: 0.375rem 0.875rem 0.625rem; }
  li { max-width: none; }
  li a {
    display: flex; align-items: center;
    min-height: 2.25rem;
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.3;
  }
  li a:hover { color: var(--accent); }
  .wi-sum { margin: -0.1rem 0 0.5rem; color: var(--muted); font-size: var(--text-s); line-height: 1.4; }
  .wi-sum[hidden] { display: none; }
  .wi-none { grid-column: 1 / -1; margin: 0; color: var(--muted); }
  .wi-none[hidden] { display: none; }
</style>
