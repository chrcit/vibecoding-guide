---
/*
  Layout for the journey: one picture that stays in view, and short steps that scroll past it.
  The concept is in site/JOURNEY.md.
  Props:
    chapter      a key of journey/chapters ('whole' for the overview)
    title, description
    first        the id of the first step, for the frame drawn before the script runs
    data?        sourced numbers for the chapter's script, built from site/src/data
  Slots: default (the <Step>s), foot (under the steps: sources, last verified)
*/
import Base from './Base.astro';
import '../styles/board.css';
import '../components/fig/fig.css';
import '../styles/journey.css';
import { url } from '../lib/nav';
import { rungs, parts, partOf } from '../journey/rungs';
import { chapters } from '../journey/chapters';
import { poster } from '../journey/picture';

interface Props { chapter: string; title: string; description: string; first: string; data?: Record<string, unknown> }
const { chapter, title, description, first, data } = Astro.props;
const here = rungs.find((r) => r.id === chapter);
const part = partOf(chapter);
const def = chapters[chapter]?.steps[first];
if (!def) throw new Error(`Journey: chapter "${chapter}" has no step "${first}"`);
const still = poster(def.scene({ level: 'plain', mem: {}, keep: {}, data: data ?? {}, say() {}, model() {}, stat() {} } as any));
---
<Base title={`${title} · Agentic Coding Guide`} description={description} section="guide" type="article">
  <div class="j-root" data-journey data-chapter={chapter} data-base={url('')}>
    {data && <script type="application/json" data-journey-data set:html={JSON.stringify(data)} />}
    <div class="j-view">
      <nav class="j-rail" aria-label="The 21 lessons">
        <ol class="j-rail-all">
          {parts.map((p) => (
            <li class="j-rail-group" data-mine={p.n === part.n ? '' : undefined}>
              <a class="j-rail-part" href={url(p.href)} aria-current={chapter === p.chapter ? 'page' : undefined} title={`Part ${p.n}: ${p.title}`}>Part {p.n}</a>
              <ol>
                {rungs.filter((r) => r.part === p.n).map((r) => (
                  <li>
                    <a href={url(`journey/${r.id}/`)} aria-current={r.id === chapter ? 'page' : undefined} data-rung-link={r.id} title={`${r.n}. ${r.title}`} aria-label={`${r.short}, lesson ${r.n}`}>
                      <span class="j-rail-n" aria-hidden="true">{r.n}</span><span class="j-rail-name" aria-hidden="true">{r.short}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </nav>
      <div class="j-frame">
        <section class="j-screen" data-form="chat" data-empty aria-label="An example of the app's screen, schematic">
          <header class="j-scr-bar">
            <span class="j-scr-app" data-scr-app>Chat</span>
            <span class="j-scr-title" data-scr-title></span>
            <span class="j-tag">example</span>
          </header>
          <div class="j-scr-body">
            <ul class="j-scr-side" data-scr-side aria-label="Threads" hidden></ul>
            <div class="j-scr-scroll" role="log" aria-label="Messages" tabindex="0"><ol class="j-scr-log" data-scr-log></ol></div>
          </div>
          <div class="j-scr-comp" aria-hidden="true"><span class="j-scr-ph" data-scr-ph>Message</span><span class="j-scr-chips" data-scr-chips></span><span class="j-scr-send"></span></div>
        </section>
        <div class="j-stage tile" role="img" aria-label={here ? `Lesson ${here.n}, ${here.short}: ${here.title}. ${here.line}` : `The picture that grows through the journey. ${part.title}.`}>
          <Fragment set:html={still} />
        </div>
        <div class="j-cap">
          <p class="j-say" aria-live="polite"></p>
          <dl class="j-stats"></dl>
        </div>
      </div>
    </div>
    <div class="j-extras" hidden>
      <p class="j-model" hidden></p>
      <ul class="j-key" aria-label="What the colours are"></ul>
    </div>
    <div class="j-steps">
      <header class="j-head">
        {here && <p class="j-count">Lesson {here.n} of {rungs.length}</p>}
        <h1>{title}</h1>
      </header>
      <slot />
      {Astro.slots.has('foot') && <footer class="j-foot"><slot name="foot" /></footer>}
    </div>
  </div>
</Base>

<script>
  import { boot } from '../journey/run';
  for (const root of document.querySelectorAll<HTMLElement>('[data-journey]')) boot(root);
</script>
